<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="GridGate.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:GridGate"
    xmlns:tv="using:WinUI.TableView">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" RowSpacing="8" Padding="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="8">
            <ComboBox
                x:Name="ThemeCombo"
                AutomationProperties.AutomationId="Gate_ThemeCombo"
                AutomationProperties.Name="Theme"
                SelectedIndex="0"
                SelectionChanged="OnThemeChanged">
                <x:String>System</x:String>
                <x:String>Light</x:String>
                <x:String>Dark</x:String>
            </ComboBox>
            <Button AutomationProperties.AutomationId="Gate_SampleLayoutButton" Click="OnApplySampleLayout" Content="Apply sample layout" />
            <Button AutomationProperties.AutomationId="Gate_CaptureLayoutButton" Click="OnCaptureLayout" Content="Capture layout" />
            <Button AutomationProperties.AutomationId="Gate_ResetLayoutButton" Click="OnResetLayout" Content="Reset layout" />
            <Button AutomationProperties.AutomationId="Gate_RestoreLayoutButton" Click="OnRestoreLayout" Content="Restore captured layout" />
            <Button AutomationProperties.AutomationId="Gate_MeasureButton" Click="OnMeasure" Content="Measure" />
            <Button AutomationProperties.AutomationId="Gate_ScrollStressButton" Click="OnScrollStress" Content="Scroll stress x5" />
            <ToggleSwitch
                x:Name="InternalCloseToggle"
                AutomationProperties.AutomationId="Gate_InternalCloseToggle"
                IsOn="True"
                OffContent="Public API only"
                OnContent="Close editor via internal API" />
        </StackPanel>

        <InfoBar
            x:Name="StatusInfoBar"
            Grid.Row="1"
            AutomationProperties.AutomationId="Gate_StatusInfoBar"
            IsClosable="False"
            IsOpen="True"
            Message="Ready. F2 or double-click edits; values containing 'fail' fail to save." />

        <!-- TableView derives from ListView: give it a bounded star row so row virtualization stays active. -->
        <tv:TableView
            x:Name="Table"
            Grid.Row="2"
            AutoGenerateColumns="False"
            AutomationProperties.AutomationId="Grid_Table"
            AutomationProperties.Name="Tasks"
            CanFilterColumns="False"
            CanReorderColumns="True"
            CanResizeColumns="True"
            CanSortColumns="True"
            SelectionMode="Single"
            SelectionUnit="Cell">
            <tv:TableView.Columns>
                <tv:TableViewTemplateColumn Header="Kind" IsReadOnly="True" Tag="Kind" Width="110">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind KindText, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="CR Number" IsReadOnly="True" Tag="CrNumber" Width="110">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.CrNumber, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Task Number" IsReadOnly="True" Tag="TaskNumber" Width="110">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.TaskNumber, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Squad" IsReadOnly="True" Tag="Squad" Width="130">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.Squad, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Owner" IsReadOnly="True" Tag="Owner" Width="120">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.Owner, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Title" Tag="Title" Width="260">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal" Spacing="6">
                                <!-- Linked titles are inherited from the CR (B-07); the lock glyph is paired with a tooltip, not color. -->
                                <FontIcon
                                    FontSize="12"
                                    Glyph="&#xE72E;"
                                    ToolTipService.ToolTip="Inherited from the CR"
                                    Visibility="{x:Bind LockVisibility, Mode=OneWay}" />
                                <TextBlock Text="{x:Bind Committed.Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.AutomationId="Grid_CellEditor"
                                    AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                    AutomationProperties.Name="Title"
                                    IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                                    Text="{x:Bind DraftTitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ProgressRing Grid.Column="1" Width="12" Height="12" IsActive="{x:Bind IsSaving, Mode=OneWay}" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="Grid_CellErrorIcon"
                                    AutomationProperties.Name="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE783;"
                                    ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Service" Tag="Service" Width="140">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.Service, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox
                                    AutomationProperties.AutomationId="Grid_CellEditor"
                                    AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                    AutomationProperties.Name="Service"
                                    IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                                    Text="{x:Bind DraftService, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                <ProgressRing Grid.Column="1" Width="12" Height="12" IsActive="{x:Bind IsSaving, Mode=OneWay}" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="Grid_CellErrorIcon"
                                    AutomationProperties.Name="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE783;"
                                    ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Status" Tag="Status" Width="150">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.Status, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ComboBox
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="Grid_CellEditor"
                                    AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                    AutomationProperties.Name="Status"
                                    ItemsSource="{x:Bind StatusOptions, Mode=OneWay}"
                                    SelectedItem="{x:Bind DraftStatus, Mode=TwoWay}" />
                                <ProgressRing Grid.Column="1" Width="12" Height="12" IsActive="{x:Bind IsSaving, Mode=OneWay}" />
                                <FontIcon
                                    Grid.Column="2"
                                    AutomationProperties.AutomationId="Grid_CellErrorIcon"
                                    AutomationProperties.Name="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Glyph="&#xE783;"
                                    ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}"
                                    Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Priority" Tag="Priority" Width="120">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.Priority, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <ComboBox
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="Grid_CellEditor"
                                AutomationProperties.Name="Priority"
                                ItemsSource="{x:Bind PriorityOptions, Mode=OneWay}"
                                SelectedItem="{x:Bind DraftPriority, Mode=TwoWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Start Date" Tag="StartDate" Width="150">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind StartDateText, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <CalendarDatePicker
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="Grid_CellEditor"
                                AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                AutomationProperties.Name="Start Date"
                                Date="{x:Bind DraftStartDate, Mode=TwoWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="End Date" Tag="EndDate" Width="150">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind EndDateText, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <CalendarDatePicker
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="Grid_CellEditor"
                                AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                AutomationProperties.Name="End Date"
                                Date="{x:Bind DraftEndDate, Mode=TwoWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Notes" Tag="Notes" Width="240">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind NotesPreview, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <Grid ColumnSpacing="4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <!-- B-07: plain Enter inserts a line break; Ctrl+Enter or the Save button commits. -->
                                <TextBox
                                    MinHeight="64"
                                    AcceptsReturn="True"
                                    AutomationProperties.AutomationId="Grid_CellEditor"
                                    AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                    AutomationProperties.Name="Notes"
                                    IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                                    Text="{x:Bind DraftNotes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    TextWrapping="Wrap" />
                                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="4">
                                    <Button
                                        AutomationProperties.AutomationId="Grid_NotesSaveButton"
                                        Content="Save"
                                        ToolTipService.ToolTip="Save (Ctrl+Enter)" />
                                    <ProgressRing Width="12" Height="12" IsActive="{x:Bind IsSaving, Mode=OneWay}" />
                                    <FontIcon
                                        AutomationProperties.AutomationId="Grid_CellErrorIcon"
                                        AutomationProperties.Name="{x:Bind ErrorMessage, Mode=OneWay}"
                                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                        Glyph="&#xE783;"
                                        ToolTipService.ToolTip="{x:Bind ErrorMessage, Mode=OneWay}"
                                        Visibility="{x:Bind ErrorVisibility, Mode=OneWay}" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
                <tv:TableViewTemplateColumn Header="Tags" Tag="Tags" Width="140">
                    <tv:TableViewTemplateColumn.CellTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBlock VerticalAlignment="Center" Text="{x:Bind Committed.Tags, Mode=OneWay}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.CellTemplate>
                    <tv:TableViewTemplateColumn.EditingTemplate>
                        <DataTemplate x:DataType="local:TaskRowViewModel">
                            <TextBox
                                AutomationProperties.AutomationId="Grid_CellEditor"
                                AutomationProperties.FullDescription="{x:Bind ErrorMessage, Mode=OneWay}"
                                AutomationProperties.Name="Tags"
                                IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                                Text="{x:Bind DraftTags, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        </DataTemplate>
                    </tv:TableViewTemplateColumn.EditingTemplate>
                </tv:TableViewTemplateColumn>
            </tv:TableView.Columns>
        </tv:TableView>

        <Grid Grid.Row="3" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="LayoutBox"
                Height="96"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="Gate_LayoutBox"
                FontFamily="Consolas"
                FontSize="11"
                Header="Captured layout (configuration.json shape)"
                IsReadOnly="True"
                TextWrapping="Wrap" />
            <TextBox
                x:Name="EventLogBox"
                Grid.Column="1"
                Height="96"
                AcceptsReturn="True"
                AutomationProperties.AutomationId="Gate_EventLog"
                FontFamily="Consolas"
                FontSize="11"
                Header="Edit/column event log (newest first)"
                IsReadOnly="True"
                TextWrapping="NoWrap" />
        </Grid>
    </Grid>
</Window>
