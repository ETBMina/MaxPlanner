<Project Sdk="Microsoft.NET.Sdk">
  <Import Project="..\..\eng\WinUI.Common.props" />

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>GridGate</AssemblyName>
    <RootNamespace>GridGate</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Mirrors src/MaxPlanner.Desktop (ADR 0003 / T-03): portable, self-contained, no trimming/AOT/single-file. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishAot>false</PublishAot>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <Manifest Include="$(ApplicationManifest)" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="WinUI.TableView" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
  </ItemGroup>
</Project>
