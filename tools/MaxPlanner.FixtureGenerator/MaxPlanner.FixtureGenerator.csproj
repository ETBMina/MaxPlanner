<Project Sdk="Microsoft.NET.Sdk">
  <!-- Development tool: creates disposable datasets (incl. the T-11 benchmark fixture) through the real use cases.
       Never part of the portable ZIP (publish-portable.ps1 publishes only MaxPlanner.Desktop and checks for it). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <RootNamespace>MaxPlanner.FixtureGenerator</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MaxPlanner.Application\MaxPlanner.Application.csproj" />
    <ProjectReference Include="..\..\src\MaxPlanner.Infrastructure\MaxPlanner.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- set-schema-version writes PRAGMA user_version for the newer-schema release gate (see Program.cs). -->
    <PackageReference Include="Microsoft.Data.Sqlite" />
  </ItemGroup>
</Project>
