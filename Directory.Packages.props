<Project>
  <!-- ADR 0002: exact pins. Upgrade deliberately and update the ADR in the same change. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>

  <!-- ADR 0003: component packages from the Windows App SDK 2.5.1 release instead of the
       Microsoft.WindowsAppSDK metapackage, which also bundles unused AI/ML/Search/Widgets payload
       (onnxruntime.dll, DirectML.dll). Versions match the 2.5.1 metapackage's dependency set. -->
  <ItemGroup Label="Windows App SDK">
    <PackageVersion Include="Microsoft.WindowsAppSDK.WinUI" Version="2.3.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Foundation" Version="2.3.12" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.InteractiveExperiences" Version="2.1.9" />
    <PackageVersion Include="Microsoft.WindowsAppSDK.Base" Version="2.0.4" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.28000.2705" />
    <PackageVersion Include="Microsoft.Windows.SDK.BuildTools.WinUIAnalyzer" Version="0.7.1" />
  </ItemGroup>

  <ItemGroup Label="Presentation">
    <PackageVersion Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageVersion Include="DynamicData" Version="9.5.0" />
    <!-- Transitively lifts DynamicData's System.Reactive 6.1.0 dependency; compatibility is spike 5 (ADR 0002). -->
    <PackageVersion Include="System.Reactive" Version="7.0.0" />
  </ItemGroup>

  <ItemGroup Label="Spikes">
    <!-- ADR 0004: rejected by the Grid gate; pinned only so spikes/GridGate keeps building. Never reference from src/. -->
    <PackageVersion Include="WinUI.TableView" Version="1.5.1" />
    <!-- ADR 0021: rejected (needs the WinAppSDK 1.6 metapackage); pinned only for spikes/PlatformControls. Never reference from src/. -->
    <PackageVersion Include="CommunityToolkit.WinUI.Controls.SettingsControls" Version="8.2.251219" />
  </ItemGroup>

  <ItemGroup Label="Infrastructure">
    <PackageVersion Include="Microsoft.Data.Sqlite" Version="10.0.13" />
    <PackageVersion Include="SQLitePCLRaw.bundle_e_sqlite3" Version="2.1.13" />
    <PackageVersion Include="Serilog" Version="4.4.0" />
    <PackageVersion Include="Serilog.Sinks.File" Version="7.0.0" />
    <PackageVersion Include="Serilog.Extensions.Logging" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup Label="Composition and abstractions">
    <PackageVersion Include="Microsoft.Extensions.DependencyInjection" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.13" />
  </ItemGroup>

  <ItemGroup Label="Tests">
    <PackageVersion Include="xunit.v3" Version="4.0.2" />
    <PackageVersion Include="AwesomeAssertions" Version="9.6.0" />
    <PackageVersion Include="TngTech.ArchUnitNET" Version="0.13.4" />
    <PackageVersion Include="Microsoft.Extensions.TimeProvider.Testing" Version="10.11.0" />
  </ItemGroup>
</Project>
