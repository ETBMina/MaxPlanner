<?xml version="1.0" encoding="utf-8"?>
<Window
    x:Class="MaxPlanner.Desktop.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="using:MaxPlanner.Presentation.Shell">
    <!-- The backdrop (Mica or solid fallback) is chosen in code-behind; see ADR 0008. The theme mode is
         set on RootGrid by ThemeService, so the title bar and every page follow it. -->
    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            x:Uid="Shell_TitleBar"
            AutomationProperties.AutomationId="Shell_TitleBar">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
        </TitleBar>

        <shell:ShellView
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel, Mode=OneTime}" />
    </Grid>
</Window>
