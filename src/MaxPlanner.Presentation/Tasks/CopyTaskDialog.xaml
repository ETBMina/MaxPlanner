<?xml version="1.0" encoding="utf-8"?>
<!-- Copy task (B-06, design §5.5): options, optional permanent link (§5.6), then a review before Create copy. -->
<ContentDialog
    x:Class="MaxPlanner.Presentation.Tasks.CopyTaskDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:local="using:MaxPlanner.Presentation.Tasks"
    x:Uid="CopyTask_Dialog"
    AutomationProperties.AutomationId="CopyTask_Dialog"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanPrimary, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryClick"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,12,0" Spacing="12">
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.SourceCaption, Mode=OneWay}"
                TextWrapping="Wrap" />
            <InfoBar
                AutomationProperties.AutomationId="CopyTask_ErrorInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />

            <!-- Step 1: options. Every copy option starts unchecked (B-06). -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsOptionsStep), Mode=OneWay}">
                <TextBox
                    x:Uid="CopyTask_TitleBox"
                    AutomationProperties.AutomationId="CopyTask_TitleBox"
                    AutomationProperties.IsRequiredForForm="True"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsTitleEditable), Mode=OneWay}" />
                <local:FieldError Text="{x:Bind ViewModel.TitleError, Mode=OneWay}" />
                <TextBox
                    AutomationProperties.AutomationId="CopyTask_ServiceBox"
                    Header="{x:Bind ViewModel.ServiceHeader, Mode=OneWay}"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Service, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <local:FieldError Text="{x:Bind ViewModel.ServiceError, Mode=OneWay}" />
                <InfoBar
                    AutomationProperties.AutomationId="CopyTask_LinkInfoBar"
                    IsClosable="False"
                    IsOpen="True"
                    Message="{x:Bind ViewModel.LinkStateText, Mode=OneWay}"
                    Severity="Informational">
                    <InfoBar.ActionButton>
                        <Button x:Uid="CopyTask_LinkToCrButton" AutomationProperties.AutomationId="CopyTask_LinkToCrButton" Click="OnLinkClick" />
                    </InfoBar.ActionButton>
                </InfoBar>
                <InfoBar
                    AutomationProperties.AutomationId="CopyTask_PendingLinkInfoBar"
                    IsClosable="False"
                    IsOpen="{x:Bind ViewModel.HasPendingLink, Mode=OneWay}"
                    Message="{x:Bind ViewModel.PendingLinkWarning, Mode=OneWay}"
                    Severity="Warning" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox
                        x:Name="StatusCombo"
                        x:Uid="CopyTask_StatusCombo"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CopyTask_StatusCombo"
                        IsEnabled="{x:Bind ViewModel.CanChooseStatus, Mode=OneWay}"
                        ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                        SelectionChanged="OnStatusSelectionChanged" />
                    <ComboBox
                        x:Name="PriorityCombo"
                        x:Uid="CopyTask_PriorityCombo"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="CopyTask_PriorityCombo"
                        ItemsSource="{x:Bind ViewModel.PriorityOptions, Mode=OneWay}"
                        SelectionChanged="OnPrioritySelectionChanged" />
                </Grid>
                <CheckBox x:Uid="CopyTask_KeepStatusCheck" AutomationProperties.AutomationId="CopyTask_KeepStatusCheck" IsChecked="{x:Bind ViewModel.KeepCurrentStatus, Mode=TwoWay}" />
                <TextBlock x:Uid="CopyTask_CopyHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                <CheckBox x:Uid="CopyTask_PeopleCheck" AutomationProperties.AutomationId="CopyTask_PeopleCheck" IsChecked="{x:Bind ViewModel.CopyPeople, Mode=TwoWay}" />
                <CheckBox x:Uid="CopyTask_DatesCheck" AutomationProperties.AutomationId="CopyTask_DatesCheck" IsChecked="{x:Bind ViewModel.CopyDates, Mode=TwoWay}" />
                <CheckBox x:Uid="CopyTask_TagsCheck" AutomationProperties.AutomationId="CopyTask_TagsCheck" IsChecked="{x:Bind ViewModel.CopyTags, Mode=TwoWay}" />
                <CheckBox x:Uid="CopyTask_NotesCheck" AutomationProperties.AutomationId="CopyTask_NotesCheck" IsChecked="{x:Bind ViewModel.CopyNotes, Mode=TwoWay}" />
                <CheckBox x:Uid="CopyTask_ChecklistCheck" AutomationProperties.AutomationId="CopyTask_ChecklistCheck" IsChecked="{x:Bind ViewModel.CopyChecklistItems, Mode=TwoWay}" />
                <CheckBox
                    x:Uid="CopyTask_PreserveCompletionCheck"
                    Margin="28,0,0,0"
                    AutomationProperties.AutomationId="CopyTask_PreserveCompletionCheck"
                    IsChecked="{x:Bind ViewModel.PreserveCompletion, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanPreserveCompletion, Mode=OneWay}" />
                <CheckBox x:Uid="CopyTask_CustomValuesCheck" AutomationProperties.AutomationId="CopyTask_CustomValuesCheck" IsChecked="{x:Bind ViewModel.CopyCustomValues, Mode=TwoWay}" />
                <TextBlock x:Uid="CopyTask_NoSubtaskCards" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>

            <!-- Link to CR, step 1 (design §5.6). -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsLinkPickStep), Mode=OneWay}">
                <TextBlock x:Uid="LinkCr_PickHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <AutoSuggestBox
                    x:Uid="LinkCr_SearchBox"
                    AutomationProperties.AutomationId="LinkCr_SearchBox"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.CrPicker.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                <ListView
                    x:Name="CrResultsList"
                    x:Uid="LinkCr_ResultsList"
                    MaxHeight="320"
                    AutomationProperties.AutomationId="LinkCr_ResultsList"
                    ItemsSource="{x:Bind ViewModel.CrPicker.Results, Mode=OneWay, FallbackValue={x:Null}}"
                    SelectionChanged="OnCrSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CrChoice">
                            <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind local:TaskEditorDialog.CrName(Number, Title, Secondary), Mode=OneTime}">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Number, Mode=OneTime}" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Title, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Secondary, Mode=OneTime}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="LinkCr_BackButton" Click="OnStepBackClick" />
                    <Button
                        x:Uid="LinkCr_NextButton"
                        AutomationProperties.AutomationId="LinkCr_NextButton"
                        Click="OnLinkNextClick"
                        IsEnabled="{x:Bind ViewModel.CrPicker.HasSelection, Mode=OneWay, FallbackValue=False}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Link to CR, step 2: permanence. -->
            <StackPanel
                AutomationProperties.AutomationId="LinkCr_ConfirmStep"
                Spacing="12"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsLinkConfirmStep), Mode=OneWay}">
                <TextBlock x:Uid="LinkCr_ConfirmHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.CrPicker.TitleLine(ViewModel.CrPicker.Selected), Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Text="{x:Bind ViewModel.CrPicker.InheritLine(ViewModel.CrPicker.Selected), Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock x:Uid="LinkCr_PermanentLine" TextWrapping="Wrap" />
                <TextBox
                    x:Uid="LinkCr_ServiceBox"
                    AutomationProperties.AutomationId="LinkCr_ServiceBox"
                    AutomationProperties.IsRequiredForForm="True"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Service, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <local:FieldError Text="{x:Bind ViewModel.ServiceError, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="LinkCr_ConfirmBackButton" Click="OnStepBackClick" />
                    <Button
                        x:Uid="LinkCr_LinkButton"
                        AutomationProperties.AutomationId="LinkCr_LinkButton"
                        Click="OnConfirmLinkClick"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Step 2: review of the resulting draft (B-06: shown before Save). -->
            <StackPanel
                AutomationProperties.AutomationId="CopyTask_ReviewStep"
                Spacing="8"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReviewStep), Mode=OneWay}">
                <TextBlock x:Uid="CopyTask_ReviewHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <ItemsControl ItemsSource="{x:Bind ViewModel.ReviewLines, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="x:String">
                            <TextBlock Margin="0,2" Text="{x:Bind Mode=OneTime}" TextWrapping="Wrap" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button x:Uid="CopyTask_BackButton" AutomationProperties.AutomationId="CopyTask_BackButton" Click="OnStepBackClick" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
