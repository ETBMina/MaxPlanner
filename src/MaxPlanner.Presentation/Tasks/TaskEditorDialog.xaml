<?xml version="1.0" encoding="utf-8"?>
<!--
    Task editor (design §5.1) on the native ContentDialog [gallery-contentdialog-1, -2]. Nested decisions (link
    picker, permanence, conflict review, reload) are inline steps of this one dialog; dialogs never stack (§5.0).
    Form layout, top to bottom: tag line with More and Close, title, CR facts strip, fields, checklist, Subtask cards,
    notes, custom fields.
-->
<ContentDialog
    x:Class="MaxPlanner.Presentation.Tasks.TaskEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:fields="using:MaxPlanner.Presentation.Common.Fields"
    xmlns:grid="using:MaxPlanner.Presentation.Grid"
    xmlns:local="using:MaxPlanner.Presentation.Tasks"
    AutomationProperties.AutomationId="TaskEditor_Dialog"
    AutomationProperties.Name="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
    Closing="OnClosing"
    Opened="OnOpened"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryClick"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <!--
            No dialog Title: the tag line is the first row, and DialogTitle names the dialog for UI Automation instead.
            The template keeps the empty title's bottom margin, so it is zeroed here to leave no gap at the top.
        -->
        <Thickness x:Key="ContentDialogTitleMargin">0</Thickness>
        <!-- A text box that edits in place: no border or fill at rest; the template's hover and focus states add them. -->
        <Style x:Key="InlineTextBoxStyle" BasedOn="{StaticResource DefaultTextBoxStyle}" TargetType="TextBox">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderBrush" Value="Transparent" />
        </Style>
        <Style x:Key="TitleTextBoxStyle" BasedOn="{StaticResource InlineTextBoxStyle}" TargetType="TextBox">
            <Setter Property="FontSize" Value="20" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
        <Style x:Key="FactLabelTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        </Style>
        <Style x:Key="FactValueTextStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="CopyNumberButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="ChecklistActionButtonStyle" BasedOn="{StaticResource SubtleButtonStyle}" TargetType="Button">
            <Setter Property="Padding" Value="6" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
    </ContentDialog.Resources>
    <ScrollViewer x:Name="ContentScroller" VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Padding="0,0,12,0" Spacing="12">
            <StackPanel.KeyboardAccelerators>
                <!-- Design §7.2: Ctrl+Enter saves from anywhere; Alt+Left goes back on an inline step. -->
                <KeyboardAccelerator Key="Enter" Invoked="OnSaveAccelerator" Modifiers="Control" />
                <KeyboardAccelerator Key="Left" Invoked="OnBackAccelerator" Modifiers="Menu" />
            </StackPanel.KeyboardAccelerators>

            <!-- Top line: the task's tags (Planner-style pills with an Add tag affordance), More, and Close (design §5.1). -->
            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        Margin="0,8,0,0"
                        VerticalAlignment="Top"
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE8EC;"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsFormStep), Mode=OneWay}" />
                    <controls:TokenPicker
                        x:Name="TagsPicker"
                        x:Uid="TaskEditor_TagsPicker"
                        Grid.Column="1"
                        VerticalAlignment="Top"
                        BoxAutomationId="TaskEditor_TagsPicker"
                        IsEditable="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                        IsInline="True"
                        ViewModel="{x:Bind ViewModel.Tags, Mode=OneWay}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsFormStep), Mode=OneWay}" />
                    <Button
                        x:Uid="TaskEditor_MoreMenu"
                        Grid.Column="2"
                        VerticalAlignment="Top"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.AutomationId="TaskEditor_MoreMenu"
                        IsEnabled="{x:Bind common:BindFunctions.Not(ViewModel.IsNew), Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                        <Button.Flyout>
                            <MenuFlyout Placement="BottomEdgeAlignedRight">
                                <MenuFlyoutItem x:Uid="TaskEditor_MoreCopy" AutomationProperties.AutomationId="TaskEditor_MoreCopyItem" Command="{x:Bind ViewModel.RequestCopyCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE8C8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="TaskEditor_MoreArchive"
                                    AutomationProperties.AutomationId="TaskEditor_MoreArchiveItem"
                                    Command="{x:Bind ViewModel.ArchiveCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanArchive, Mode=OneWay}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE7B8;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                                <MenuFlyoutItem
                                    x:Uid="TaskEditor_MoreRestore"
                                    AutomationProperties.AutomationId="TaskEditor_MoreRestoreItem"
                                    Command="{x:Bind ViewModel.RestoreCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" />
                                <MenuFlyoutItem
                                    x:Uid="TaskEditor_MoreAddSubtaskCard"
                                    AutomationProperties.AutomationId="TaskEditor_MoreAddSubtaskCardItem"
                                    Command="{x:Bind ViewModel.RequestAddSubtaskCardCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanAddSubtaskCard, Mode=OneWay}" />
                                <MenuFlyoutSeparator />
                                <MenuFlyoutItem x:Uid="TaskEditor_MoreDelete" AutomationProperties.AutomationId="TaskEditor_MoreDeleteItem" Command="{x:Bind ViewModel.RequestDeleteCommand}">
                                    <MenuFlyoutItem.Icon>
                                        <FontIcon Glyph="&#xE74D;" />
                                    </MenuFlyoutItem.Icon>
                                </MenuFlyoutItem>
                            </MenuFlyout>
                        </Button.Flyout>
                    </Button>
                    <!-- Close goes through Closing, so a dirty draft asks first exactly as Cancel and Esc do (design §5.8). -->
                    <Button
                        x:Name="CloseIconButton"
                        x:Uid="TaskEditor_CloseButton"
                        Grid.Column="3"
                        VerticalAlignment="Top"
                        Style="{StaticResource SubtleButtonStyle}"
                        AutomationProperties.AutomationId="TaskEditor_CloseButton"
                        Click="OnCloseClick">
                        <FontIcon FontSize="14" Glyph="&#xE711;" />
                    </Button>
                </Grid>
                <local:FieldError Text="{x:Bind ViewModel.TagsError, Mode=OneWay}" />
            </StackPanel>

            <!--
                A closed InfoBar stays Visible with zero height, so the Root StackPanel would still add 12 epx of spacing
                for each one. Visibility follows IsOpen so closed bars reserve no space.
            -->
            <InfoBar
                x:Uid="TaskEditor_ValidationInfoBar"
                AutomationProperties.AutomationId="TaskEditor_ValidationInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasValidationSummary, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasValidationSummary), Mode=OneWay}" />

            <!-- Save failures and the conflict of design §5.10; the draft stays. -->
            <InfoBar
                AutomationProperties.AutomationId="TaskEditor_ErrorInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasSaveError), Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel
                        Margin="0,0,0,12"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsConflict), Mode=OneWay}">
                        <Button x:Uid="Conflict_ReviewButton" AutomationProperties.AutomationId="Conflict_ReviewButton" Command="{x:Bind ViewModel.ReviewConflictCommand}" />
                        <Button x:Uid="Conflict_ReloadButton" AutomationProperties.AutomationId="Conflict_ReloadButton" Command="{x:Bind ViewModel.BeginReloadCommand}" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                AutomationProperties.AutomationId="TaskEditor_CrChangedInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasCrChangedMessage, Mode=OneWay}"
                Message="{x:Bind ViewModel.CrChangedMessage, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasCrChangedMessage), Mode=OneWay}" />

            <!-- B-02.4: the permanence notice while a chosen link waits for Save. -->
            <InfoBar
                AutomationProperties.AutomationId="TaskEditor_PendingLinkInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasPendingLink, Mode=OneWay}"
                Message="{x:Bind ViewModel.PendingLinkWarning, Mode=OneWay}"
                Severity="Warning"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasPendingLink), Mode=OneWay}" />

            <InfoBar
                x:Uid="TaskEditor_ArchivedInfoBar"
                AutomationProperties.AutomationId="TaskEditor_ArchivedInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsArchived, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsArchived), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="TaskEditor_RestoreButton"
                        AutomationProperties.AutomationId="TaskEditor_RestoreButton"
                        Command="{x:Bind ViewModel.RestoreCommand}"
                        IsEnabled="{x:Bind ViewModel.CanRestore, Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <!-- ===== Form step ===== -->
            <StackPanel Spacing="16" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsFormStep), Mode=OneWay}">
                <!-- Title: the task's own title, or (B-02.3) the linked or link-pending CR's title, read-only. -->
                <StackPanel Spacing="4">
                    <TextBox
                        x:Name="TitleBox"
                        x:Uid="TaskEditor_TitleBox"
                        AutomationProperties.AutomationId="TaskEditor_TitleBox"
                        AutomationProperties.IsRequiredForForm="True"
                        IsReadOnly="{x:Bind common:BindFunctions.Not(ViewModel.IsTitleEditable), Mode=OneWay}"
                        MaxLength="250"
                        Style="{StaticResource TitleTextBoxStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsUnlinkedWithoutPending), Mode=OneWay}" />
                    <TextBlock
                        AutomationProperties.AutomationId="TaskEditor_InheritedTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        FontWeight="SemiBold"
                        IsTextSelectionEnabled="True"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.InheritedTitle, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.ShowInheritedTitle), Mode=OneWay}" />
                    <local:FieldError Text="{x:Bind ViewModel.TitleError, Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.Caption, Mode=OneWay}" />
                </StackPanel>

                <!--
                    Facts strip: the CR and what the task inherits from it (B-02.3, T-13). Four columns, two at the narrow
                    width (ApplyLayout). The copy buttons copy the plain number and show on hover or keyboard focus.
                -->
                <Border Padding="12" AutomationProperties.AutomationId="TaskEditor_FactsStrip" Style="{StaticResource SecondaryCardBorderStyle}">
                    <Grid x:Name="FactsGrid" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <StackPanel Spacing="2">
                            <TextBlock x:Uid="TaskEditor_CrNumberLabel" Style="{StaticResource FactLabelTextStyle}" />
                            <StackPanel
                                Background="Transparent"
                                GotFocus="OnRevealFocusChanged"
                                LostFocus="OnRevealFocusChanged"
                                Orientation="Horizontal"
                                PointerCanceled="OnRevealPointerExited"
                                PointerEntered="OnRevealPointerEntered"
                                PointerExited="OnRevealPointerExited"
                                Spacing="2"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.CanCopyCrNumber), Mode=OneWay}">
                                <!-- Design §5.1: the CR number link opens the CR, where inherited values are edited (B-02.4). -->
                                <HyperlinkButton
                                    Padding="0"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="TaskEditor_OpenCrLink"
                                    AutomationProperties.Name="{x:Bind ViewModel.OpenCrName, Mode=OneWay}"
                                    Command="{x:Bind ViewModel.RequestOpenCrCommand}"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.OpenCrName, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsLinked), Mode=OneWay}">
                                    <TextBlock Text="{x:Bind ViewModel.LinkedCrNumber, Mode=OneWay}" />
                                </HyperlinkButton>
                                <TextBlock
                                    IsTextSelectionEnabled="True"
                                    Style="{StaticResource FactValueTextStyle}"
                                    Text="{x:Bind ViewModel.PendingCrNumber, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasPendingLink), Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="TaskEditor_CopyCrNumberButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.CopyCrNumberName, Mode=OneWay}"
                                    Click="OnCopyCrNumberClick"
                                    Opacity="0"
                                    Style="{StaticResource CopyNumberButtonStyle}"
                                    Tag="Reveal"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CopyCrNumberName, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                            <!-- No Unlink and no Change exist (B-03.7); a pending link can still be replaced before Save. -->
                            <Button
                                x:Uid="TaskEditor_ChooseDifferentCrButton"
                                Margin="0,4,0,0"
                                AutomationProperties.AutomationId="TaskEditor_ChooseDifferentCrButton"
                                Command="{x:Bind ViewModel.BeginLinkCommand}"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasPendingLink), Mode=OneWay}" />
                            <Button
                                x:Uid="TaskEditor_LinkToCrButton"
                                Margin="0,4,0,0"
                                AutomationProperties.AutomationId="TaskEditor_LinkToCrButton"
                                Command="{x:Bind ViewModel.BeginLinkCommand}"
                                IsEnabled="{x:Bind ViewModel.CanLinkToCr, Mode=OneWay}"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsUnlinkedWithoutPending), Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="1" Spacing="2">
                            <TextBlock x:Uid="TaskEditor_TaskNumberLabel" Style="{StaticResource FactLabelTextStyle}" />
                            <StackPanel
                                Background="Transparent"
                                GotFocus="OnRevealFocusChanged"
                                LostFocus="OnRevealFocusChanged"
                                Orientation="Horizontal"
                                PointerCanceled="OnRevealPointerExited"
                                PointerEntered="OnRevealPointerEntered"
                                PointerExited="OnRevealPointerExited"
                                Spacing="2">
                                <TextBlock IsTextSelectionEnabled="True" Style="{StaticResource FactValueTextStyle}" Text="{x:Bind ViewModel.TaskNumberText, Mode=OneWay}" />
                                <Button
                                    AutomationProperties.AutomationId="TaskEditor_CopyTaskNumberButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.CopyTaskNumberName, Mode=OneWay}"
                                    Click="OnCopyTaskNumberClick"
                                    Opacity="0"
                                    Style="{StaticResource CopyNumberButtonStyle}"
                                    Tag="Reveal"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.CopyTaskNumberName, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.CanCopyTaskNumber), Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE8C8;" />
                                </Button>
                            </StackPanel>
                        </StackPanel>

                        <StackPanel Grid.Column="2" Spacing="2">
                            <TextBlock x:Uid="TaskEditor_SquadLabel" Style="{StaticResource FactLabelTextStyle}" />
                            <TextBlock Style="{StaticResource FactValueTextStyle}" Text="{x:Bind ViewModel.SquadText, Mode=OneWay}" />
                        </StackPanel>

                        <StackPanel Grid.Column="3" Spacing="2">
                            <TextBlock x:Uid="TaskEditor_OwnerLabel" Style="{StaticResource FactLabelTextStyle}" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <controls:PersonAvatar
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Diameter="20"
                                    DisplayName="{x:Bind ViewModel.OwnerText, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasOwner), Mode=OneWay}" />
                                <TextBlock Grid.Column="1" Style="{StaticResource FactValueTextStyle}" Text="{x:Bind ViewModel.OwnerText, Mode=OneWay}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Fields: three rows of columns, one column at the narrow width (ApplyLayout). Errors sit under their fields. -->
                <StackPanel Spacing="12">
                    <Grid x:Name="WorkflowFields" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <TextBox
                                x:Name="ServiceBox"
                                AutomationProperties.AutomationId="TaskEditor_ServiceBox"
                                AutomationProperties.IsRequiredForForm="{x:Bind ViewModel.IsServiceRequired, Mode=OneWay}"
                                Header="{x:Bind ViewModel.ServiceHeader, Mode=OneWay}"
                                IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                                MaxLength="250"
                                Text="{x:Bind ViewModel.Service, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.ServiceHelper, Mode=OneWay}"
                                TextWrapping="Wrap"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasServiceHelper), Mode=OneWay}" />
                            <local:FieldError Text="{x:Bind ViewModel.ServiceError, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <ComboBox
                                x:Name="StatusCombo"
                                x:Uid="TaskEditor_StatusCombo"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="TaskEditor_StatusCombo"
                                AutomationProperties.IsRequiredForForm="True"
                                IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                                ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                                SelectionChanged="OnStatusSelectionChanged" />
                            <local:FieldError Text="{x:Bind ViewModel.StatusError, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="2" Spacing="4">
                            <ComboBox
                                x:Name="PriorityCombo"
                                x:Uid="TaskEditor_PriorityCombo"
                                HorizontalAlignment="Stretch"
                                AutomationProperties.AutomationId="TaskEditor_PriorityCombo"
                                AutomationProperties.IsRequiredForForm="True"
                                IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                                ItemTemplate="{StaticResource PriorityChoiceTemplate}"
                                ItemsSource="{x:Bind ViewModel.PriorityOptions, Mode=OneWay}"
                                SelectionChanged="OnPrioritySelectionChanged" />
                            <local:FieldError Text="{x:Bind ViewModel.PriorityError, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- ADR 0024: one Designer and one Developer, single-person pickers (design §5.0). -->
                    <Grid x:Name="PeopleFields" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <controls:TokenPicker
                                x:Name="DesignerPicker"
                                x:Uid="TaskEditor_DesignerPicker"
                                BoxAutomationId="TaskEditor_DesignerPicker"
                                IsEditable="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                                ViewModel="{x:Bind ViewModel.Designer, Mode=OneWay}" />
                            <local:FieldError Text="{x:Bind ViewModel.DesignerError, Mode=OneWay}" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <controls:TokenPicker
                                x:Name="DeveloperPicker"
                                x:Uid="TaskEditor_DeveloperPicker"
                                BoxAutomationId="TaskEditor_DeveloperPicker"
                                IsEditable="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                                ViewModel="{x:Bind ViewModel.Developer, Mode=OneWay}" />
                            <local:FieldError Text="{x:Bind ViewModel.DeveloperError, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>

                    <!-- Dates: an explicit Clear is tracked for B-04 ("explicit manual clear"). -->
                    <Grid x:Name="DateFields" ColumnSpacing="16" RowSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <StackPanel Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker
                                    x:Uid="TaskEditor_StartDate"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="TaskEditor_StartDate"
                                    Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" />
                                <Button
                                    x:Uid="TaskEditor_ClearStartDateButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="TaskEditor_ClearStartDateButton"
                                    Command="{x:Bind ViewModel.ClearStartDateCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.StartHelper, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <Grid ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <CalendarDatePicker
                                    x:Name="EndDatePicker"
                                    x:Uid="TaskEditor_EndDate"
                                    HorizontalAlignment="Stretch"
                                    AutomationProperties.AutomationId="TaskEditor_EndDate"
                                    Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" />
                                <Button
                                    x:Uid="TaskEditor_ClearEndDateButton"
                                    Grid.Column="1"
                                    VerticalAlignment="Bottom"
                                    AutomationProperties.AutomationId="TaskEditor_ClearEndDateButton"
                                    Command="{x:Bind ViewModel.ClearEndDateCommand}"
                                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE711;" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ViewModel.EndHelper, Mode=OneWay}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                    <local:FieldError Text="{x:Bind ViewModel.DateError, Mode=OneWay}" />
                </StackPanel>

                <!--
                    Group 7: checklist items, edited in the draft (B-02.7), laid out like Planner's checklist. Each row has a
                    fixed left gutter that holds the drag grip, so the check and text never move when the row is hovered.
                    Row actions show on hover or while focus is inside the row (OnReveal*). The draft stays the source of
                    truth: a drag moves the item through MoveChecklistItemTo, never through the list itself.
                -->
                <StackPanel Spacing="4">
                    <TextBlock
                        AutomationProperties.AutomationId="TaskEditor_ChecklistHeading"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind ViewModel.ChecklistHeading, Mode=OneWay}" />
                    <ListView
                        x:Name="ChecklistList"
                        x:Uid="TaskEditor_ChecklistList"
                        MaxHeight="320"
                        AllowDrop="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                        AutomationProperties.AutomationId="TaskEditor_ChecklistList"
                        CanDragItems="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                        ContainerContentChanging="OnChecklistContainerContentChanging"
                        DragItemsCompleted="OnChecklistDragCompleted"
                        DragItemsStarting="OnChecklistDragStarting"
                        DragOver="OnChecklistDragOver"
                        Drop="OnChecklistDrop"
                        ItemsSource="{x:Bind ViewModel.ChecklistItems, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.Resources>
                            <!-- The row draws its own hover and focus highlight beside the gutter, so the item's own is off. -->
                            <StaticResource x:Key="ListViewItemBackgroundPointerOver" ResourceKey="SubtleFillColorTransparentBrush" />
                            <StaticResource x:Key="ListViewItemBackgroundPressed" ResourceKey="SubtleFillColorTransparentBrush" />
                        </ListView.Resources>
                        <ListView.ItemContainerStyle>
                            <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            </Style>
                        </ListView.ItemContainerStyle>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EditorChecklistItemViewModel">
                                <Grid
                                    Background="Transparent"
                                    GotFocus="OnRevealFocusChanged"
                                    LostFocus="OnRevealFocusChanged"
                                    PointerCanceled="OnRevealPointerExited"
                                    PointerEntered="OnRevealPointerEntered"
                                    PointerExited="OnRevealPointerExited">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        Grid.Column="1"
                                        Grid.ColumnSpan="3"
                                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                        CornerRadius="{ThemeResource ControlCornerRadius}"
                                        IsHitTestVisible="False"
                                        Opacity="0"
                                        Tag="Reveal" />
                                    <FontIcon
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AccessibilityView="Raw"
                                        FontSize="12"
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Glyph="&#xE76F;"
                                        Opacity="0"
                                        Tag="Reveal"
                                        Visibility="{x:Bind common:BindFunctions.Visible(CanEdit), Mode=OneWay}" />
                                    <CheckBox
                                        Grid.Column="1"
                                        MinWidth="0"
                                        Margin="8,0,0,0"
                                        Padding="0"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_ChecklistCheck_', Id.Value), Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind Text, Mode=OneWay}"
                                        CornerRadius="10"
                                        IsChecked="{x:Bind IsCompleted, Mode=TwoWay}"
                                        IsEnabled="{x:Bind CanEdit, Mode=OneWay}" />
                                    <TextBox
                                        Grid.Column="2"
                                        VerticalAlignment="Center"
                                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_ChecklistText_', Id.Value), Mode=OneTime}"
                                        AutomationProperties.Name="{x:Bind Text, Mode=OneWay}"
                                        IsReadOnly="{x:Bind common:BindFunctions.Not(CanEdit), Mode=OneWay}"
                                        MaxLength="2000"
                                        Style="{StaticResource InlineTextBoxStyle}"
                                        Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel
                                        Grid.Column="3"
                                        Margin="4,0,4,0"
                                        Opacity="0"
                                        Orientation="Horizontal"
                                        Spacing="2"
                                        Tag="Reveal"
                                        Visibility="{x:Bind common:BindFunctions.Visible(CanEdit), Mode=OneWay}">
                                        <Button
                                            x:Uid="TaskEditor_ChecklistMoveUpButton"
                                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_ChecklistMoveUp_', Id.Value), Mode=OneTime}"
                                            Click="OnItemMoveUpClick"
                                            Style="{StaticResource ChecklistActionButtonStyle}">
                                            <FontIcon FontSize="12" Glyph="&#xE74A;" />
                                        </Button>
                                        <Button
                                            x:Uid="TaskEditor_ChecklistMoveDownButton"
                                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_ChecklistMoveDown_', Id.Value), Mode=OneTime}"
                                            Click="OnItemMoveDownClick"
                                            Style="{StaticResource ChecklistActionButtonStyle}">
                                            <FontIcon FontSize="12" Glyph="&#xE74B;" />
                                        </Button>
                                        <!-- A disabled button shows no tooltip, so the reason sits on a wrapper (design §5.1 group 7). -->
                                        <Border Background="Transparent" ToolTipService.ToolTip="{x:Bind common:BindFunctions.ToolTipOrNull(PopOutUnavailableReason), Mode=OneWay}">
                                            <Button
                                                x:Uid="TaskEditor_ChecklistPopOutButton"
                                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_ChecklistPopOut_', Id.Value), Mode=OneTime}"
                                                AutomationProperties.HelpText="{x:Bind PopOutUnavailableReason, Mode=OneWay}"
                                                Click="OnItemPopOutClick"
                                                IsEnabled="{x:Bind CanPopOut, Mode=OneWay}"
                                                Style="{StaticResource ChecklistActionButtonStyle}">
                                                <FontIcon FontSize="12" Glyph="&#xE8A7;" />
                                            </Button>
                                        </Border>
                                        <Button
                                            x:Uid="TaskEditor_ChecklistDeleteButton"
                                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_ChecklistDelete_', Id.Value), Mode=OneTime}"
                                            Click="OnItemDeleteClick"
                                            Style="{StaticResource ChecklistActionButtonStyle}">
                                            <FontIcon FontSize="12" Glyph="&#xE74D;" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <!-- Add an item: the last row, aligned with the rows above (same gutter and circle column). Enter adds. -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="24" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Ellipse
                            Grid.Column="1"
                            Width="20"
                            Height="20"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Stroke="{ThemeResource ControlStrongStrokeColorDefaultBrush}"
                            StrokeThickness="1" />
                        <TextBox
                            x:Uid="TaskEditor_AddChecklistBox"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="TaskEditor_AddChecklistBox"
                            IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                            KeyDown="OnAddChecklistKeyDown"
                            MaxLength="2000"
                            Style="{StaticResource InlineTextBoxStyle}"
                            Text="{x:Bind ViewModel.NewChecklistText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    </Grid>
                    <local:FieldError Text="{x:Bind ViewModel.ChecklistError, Mode=OneWay}" />
                </StackPanel>


                <!-- Group 8: Subtask cards are created immediately, never drafted (design §5.1). -->
                <StackPanel Spacing="8">
                    <TextBlock x:Uid="TaskEditor_SubtaskCardsHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <!-- Opening a card closes this dialog (after §5.8) and opens the Subtask card editor (§5.2). -->
                    <ListView
                        x:Uid="TaskEditor_SubtaskCardsList"
                        MaxHeight="240"
                        AutomationProperties.AutomationId="TaskEditor_SubtaskCardsList"
                        IsItemClickEnabled="{x:Bind common:BindFunctions.Not(ViewModel.IsNew), Mode=OneWay}"
                        ItemClick="OnSubtaskCardClick"
                        ItemsSource="{x:Bind ViewModel.SubtaskCards, Mode=OneWay}"
                        SelectionMode="None">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="local:EditorSubtaskCardViewModel">
                                <StackPanel
                                    Padding="0,6"
                                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('TaskEditor_SubtaskCard_', Id.Value), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind Subtitle, Mode=OneTime}">
                                    <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Subtitle, Mode=OneTime}" TextWrapping="Wrap" />
                                    <StackPanel Orientation="Horizontal" Spacing="8">
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind StatusName, Mode=OneTime}" />
                                        <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind DatesText, Mode=OneTime}" />
                                    </StackPanel>
                                </StackPanel>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Name="SubtaskCardBox"
                            x:Uid="TaskEditor_AddSubtaskCardBox"
                            AutomationProperties.AutomationId="TaskEditor_AddSubtaskCardBox"
                            IsEnabled="{x:Bind ViewModel.CanAddSubtaskCard, Mode=OneWay}"
                            KeyDown="OnAddSubtaskKeyDown"
                            MaxLength="250"
                            Text="{x:Bind ViewModel.NewSubtaskCardText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Uid="TaskEditor_AddSubtaskCardButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="TaskEditor_AddSubtaskCardButton"
                            Command="{x:Bind ViewModel.AddSubtaskCardCommand}"
                            IsEnabled="{x:Bind ViewModel.CanAddSubtaskCard, Mode=OneWay}" />
                    </Grid>
                    <local:FieldError Text="{x:Bind ViewModel.SubtaskCardError, Mode=OneWay}" />
                </StackPanel>

                <!-- Group 9: notes. -->
                <TextBox
                    x:Name="NotesBox"
                    x:Uid="TaskEditor_NotesBox"
                    MinHeight="96"
                    MaxHeight="320"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="TaskEditor_NotesBox"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <local:FieldError Text="{x:Bind ViewModel.NotesError, Mode=OneWay}" />

                <!-- Group 10: custom fields (B-11), one typed editor per active field (design §5.0). -->
                <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.CustomFields.HasFields), Mode=OneTime}">
                    <TextBlock x:Uid="TaskEditor_CustomFieldsHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <fields:CustomFieldsPanel
                        x:Name="CustomFieldsPanel"
                        AutomationPrefix="TaskEditor"
                        ViewModel="{x:Bind ViewModel.CustomFields, Mode=OneTime}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Link to CR, step 1: pick (design §5.6). A CR is never shown as occupied. ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsLinkPickStep), Mode=OneWay}">
                <TextBlock x:Uid="LinkCr_PickHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <AutoSuggestBox
                    x:Name="CrSearchBox"
                    x:Uid="LinkCr_SearchBox"
                    AutomationProperties.AutomationId="LinkCr_SearchBox"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.CrPicker.Query, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, FallbackValue=''}" />
                <ListView
                    x:Uid="LinkCr_ResultsList"
                    MaxHeight="360"
                    AutomationProperties.AutomationId="LinkCr_ResultsList"
                    x:Name="CrResultsList"
                    ItemsSource="{x:Bind ViewModel.CrPicker.Results, Mode=OneWay, FallbackValue={x:Null}}"
                    SelectionChanged="OnCrSelectionChanged"
                    SelectionMode="Single">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="local:CrChoice">
                            <StackPanel Padding="0,6" AutomationProperties.Name="{x:Bind local:TaskEditorDialog.CrName(Number, Title, Secondary), Mode=OneTime}">
                                <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Number, Mode=OneTime}" />
                                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind Title, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Secondary, Mode=OneTime}" />
                            </StackPanel>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="LinkCr_BackButton" Command="{x:Bind ViewModel.StepBackCommand}" />
                    <Button
                        x:Uid="LinkCr_NextButton"
                        AutomationProperties.AutomationId="LinkCr_NextButton"
                        Command="{x:Bind ViewModel.LinkNextCommand}"
                        IsEnabled="{x:Bind ViewModel.CrPicker.HasSelection, Mode=OneWay, FallbackValue=False}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Link to CR, step 2: confirm permanence (B-02.4, design §5.6). ===== -->
            <StackPanel
                AutomationProperties.AutomationId="LinkCr_ConfirmStep"
                Spacing="12"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsLinkConfirmStep), Mode=OneWay}">
                <TextBlock x:Uid="LinkCr_ConfirmHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.CrPicker.TitleLine(ViewModel.CrPicker.Selected), Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind ViewModel.CrPicker.InheritLine(ViewModel.CrPicker.Selected), Mode=OneWay}" TextWrapping="Wrap" />
                <TextBlock x:Uid="LinkCr_PermanentLine" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <TextBox
                    x:Uid="LinkCr_ServiceBox"
                    AutomationProperties.AutomationId="LinkCr_ServiceBox"
                    AutomationProperties.IsRequiredForForm="True"
                    IsReadOnly="{x:Bind ViewModel.IsLinkServiceLocked, Mode=OneWay}"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Service, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <local:FieldError Text="{x:Bind ViewModel.ServiceError, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="LinkCr_ConfirmBackButton" Command="{x:Bind ViewModel.StepBackCommand}" />
                    <Button
                        x:Uid="LinkCr_LinkButton"
                        AutomationProperties.AutomationId="LinkCr_LinkButton"
                        Command="{x:Bind ViewModel.ConfirmLinkCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Conflict review (design §5.10). ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsConflictReviewStep), Mode=OneWay}">
                <TextBlock x:Uid="Conflict_ReviewHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Conflict_FieldHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Conflict_MineHeader" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Conflict_SavedHeader" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Conflict_UseMineHeader" Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <ItemsControl AutomationProperties.AutomationId="Conflict_Rows" ItemsSource="{x:Bind ViewModel.ConflictRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="local:ConflictRowViewModel">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Field, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Mine, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Saved, Mode=OneTime}" TextWrapping="Wrap" />
                                <CheckBox
                                    Grid.Column="3"
                                    MinWidth="0"
                                    AutomationProperties.AutomationId="{x:Bind local:TaskEditorDialog.UseMineId(Key), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind Field, Mode=OneTime}"
                                    IsChecked="{x:Bind UseMine, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="Conflict_BackButton" Command="{x:Bind ViewModel.StepBackCommand}" />
                    <Button
                        x:Uid="Conflict_ApplyButton"
                        AutomationProperties.AutomationId="Conflict_ApplyButton"
                        Command="{x:Bind ViewModel.ApplyConflictReviewCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Reload confirmation (design §5.10: Reload discards the draft after a confirmation). ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReloadConfirmStep), Mode=OneWay}">
                <TextBlock x:Uid="Conflict_ReloadMessage" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="Conflict_ReloadBackButton" Command="{x:Bind ViewModel.StepBackCommand}" />
                    <Button
                        x:Uid="Conflict_ReloadConfirmButton"
                        AutomationProperties.AutomationId="Conflict_ReloadConfirmButton"
                        Command="{x:Bind ViewModel.ConfirmReloadCommand}"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Design §5.0 saving row: buttons disabled, ring and text shown. -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsSaving), Mode=OneWay}">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
                <TextBlock x:Uid="TaskEditor_Saving" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
