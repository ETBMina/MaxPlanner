<?xml version="1.0" encoding="utf-8"?>
<!--
    Native horizontal bar chart (ADR 0011, design §4.1, T-08): one accent hue for a single series, the count always as
    text, thin bars with a rounded data end, no hover dependency, and a Table toggle with the same rows and commands.
    The Gallery Chart control is preview-only and absent from the stable WinAppSDK index, so it is not used.
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Dashboard.BarChart"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Dashboard"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="BarRowTemplate" x:DataType="local:BarRowViewModel">
            <!-- Each bar row is a button named "In Progress, 6 tasks, 19 percent of 32. Opens matching tasks in Grid." -->
            <Button
                Padding="8,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind DrillDownCommand, Mode=OneTime}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="35*" />
                        <ColumnDefinition Width="65*" />
                        <ColumnDefinition Width="Auto" MinWidth="32" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyTextBlockStyle}"
                        Text="{x:Bind Label, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <!-- Bar length is the share of the largest count: at least 2 epx above zero, absent at zero. -->
                    <controls:BarTrack
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AccessibilityView="Raw"
                        Fraction="{x:Bind Fraction, Mode=OneWay}">
                        <Border
                            Height="14"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="0,4,4,0" />
                    </controls:BarTrack>
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind CountText, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TableRowTemplate" x:DataType="local:BarRowViewModel">
            <Button
                Padding="8,6"
                HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Stretch"
                AutomationProperties.AutomationId="{x:Bind local:BarChart.TableId(AutomationId), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Background="Transparent"
                BorderThickness="0"
                Command="{x:Bind DrillDownCommand, Mode=OneTime}">
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{x:Bind Label, Mode=OneWay}" TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Text="{x:Bind CountText, Mode=OneWay}" />
                    <TextBlock
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Text="{x:Bind ShareText, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Border Padding="16" Style="{StaticResource CardBorderStyle}">
        <StackPanel x:Name="ChartRoot" Spacing="8">
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind ViewModel.Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.TotalText, Mode=OneWay}" />
                </StackPanel>
                <ToggleButton
                    x:Name="TableToggle"
                    x:Uid="Dashboard_TableToggle"
                    Grid.Column="1"
                    VerticalAlignment="Top"
                    IsChecked="{x:Bind ViewModel.IsTableMode, Mode=TwoWay}" />
            </Grid>

            <ItemsRepeater
                ItemTemplate="{StaticResource BarRowTemplate}"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsBarMode), Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="2" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>

            <StackPanel Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsTableMode), Mode=OneWay}">
                <Grid
                    Padding="8,4"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="72" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Dashboard_TableCategory" Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Dashboard_TableCount"
                        Grid.Column="1"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                    <TextBlock
                        x:Uid="Dashboard_TableShare"
                        Grid.Column="2"
                        HorizontalAlignment="Right"
                        Style="{StaticResource CaptionTextBlockStyle}" />
                </Grid>
                <ItemsRepeater ItemTemplate="{StaticResource TableRowTemplate}" ItemsSource="{x:Bind ViewModel.Rows, Mode=OneWay}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="0" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>

            <TextBlock
                x:Uid="Dashboard_ChartEmpty"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsEmpty), Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Footnote, Mode=OneWay}"
                TextWrapping="Wrap"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasFootnote), Mode=OneWay}" />
        </StackPanel>
    </Border>
</UserControl>
