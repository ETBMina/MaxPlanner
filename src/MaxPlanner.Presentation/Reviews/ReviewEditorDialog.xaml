<?xml version="1.0" encoding="utf-8"?>
<!--
    Review editor (design §5.4, B-17) on the native ContentDialog [gallery-contentdialog-1, -2]. The CR number is
    free text; "Open CR" appears only when it matches an existing CR's normalized number and never links (B-17.3).
-->
<ContentDialog
    x:Class="MaxPlanner.Presentation.Reviews.ReviewEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:tasks="using:MaxPlanner.Presentation.Tasks"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    AutomationProperties.AutomationId="ReviewEditor_Dialog"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
    Closing="OnClosing"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryClick"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,12,0" Spacing="12">
            <StackPanel.KeyboardAccelerators>
                <!-- Design §7.2: Ctrl+Enter saves from anywhere. -->
                <KeyboardAccelerator Key="Enter" Invoked="OnSaveAccelerator" Modifiers="Control" />
            </StackPanel.KeyboardAccelerators>

            <!-- Title row: caption and the More menu (design §5.4: Delete…). -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Caption, Mode=OneWay}" />
                <DropDownButton
                    x:Uid="ReviewEditor_MoreMenu"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="ReviewEditor_MoreMenu"
                    IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <DropDownButton.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="ReviewEditor_MoreDelete" AutomationProperties.AutomationId="ReviewEditor_MoreDeleteItem" Click="OnDeleteClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </DropDownButton.Flyout>
                </DropDownButton>
            </Grid>

            <!-- Design §5.8: the dirty-close step is an inline Warning InfoBar; focus moves to Save. -->
            <InfoBar
                x:Uid="DirtyClose_InfoBar"
                AutomationProperties.AutomationId="DirtyClose_InfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsDirtyClosePromptOpen, Mode=OneWay}"
                Severity="Warning">
                <InfoBar.ActionButton>
                    <Button
                        x:Name="DirtyCloseSaveButton"
                        x:Uid="DirtyClose_SaveButton"
                        AutomationProperties.AutomationId="DirtyClose_SaveButton"
                        Click="OnDirtySaveClick"
                        Style="{StaticResource AccentButtonStyle}" />
                </InfoBar.ActionButton>
                <InfoBar.Content>
                    <StackPanel Margin="0,0,0,12" Orientation="Horizontal" Spacing="8">
                        <Button x:Uid="DirtyClose_DiscardButton" AutomationProperties.AutomationId="DirtyClose_DiscardButton" Click="OnDiscardClick" />
                        <Button x:Uid="DirtyClose_ContinueButton" AutomationProperties.AutomationId="DirtyClose_ContinueButton" Click="OnContinueClick" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <InfoBar
                x:Uid="TaskEditor_ValidationInfoBar"
                AutomationProperties.AutomationId="ReviewEditor_ValidationInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasValidationSummary, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error" />

            <!-- A conflict keeps the draft; Reload replaces it with the saved review (design §5.10, simplified). -->
            <InfoBar
                AutomationProperties.AutomationId="ReviewEditor_ErrorInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                Severity="Error">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="Conflict_ReloadButton"
                        AutomationProperties.AutomationId="Conflict_ReloadButton"
                        Click="OnReloadClick"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsConflict), Mode=OneWay}" />
                </InfoBar.ActionButton>
            </InfoBar>

            <TextBlock x:Uid="TaskEditor_RequiredLegend" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="TitleBox"
                    x:Uid="ReviewEditor_TitleBox"
                    AutomationProperties.AutomationId="ReviewEditor_TitleBox"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <tasks:FieldError Text="{x:Bind ViewModel.TitleError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        x:Name="CrNumberBox"
                        x:Uid="ReviewEditor_CrNumberBox"
                        AutomationProperties.AutomationId="ReviewEditor_CrNumberBox"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                        MaxLength="100"
                        Text="{x:Bind ViewModel.CrNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <HyperlinkButton
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="ReviewEditor_OpenCrLink"
                        Click="OnOpenCrClick"
                        Content="{x:Bind ViewModel.OpenCrText, Mode=OneWay}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasMatchingCr), Mode=OneWay}" />
                </Grid>
                <tasks:FieldError Text="{x:Bind ViewModel.CrNumberError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="TaskNumberBox"
                    x:Uid="ReviewEditor_TaskNumberBox"
                    AutomationProperties.AutomationId="ReviewEditor_TaskNumberBox"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    MaxLength="100"
                    Text="{x:Bind ViewModel.TaskNumber, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <tasks:FieldError Text="{x:Bind ViewModel.TaskNumberError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <controls:TokenPicker
                    x:Name="ServicesPicker"
                    x:Uid="ReviewEditor_ServicesPicker"
                    BoxAutomationId="ReviewEditor_ServicesPicker"
                    IsEditable="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel.Services, Mode=OneTime}" />
                <tasks:FieldError Text="{x:Bind ViewModel.ServicesError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <controls:TokenPicker
                    x:Name="DeveloperPicker"
                    x:Uid="ReviewEditor_DeveloperPicker"
                    BoxAutomationId="ReviewEditor_DeveloperPicker"
                    IsEditable="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    ViewModel="{x:Bind ViewModel.Developer, Mode=OneTime}" />
                <tasks:FieldError Text="{x:Bind ViewModel.DeveloperError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="CommentsBox"
                    x:Uid="ReviewEditor_CommentsBox"
                    MinHeight="96"
                    MaxHeight="320"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="ReviewEditor_CommentsBox"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    MaxLength="100000"
                    ScrollViewer.VerticalScrollBarVisibility="Auto"
                    Text="{x:Bind ViewModel.Comments, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <tasks:FieldError Text="{x:Bind ViewModel.CommentsError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="2">
                <CheckBox
                    x:Uid="ReviewEditor_DoneCheck"
                    AutomationProperties.AutomationId="ReviewEditor_DoneCheck"
                    IsChecked="{x:Bind ViewModel.IsDone, Mode=TwoWay}"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" />
                <TextBlock
                    AutomationProperties.AutomationId="ReviewEditor_CompletedCaption"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.DoneCaption, Mode=OneWay}" />
            </StackPanel>

            <!-- Design §5.0 saving row. -->
            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsSaving), Mode=OneWay}">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
                <TextBlock x:Uid="TaskEditor_Saving" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
