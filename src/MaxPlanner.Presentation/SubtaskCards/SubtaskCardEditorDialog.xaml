<?xml version="1.0" encoding="utf-8"?>
<!--
    Subtask card editor (design §5.2) on the native ContentDialog [gallery-contentdialog-1, -2]. The parent block
    is read-only; conflict review and reload are inline steps of this one dialog (design §5.0, §5.10).
-->
<ContentDialog
    x:Class="MaxPlanner.Presentation.SubtaskCards.SubtaskCardEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:tasks="using:MaxPlanner.Presentation.Tasks"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    AutomationProperties.AutomationId="SubtaskEditor_Dialog"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
    Closing="OnClosing"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryClick"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ContentDialog.Resources>
        <x:Double x:Key="ContentDialogMaxWidth">640</x:Double>
    </ContentDialog.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Padding="0,0,12,0" Spacing="12">
            <StackPanel.KeyboardAccelerators>
                <!-- Design §7.2: Ctrl+Enter saves from anywhere; Alt+Left goes back on an inline step. -->
                <KeyboardAccelerator Key="Enter" Invoked="OnSaveAccelerator" Modifiers="Control" />
                <KeyboardAccelerator Key="Left" Invoked="OnBackAccelerator" Modifiers="Menu" />
            </StackPanel.KeyboardAccelerators>

            <!-- Title row: "Subtask of {parent}" and the More menu (design §5.0, §5.2). -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SubtaskEditor_Caption"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Caption, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="SubtaskEditor_MoreMenu"
                    Grid.Column="1"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.AutomationId="SubtaskEditor_MoreMenu"
                    IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="SubtaskEditor_MoreDelete" AutomationProperties.AutomationId="SubtaskEditor_MoreDeleteItem" Click="OnDeleteClick">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <InfoBar
                x:Uid="TaskEditor_ValidationInfoBar"
                AutomationProperties.AutomationId="SubtaskEditor_ValidationInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasValidationSummary, Mode=OneWay}"
                Message="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasValidationSummary), Mode=OneWay}" />

            <InfoBar
                AutomationProperties.AutomationId="SubtaskEditor_ErrorInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasSaveError, Mode=OneWay}"
                Message="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                Severity="Error"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasSaveError), Mode=OneWay}">
                <InfoBar.Content>
                    <StackPanel
                        Margin="0,0,0,12"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsConflict), Mode=OneWay}">
                        <Button x:Uid="Conflict_ReviewButton" AutomationProperties.AutomationId="Conflict_ReviewButton" Click="OnReviewConflictClick" />
                        <Button x:Uid="Conflict_ReloadButton" AutomationProperties.AutomationId="Conflict_ReloadButton" Click="OnReloadClick" />
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- B-16.6: the cards of an archived parent are read-only until it is restored. -->
            <InfoBar
                x:Uid="SubtaskEditor_ParentArchivedInfoBar"
                AutomationProperties.AutomationId="SubtaskEditor_ParentArchivedInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsParentArchived, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsParentArchived), Mode=OneWay}" />

            <!-- ===== Form step ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsFormStep), Mode=OneWay}">
                <!-- Read-only parent block (design §5.2): values come from the parent and its CR (T-13). -->
                <Border
                    Padding="12"
                    AutomationProperties.AutomationId="SubtaskEditor_ParentCard"
                    Style="{StaticResource SecondaryCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SubtaskEditor_ParentHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="SubtaskEditor_OpenParentLink"
                            AutomationProperties.Name="{x:Bind ViewModel.ParentTitle, Mode=OneWay}"
                            Click="OnOpenParentClick"
                            IsEnabled="{x:Bind ViewModel.CanOpenParent, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ParentTitle, Mode=OneWay}" TextWrapping="Wrap" />
                        </HyperlinkButton>
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="SubtaskEditor_ServiceLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock AutomationProperties.AutomationId="SubtaskEditor_ParentService" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.ParentService, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="SubtaskEditor_CrNumberLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock AutomationProperties.AutomationId="SubtaskEditor_CrNumber" IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.CrNumberText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Uid="TaskEditor_TaskNumberLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock IsTextSelectionEnabled="True" Text="{x:Bind ViewModel.TaskNumberText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Uid="TaskEditor_SquadLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SquadText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock x:Uid="TaskEditor_OwnerLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PersonAvatar
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Top"
                                        Diameter="20"
                                        DisplayName="{x:Bind ViewModel.OwnerText, Mode=OneWay}"
                                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasOwner), Mode=OneWay}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind ViewModel.OwnerText, Mode=OneWay}" TextWrapping="Wrap" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBox
                    x:Name="SubtitleBox"
                    x:Uid="SubtaskEditor_SubtitleBox"
                    AutomationProperties.AutomationId="SubtaskEditor_SubtitleBox"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Subtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <tasks:FieldError Text="{x:Bind ViewModel.SubtitleError, Mode=OneWay}" />

                <ComboBox
                    x:Name="StatusCombo"
                    x:Uid="SubtaskEditor_StatusCombo"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SubtaskEditor_StatusCombo"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                    SelectionChanged="OnStatusSelectionChanged" />
                <!-- AC-32: the helper states that the parent task never changes. -->
                <TextBlock
                    x:Uid="SubtaskEditor_StatusHelper"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
                <tasks:FieldError Text="{x:Bind ViewModel.StatusError, Mode=OneWay}" />

                <!-- Dates: an explicit Clear is tracked for B-04 ("explicit manual clear"). -->
                <Grid ColumnSpacing="8" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <CalendarDatePicker
                        x:Uid="TaskEditor_StartDate"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="SubtaskEditor_StartDate"
                        Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" />
                    <Button
                        x:Uid="TaskEditor_ClearStartDateButton"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="SubtaskEditor_ClearStartDateButton"
                        Click="OnClearStartClick"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StartHelper, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <CalendarDatePicker
                        x:Name="EndDatePicker"
                        x:Uid="TaskEditor_EndDate"
                        Grid.Row="2"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="SubtaskEditor_EndDate"
                        Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" />
                    <Button
                        x:Uid="TaskEditor_ClearEndDateButton"
                        Grid.Row="2"
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        AutomationProperties.AutomationId="SubtaskEditor_ClearEndDateButton"
                        Click="OnClearEndClick"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE711;" />
                    </Button>
                    <TextBlock
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.EndHelper, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </Grid>
                <tasks:FieldError Text="{x:Bind ViewModel.DateError, Mode=OneWay}" />

                <TextBox
                    x:Name="NotesBox"
                    x:Uid="TaskEditor_NotesBox"
                    MinHeight="96"
                    MaxHeight="320"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="SubtaskEditor_NotesBox"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <tasks:FieldError Text="{x:Bind ViewModel.NotesError, Mode=OneWay}" />
            </StackPanel>

            <!-- ===== Conflict review (design §5.10). ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsConflictReviewStep), Mode=OneWay}">
                <TextBlock x:Uid="Conflict_ReviewHeading" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource SubtitleTextBlockStyle}" />
                <Grid ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="120" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock x:Uid="Conflict_FieldHeader" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Conflict_MineHeader" Grid.Column="1" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Conflict_SavedHeader" Grid.Column="2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                    <TextBlock x:Uid="Conflict_UseMineHeader" Grid.Column="3" Style="{StaticResource BodyStrongTextBlockStyle}" />
                </Grid>
                <ItemsControl AutomationProperties.AutomationId="Conflict_Rows" ItemsSource="{x:Bind ViewModel.ConflictRows, Mode=OneWay}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="tasks:ConflictRowViewModel">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="120" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="{x:Bind Field, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="1" Text="{x:Bind Mine, Mode=OneTime}" TextWrapping="Wrap" />
                                <TextBlock Grid.Column="2" Text="{x:Bind Saved, Mode=OneTime}" TextWrapping="Wrap" />
                                <CheckBox
                                    Grid.Column="3"
                                    MinWidth="0"
                                    AutomationProperties.AutomationId="{x:Bind tasks:TaskEditorDialog.UseMineId(Key), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind Field, Mode=OneTime}"
                                    IsChecked="{x:Bind UseMine, Mode=TwoWay}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="Conflict_BackButton" Click="OnStepBackClick" />
                    <Button
                        x:Uid="Conflict_ApplyButton"
                        AutomationProperties.AutomationId="Conflict_ApplyButton"
                        Click="OnApplyConflictClick"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- ===== Reload confirmation (design §5.10). ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReloadConfirmStep), Mode=OneWay}">
                <TextBlock x:Uid="SubtaskEditor_ReloadMessage" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <Button x:Uid="LinkCr_BackButton" AutomationProperties.AutomationId="Conflict_ReloadBackButton" Click="OnStepBackClick" />
                    <Button
                        x:Uid="Conflict_ReloadConfirmButton"
                        AutomationProperties.AutomationId="Conflict_ReloadConfirmButton"
                        Click="OnConfirmReloadClick"
                        Style="{StaticResource AccentButtonStyle}" />
                </StackPanel>
            </StackPanel>

            <!-- Design §5.0 saving row. -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsSaving), Mode=OneWay}">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
                <TextBlock x:Uid="TaskEditor_Saving" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
