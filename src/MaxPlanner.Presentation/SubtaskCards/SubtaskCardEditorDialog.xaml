<?xml version="1.0" encoding="utf-8"?>
<!--
    Subtask card editor (design §5.2) on the native ContentDialog [gallery-contentdialog-1, -2]. The parent block
    is read-only; conflict review and reload are inline steps of this one dialog (design §5.0, §5.10).
-->
<ContentDialog
    x:Class="MaxPlanner.Presentation.SubtaskCards.SubtaskCardEditorDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:dialogs="using:MaxPlanner.Presentation.Common.Dialogs"
    xmlns:fields="using:MaxPlanner.Presentation.Common.Fields"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneWay}"
    AutomationProperties.AutomationId="SubtaskEditor_Dialog"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanSave, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Padding="0,0,12,0" Spacing="12">
            <!-- EditorDialogShell adds the Ctrl+Enter and Alt+Left accelerators here (design §7.2). -->

            <!-- Title row: "Subtask of {parent}" and the More menu (design §5.0, §5.2). -->
            <Grid ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="SubtaskEditor_Caption"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.Caption, Mode=OneWay}"
                    TextWrapping="Wrap" />
                <Button
                    x:Uid="SubtaskEditor_MoreMenu"
                    Grid.Column="1"
                    Style="{StaticResource SubtleButtonStyle}"
                    AutomationProperties.AutomationId="SubtaskEditor_MoreMenu"
                    IsEnabled="{x:Bind ViewModel.CanDelete, Mode=OneWay}">
                    <FontIcon FontSize="{StaticResource BodyIconSize}" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Placement="BottomEdgeAlignedRight">
                            <MenuFlyoutItem x:Uid="SubtaskEditor_MoreDelete" AutomationProperties.AutomationId="SubtaskEditor_MoreDeleteItem" Command="{x:Bind ViewModel.RequestDeleteCommand}">
                                <MenuFlyoutItem.Icon>
                                    <FontIcon Glyph="&#xE74D;" />
                                </MenuFlyoutItem.Icon>
                            </MenuFlyoutItem>
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>

            <dialogs:EditorMessageBars
                AutomationPrefix="SubtaskEditor"
                IsConflict="{x:Bind ViewModel.IsConflict, Mode=OneWay}"
                ReloadCommand="{x:Bind ViewModel.BeginReloadCommand}"
                ReviewConflictCommand="{x:Bind ViewModel.ReviewConflictCommand}"
                SaveError="{x:Bind ViewModel.SaveError, Mode=OneWay}"
                ValidationSummary="{x:Bind ViewModel.ValidationSummary, Mode=OneWay}" />

            <!-- B-16.6: the cards of an archived parent are read-only until it is restored. -->
            <InfoBar
                x:Uid="SubtaskEditor_ParentArchivedInfoBar"
                AutomationProperties.AutomationId="SubtaskEditor_ParentArchivedInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsParentArchived, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsParentArchived), Mode=OneWay}" />

            <!-- ===== Form step ===== -->
            <StackPanel Spacing="12" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsFormStep), Mode=OneWay}">
                <!-- Read-only parent block (design §5.2): values come from the parent and its CR (T-13). -->
                <Border
                    Padding="12"
                    AutomationProperties.AutomationId="SubtaskEditor_ParentCard"
                    Style="{StaticResource SecondaryCardBorderStyle}">
                    <StackPanel Spacing="8">
                        <TextBlock x:Uid="SubtaskEditor_ParentHeader" AutomationProperties.HeadingLevel="Level2" Style="{StaticResource BodyStrongTextBlockStyle}" />
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="SubtaskEditor_OpenParentLink"
                            AutomationProperties.Name="{x:Bind ViewModel.ParentTitle, Mode=OneWay}"
                            Command="{x:Bind ViewModel.RequestOpenParentCommand}"
                            IsEnabled="{x:Bind ViewModel.CanOpenParent, Mode=OneWay}">
                            <TextBlock Text="{x:Bind ViewModel.ParentTitle, Mode=OneWay}" TextWrapping="Wrap" />
                        </HyperlinkButton>
                        <Grid ColumnSpacing="12" RowSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel>
                                <TextBlock x:Uid="SubtaskEditor_ServiceLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <controls:FactValue IsValueSelectable="True" LabelUid="SubtaskEditor_ServiceLabel" Value="{x:Bind ViewModel.ParentService, Mode=OneWay}" ValueAutomationId="SubtaskEditor_ParentService" />
                            </StackPanel>
                            <StackPanel Grid.Column="1">
                                <TextBlock x:Uid="SubtaskEditor_CrNumberLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <controls:FactValue IsValueSelectable="True" LabelUid="SubtaskEditor_CrNumberLabel" Value="{x:Bind ViewModel.CrNumberText, Mode=OneWay}" ValueAutomationId="SubtaskEditor_CrNumber" />
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock x:Uid="TaskEditor_TaskNumberLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <controls:FactValue IsValueSelectable="True" LabelUid="TaskEditor_TaskNumberLabel" Value="{x:Bind ViewModel.TaskNumberText, Mode=OneWay}" />
                            </StackPanel>
                            <StackPanel Grid.Row="1">
                                <TextBlock x:Uid="TaskEditor_SquadLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <TextBlock Text="{x:Bind ViewModel.SquadText, Mode=OneWay}" TextWrapping="Wrap" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.Column="1">
                                <TextBlock x:Uid="TaskEditor_OwnerLabel" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:PersonAvatar
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Top"
                                        Diameter="20"
                                        DisplayName="{x:Bind ViewModel.OwnerText, Mode=OneWay}"
                                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasOwner), Mode=OneWay}" />
                                    <controls:FactValue Grid.Column="1" VerticalAlignment="Center" LabelUid="TaskEditor_OwnerLabel" Value="{x:Bind ViewModel.OwnerText, Mode=OneWay}" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <TextBox
                    x:Name="SubtitleBox"
                    x:Uid="SubtaskEditor_SubtitleBox"
                    AutomationProperties.AutomationId="SubtaskEditor_SubtitleBox"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.Subtitle, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <fields:FieldError Text="{x:Bind ViewModel.SubtitleError, Mode=OneWay}" />

                <ComboBox
                    x:Name="StatusCombo"
                    x:Uid="SubtaskEditor_StatusCombo"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="SubtaskEditor_StatusCombo"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.StatusOptions, Mode=OneWay}"
                    SelectionChanged="OnStatusSelectionChanged" />
                <!-- AC-32: the helper states that the parent task never changes. -->
                <TextBlock
                    x:Uid="SubtaskEditor_StatusHelper"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    TextWrapping="Wrap" />
                <fields:FieldError Text="{x:Bind ViewModel.StatusError, Mode=OneWay}" />

                <!-- Dates: an explicit Clear is tracked for B-04 ("explicit manual clear"). -->
                <StackPanel Spacing="4">
                    <controls:ClearableDateField
                        x:Uid="TaskEditor_StartDate"
                        ClearButtonAutomationId="SubtaskEditor_ClearStartDateButton"
                        ClearButtonUid="TaskEditor_ClearStartDateButton"
                        ClearCommand="{x:Bind ViewModel.ClearStartDateCommand}"
                        Date="{x:Bind ViewModel.StartDate, Mode=TwoWay}"
                        HasHelperLine="True"
                        HelperText="{x:Bind ViewModel.StartHelper, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                        PickerAutomationId="SubtaskEditor_StartDate" />
                    <controls:ClearableDateField
                        x:Name="EndDateField"
                        x:Uid="TaskEditor_EndDate"
                        ClearButtonAutomationId="SubtaskEditor_ClearEndDateButton"
                        ClearButtonUid="TaskEditor_ClearEndDateButton"
                        ClearCommand="{x:Bind ViewModel.ClearEndDateCommand}"
                        Date="{x:Bind ViewModel.EndDate, Mode=TwoWay}"
                        HasHelperLine="True"
                        HelperText="{x:Bind ViewModel.EndHelper, Mode=OneWay}"
                        IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                        PickerAutomationId="SubtaskEditor_EndDate" />
                </StackPanel>
                <fields:FieldError Text="{x:Bind ViewModel.DateError, Mode=OneWay}" />

                <TextBox
                    x:Name="NotesBox"
                    x:Uid="TaskEditor_NotesBox"
                    MinHeight="96"
                    MaxHeight="320"
                    AcceptsReturn="True"
                    AutomationProperties.AutomationId="SubtaskEditor_NotesBox"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    Text="{x:Bind ViewModel.Notes, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <fields:FieldError Text="{x:Bind ViewModel.NotesError, Mode=OneWay}" />
            </StackPanel>

            <!-- ===== Conflict review and reload confirmation (design §5.10). ===== -->
            <dialogs:ConflictReviewPanel
                ApplyCommand="{x:Bind ViewModel.ApplyConflictReviewCommand}"
                BackCommand="{x:Bind ViewModel.StepBackCommand}"
                ConfirmReloadCommand="{x:Bind ViewModel.ConfirmReloadCommand}"
                IsReloadStep="{x:Bind ViewModel.IsReloadConfirmStep, Mode=OneWay}"
                IsReviewStep="{x:Bind ViewModel.IsConflictReviewStep, Mode=OneWay}"
                ReloadMessageKey="SubtaskEditor_ReloadMessage"
                Rows="{x:Bind ViewModel.ConflictRows, Mode=OneWay}" />

            <!-- Design §5.0 saving row. -->
            <StackPanel
                Orientation="Horizontal"
                Spacing="8"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsSaving), Mode=OneWay}">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
                <TextBlock x:Uid="TaskEditor_Saving" AutomationProperties.LiveSetting="Polite" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
