<?xml version="1.0" encoding="utf-8"?>
<!--
    The page header of design §2.3: the level-1 title, an optional subtitle under it, optional actions beside them, and
    the page's own rows (search, filters, commands, filter context) below. Spacing that has nothing to separate is set
    to 0 in code (PageHeaderLayout), so a header without a subtitle, actions or rows is exactly as tall as its title.
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Common.Controls.PageHeader"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    IsTabStop="False">
    <StackPanel
        x:Name="Root"
        Padding="32,24,32,12"
        Spacing="0">
        <Grid x:Name="TitleRow" ColumnSpacing="0" SizeChanged="OnTitleRowSizeChanged">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel
                x:Name="TitleStack"
                VerticalAlignment="Center"
                Spacing="0">
                <TextBlock
                    x:Name="TitleText"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    x:Name="SubtitleText"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Visibility="Collapsed" />
            </StackPanel>
            <Border
                x:Name="ActionsHost"
                Grid.Column="1"
                Visibility="Collapsed" />
        </Grid>
        <Border x:Name="BodyHost" Visibility="Collapsed" />
    </StackPanel>
</UserControl>
