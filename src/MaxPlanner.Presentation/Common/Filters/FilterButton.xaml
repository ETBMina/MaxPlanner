<?xml version="1.0" encoding="utf-8"?>
<!--
    The Filters button and its draft flyout (design §2.6, B-10) [gallery-flyout-1, gallery-togglebutton-1,
    gallery-calendardatepicker-1, gallery-numberbox-2, gallery-radiobutton-1]. Opening builds a fresh draft; Apply
    commits it; Cancel, Esc and light dismiss discard it.
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Common.Filters.FilterButton"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Common.Filters"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="ChoiceTemplate" x:DataType="local:FilterChoiceViewModel">
            <!-- Design §2.6: a checked chip shows a CheckMark glyph as well as its fill, so state is never color alone. -->
            <ToggleButton
                Padding="10,4"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                AutomationProperties.Name="{x:Bind Label, Mode=OneTime}"
                IsChecked="{x:Bind IsChecked, Mode=TwoWay}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        Glyph="&#xE73E;"
                        Visibility="{x:Bind common:BindFunctions.Visible(IsChecked), Mode=OneWay}" />
                    <TextBlock Text="{x:Bind Label, Mode=OneTime}" />
                </StackPanel>
            </ToggleButton>
        </DataTemplate>

        <DataTemplate x:Key="ChoiceGroupTemplate" x:DataType="local:FilterChoiceGroupViewModel">
            <StackPanel Margin="0,0,0,16" Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneTime}" />
                <ItemsControl
                    IsTabStop="False"
                    ItemTemplate="{StaticResource ChoiceTemplate}"
                    ItemsSource="{x:Bind Choices, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <controls:WrapPanel Spacing="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="PickerTemplate" x:DataType="local:FilterPickerFieldViewModel">
            <StackPanel Margin="0,0,0,16" Spacing="8">
                <controls:TokenPicker
                    BoxAutomationId="{x:Bind AutomationId, Mode=OneTime}"
                    Header="{x:Bind Header, Mode=OneTime}"
                    ViewModel="{x:Bind Picker, Mode=OneTime}" />
                <RadioButtons
                    x:Uid="Filters_TagModeRadio"
                    AutomationProperties.AutomationId="Filters_TagModeRadio"
                    MaxColumns="2"
                    SelectedIndex="{x:Bind MatchModeIndex, Mode=TwoWay}"
                    Visibility="{x:Bind common:BindFunctions.Visible(ShowsMatchMode), Mode=OneTime}">
                    <RadioButton x:Uid="Filters_TagModeAny" AutomationProperties.AutomationId="Filters_TagModeAny" />
                    <RadioButton x:Uid="Filters_TagModeAll" AutomationProperties.AutomationId="Filters_TagModeAll" />
                </RadioButtons>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="TextTemplate" x:DataType="local:FilterTextFieldViewModel">
            <TextBox
                Margin="0,0,0,16"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                Header="{x:Bind Header, Mode=OneTime}"
                Text="{x:Bind Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
        </DataTemplate>

        <DataTemplate x:Key="DateTemplate" x:DataType="local:FilterDateFieldViewModel">
            <StackPanel Margin="0,0,0,16" Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneTime}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <CalendarDatePicker
                        x:Uid="Filters_FromDate"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="{x:Bind local:FilterButton.Suffix(AutomationId, 'From'), Mode=OneTime}"
                        Date="{x:Bind From, Mode=TwoWay}"
                        FirstDayOfWeek="Sunday" />
                    <CalendarDatePicker
                        x:Uid="Filters_ToDate"
                        Grid.Column="1"
                        HorizontalAlignment="Stretch"
                        AutomationProperties.AutomationId="{x:Bind local:FilterButton.Suffix(AutomationId, 'To'), Mode=OneTime}"
                        Date="{x:Bind To, Mode=TwoWay}"
                        FirstDayOfWeek="Sunday" />
                </Grid>
                <CheckBox
                    AutomationProperties.AutomationId="{x:Bind local:FilterButton.Suffix(AutomationId, 'IncludeCheck'), Mode=OneTime}"
                    Content="{x:Bind IncludeLabel, Mode=OneTime}"
                    IsChecked="{x:Bind IncludeUndated, Mode=TwoWay}" />
                <TextBlock
                    AutomationProperties.LiveSetting="Assertive"
                    Foreground="{ThemeResource ErrorTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind common:BindFunctions.Visible(HasError), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NumberTemplate" x:DataType="local:FilterNumberFieldViewModel">
            <StackPanel Margin="0,0,0,16" Spacing="8">
                <TextBlock
                    AutomationProperties.HeadingLevel="Level3"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind Header, Mode=OneTime}" />
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <NumberBox
                        x:Uid="Filters_MinNumber"
                        AutomationProperties.AutomationId="{x:Bind local:FilterButton.Suffix(AutomationId, 'Min'), Mode=OneTime}"
                        SpinButtonPlacementMode="Hidden"
                        Value="{x:Bind Min, Mode=TwoWay}" />
                    <NumberBox
                        x:Uid="Filters_MaxNumber"
                        Grid.Column="1"
                        AutomationProperties.AutomationId="{x:Bind local:FilterButton.Suffix(AutomationId, 'Max'), Mode=OneTime}"
                        SpinButtonPlacementMode="Hidden"
                        Value="{x:Bind Max, Mode=TwoWay}" />
                </Grid>
                <TextBlock
                    Foreground="{ThemeResource ErrorTextBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind Error, Mode=OneWay}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind common:BindFunctions.Visible(HasError), Mode=OneWay}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Button
        x:Name="FiltersButton"
        AutomationProperties.Name="{x:Bind Scope.FiltersButtonName, Mode=OneWay}"
        ToolTipService.ToolTip="{x:Bind Scope.FiltersButtonName, Mode=OneWay}">
        <Button.KeyboardAccelerators>
            <!-- Design §7.1: Ctrl+Shift+F opens the Filters flyout of the visible page. -->
            <KeyboardAccelerator
                Key="F"
                Invoked="OnOpenAcceleratorInvoked"
                Modifiers="Control,Shift" />
        </Button.KeyboardAccelerators>
        <Grid>
            <StackPanel
                Margin="0,0,8,0"
                Orientation="Horizontal"
                Spacing="8">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="14"
                    Glyph="&#xE71C;" />
                <TextBlock x:Uid="Filters_ButtonText" />
            </StackPanel>
            <!-- Design §2.3: the InfoBadge shows the number of fields set; the count is also in the button name. -->
            <InfoBadge
                Margin="0,-6,-10,0"
                HorizontalAlignment="Right"
                VerticalAlignment="Top"
                AutomationProperties.AccessibilityView="Raw"
                Visibility="{x:Bind common:BindFunctions.Visible(Scope.HasActiveFields), Mode=OneWay}"
                Value="{x:Bind Scope.ActiveFieldCount, Mode=OneWay}" />
        </Grid>
        <Button.Flyout>
            <Flyout
                x:Name="FiltersFlyout"
                Closed="OnFlyoutClosed"
                Opening="OnFlyoutOpening"
                Placement="BottomEdgeAlignedLeft"
                ShouldConstrainToRootBounds="True">
                <Grid
                    Width="400"
                    MaxWidth="400"
                    RowSpacing="12">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Draft.HeaderText, Mode=OneWay}"
                        TextWrapping="Wrap" />

                    <!-- The fields scroll; header and footer stay pinned (design §2.6). -->
                    <ScrollViewer
                        x:Name="FieldsScroller"
                        Grid.Row="1"
                        Padding="0,0,16,0"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ItemsControl
                                IsTabStop="False"
                                ItemTemplate="{StaticResource ChoiceGroupTemplate}"
                                ItemsSource="{x:Bind Draft.ChoiceGroups, Mode=OneWay}" />
                            <ItemsControl
                                IsTabStop="False"
                                ItemTemplate="{StaticResource PickerTemplate}"
                                ItemsSource="{x:Bind Draft.PickerFields, Mode=OneWay}" />
                            <AutoSuggestBox
                                x:Name="CrBox"
                                Margin="0,0,0,16"
                                AutomationProperties.AutomationId="Filters_CrPicker"
                                GotFocus="OnCrBoxGotFocus"
                                Header="{x:Bind Draft.CrField.Header, Mode=OneWay, FallbackValue=''}"
                                ItemsSource="{x:Bind Draft.CrField.Suggestions, Mode=OneWay, FallbackValue={x:Null}}"
                                QueryIcon="Find"
                                QuerySubmitted="OnCrQuerySubmitted"
                                SuggestionChosen="OnCrSuggestionChosen"
                                Text="{x:Bind Draft.CrField.Text, Mode=OneWay, FallbackValue=''}"
                                TextChanged="OnCrTextChanged"
                                Visibility="{x:Bind common:BindFunctions.Visible(Draft.HasCrField), Mode=OneWay}" />
                            <ItemsControl
                                IsTabStop="False"
                                ItemTemplate="{StaticResource TextTemplate}"
                                ItemsSource="{x:Bind Draft.TextFields, Mode=OneWay}" />
                            <ItemsControl
                                IsTabStop="False"
                                ItemTemplate="{StaticResource DateTemplate}"
                                ItemsSource="{x:Bind Draft.DateFields, Mode=OneWay}" />
                            <ItemsControl
                                IsTabStop="False"
                                ItemTemplate="{StaticResource NumberTemplate}"
                                ItemsSource="{x:Bind Draft.NumberFields, Mode=OneWay}" />
                        </StackPanel>
                    </ScrollViewer>

                    <Grid
                        Grid.Row="2"
                        ColumnSpacing="8"
                        RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Uid="Filters_Hint"
                            Grid.ColumnSpan="4"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="ClearButton"
                            x:Uid="Filters_ClearButton"
                            Grid.Row="1"
                            Command="{x:Bind Draft.ClearCommand, Mode=OneWay}" />
                        <Button
                            x:Name="CancelButton"
                            x:Uid="Filters_CancelButton"
                            Grid.Row="1"
                            Grid.Column="2"
                            Click="OnCancelClick" />
                        <Button
                            x:Name="ApplyButton"
                            x:Uid="Filters_ApplyButton"
                            Grid.Row="1"
                            Grid.Column="3"
                            Click="OnApplyClick"
                            IsEnabled="{x:Bind Draft.CanApply, Mode=OneWay}"
                            Style="{StaticResource AccentButtonStyle}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="Enter" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                    </Grid>
                </Grid>
            </Flyout>
        </Button.Flyout>
    </Button>
</UserControl>
