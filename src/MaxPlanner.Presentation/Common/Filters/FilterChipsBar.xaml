<?xml version="1.0" encoding="utf-8"?>
<!--
    Header row 3 of design §2.3: the Dashboard-results InfoBar (§2.9), the invalid-saved-filter InfoBar (§2.6), and
    the active-filter chips with an immediate Clear all filters (B-10).
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Common.Filters.FilterChipsBar"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Common.Filters"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="ChipTemplate" x:DataType="local:FilterChipViewModel">
            <Button
                Padding="10,3"
                AutomationProperties.Name="{x:Bind RemoveName, Mode=OneTime}"
                Click="OnChipClick"
                CornerRadius="12"
                Loaded="OnChipLoaded"
                ToolTipService.ToolTip="{x:Bind RemoveName, Mode=OneTime}">
                <StackPanel Orientation="Horizontal" Spacing="6">
                    <!-- The Dashboard chip carries the Dashboard glyph so it reads as a different kind of chip. -->
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        Glyph="&#xF246;"
                        Visibility="{x:Bind common:BindFunctions.Visible(IsDashboard), Mode=OneTime}" />
                    <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind Label, Mode=OneTime}" />
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="10"
                        Glyph="&#xE711;" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel Spacing="8">
        <InfoBar
            x:Name="DashboardBar"
            IsClosable="False"
            IsOpen="{x:Bind Scope.IsFromDashboard, Mode=OneWay}"
            Message="{x:Bind Scope.DashboardMessage, Mode=OneWay}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    x:Name="ReturnButton"
                    x:Uid="Filters_ReturnToDashboardButton"
                    Command="{x:Bind Scope.ReturnToDashboardCommand, Mode=OneWay}" />
            </InfoBar.ActionButton>
        </InfoBar>
        <InfoBar
            x:Name="InvalidBar"
            IsOpen="{x:Bind Scope.IsInvalidNoticeOpen, Mode=TwoWay}"
            Message="{x:Bind Scope.InvalidNoticeMessage, Mode=OneWay}"
            Severity="Warning" />
        <Grid ColumnSpacing="8" Visibility="{x:Bind common:BindFunctions.Visible(Scope.HasChips), Mode=OneWay}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ItemsControl
                IsTabStop="False"
                ItemTemplate="{StaticResource ChipTemplate}"
                ItemsSource="{x:Bind Scope.Chips, Mode=OneWay}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <controls:WrapPanel Spacing="6" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
            </ItemsControl>
            <HyperlinkButton
                x:Name="ClearAllLink"
                x:Uid="Filters_ClearAllLink"
                Grid.Column="1"
                VerticalAlignment="Top"
                Command="{x:Bind Scope.ClearAllCommand, Mode=OneWay}">
                <HyperlinkButton.KeyboardAccelerators>
                    <!-- Design §7.1: Ctrl+Shift+L clears all filters of the visible page. -->
                    <KeyboardAccelerator Key="L" Modifiers="Control,Shift" />
                </HyperlinkButton.KeyboardAccelerators>
            </HyperlinkButton>
        </Grid>
    </StackPanel>
</UserControl>
