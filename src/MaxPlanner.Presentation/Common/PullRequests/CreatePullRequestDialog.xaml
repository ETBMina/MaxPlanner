<?xml version="1.0" encoding="utf-8"?>
<!--
    Create pull request (B-18, ADR 0031, design §5.11) on the native ContentDialog with EditorDialogShell, about 480 epx
    wide and single column. Fields lock while a request runs; the result InfoBar sits at the top and takes focus. The
    #id link is built in code-behind as an inline Hyperlink, so long messages wrap around it.
-->
<ContentDialog
    x:Class="MaxPlanner.Presentation.Common.PullRequests.CreatePullRequestDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:dialogs="using:MaxPlanner.Presentation.Common.Dialogs"
    xmlns:fields="using:MaxPlanner.Presentation.Common.Fields"
    xmlns:local="using:MaxPlanner.Presentation.Common.PullRequests"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneTime}"
    AutomationProperties.AutomationId="PullRequest_Dialog"
    AutomationProperties.Name="{x:Bind ViewModel.AccessibleName, Mode=OneTime}"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneWay}"
    DefaultButton="Primary"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.IsPrimaryEnabled, Mode=OneWay}"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel x:Name="Root" Padding="0,0,12,0" Spacing="12">
            <!-- EditorDialogShell adds the Ctrl+Enter accelerator here (design §7.2). -->
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ViewModel.Caption, Mode=OneTime}"
                TextWrapping="Wrap" />

            <!-- Design §5.11 Results: severity, message (with the #id link), and the one action that fits. -->
            <InfoBar
                x:Name="ResultBar"
                AutomationProperties.AutomationId="PullRequest_ResultInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasResult, Mode=OneWay}"
                Severity="{x:Bind local:CreatePullRequestDialog.ToSeverity(ViewModel.ResultSeverity), Mode=OneWay}"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasResult), Mode=OneWay}">
                <!-- Title and Message stay empty, so the content is the bar's only row: 14 above and below centres the
                     first text line on the 16px icon (icon margin 16, line height 20) and balances the padding. -->
                <InfoBar.Content>
                    <StackPanel Margin="0,14,0,14" Spacing="8">
                        <TextBlock
                            x:Name="ResultText"
                            AutomationProperties.LiveSetting="Polite"
                            IsTextSelectionEnabled="False"
                            Style="{StaticResource BodyTextBlockStyle}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasResultActions), Mode=OneWay}">
                            <Button
                                x:Name="OpenExistingButton"
                                x:Uid="PullRequest_OpenExistingButton"
                                AutomationProperties.AutomationId="PullRequest_OpenExistingButton"
                                Command="{x:Bind ViewModel.OpenExistingCommand}"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.ShowsOpenExisting), Mode=OneWay}" />
                            <Button
                                x:Name="OpenSettingsButton"
                                x:Uid="PullRequest_OpenSettingsButton"
                                AutomationProperties.AutomationId="PullRequest_OpenSettingsButton"
                                Command="{x:Bind ViewModel.OpenSettingsCommand}"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.ShowsOpenSettings), Mode=OneWay}" />
                            <Button
                                x:Name="TryAgainButton"
                                x:Uid="PullRequest_TryAgainButton"
                                AutomationProperties.AutomationId="PullRequest_TryAgainButton"
                                Command="{x:Bind ViewModel.TryAgainCommand}"
                                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.ShowsTryAgain), Mode=OneWay}" />
                        </StackPanel>
                    </StackPanel>
                </InfoBar.Content>
            </InfoBar>

            <!-- An unexpected failure (ADR 0029); the values stay for another try. -->
            <dialogs:EditorMessageBars AutomationPrefix="PullRequest" SaveError="{x:Bind ViewModel.SaveError, Mode=OneWay}" />

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="SourceBox"
                    x:Uid="PullRequest_SourceBranchBox"
                    AutomationProperties.AutomationId="PullRequest_SourceBranchBox"
                    AutomationProperties.FullDescription="{x:Bind ViewModel.SourceError, Mode=OneWay}"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    IsSpellCheckEnabled="False"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.SourceBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <TextBlock
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Style="{StaticResource CaptionTextBlockStyle}"
                    Text="{x:Bind ViewModel.HelperText, Mode=OneTime}"
                    TextWrapping="Wrap"
                    Visibility="{x:Bind ViewModel.HasNoTaskNumber, Mode=OneTime}" />
                <fields:FieldError Text="{x:Bind ViewModel.SourceError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="TargetBox"
                    x:Uid="PullRequest_TargetBranchBox"
                    AutomationProperties.AutomationId="PullRequest_TargetBranchBox"
                    AutomationProperties.FullDescription="{x:Bind ViewModel.TargetError, Mode=OneWay}"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    IsSpellCheckEnabled="False"
                    MaxLength="250"
                    Text="{x:Bind ViewModel.TargetBranch, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <fields:FieldError Text="{x:Bind ViewModel.TargetError, Mode=OneWay}" />
            </StackPanel>

            <StackPanel Spacing="4">
                <TextBox
                    x:Name="TitleBox"
                    x:Uid="PullRequest_TitleBox"
                    AutomationProperties.AutomationId="PullRequest_TitleBox"
                    AutomationProperties.FullDescription="{x:Bind ViewModel.TitleError, Mode=OneWay}"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}"
                    MaxLength="400"
                    Text="{x:Bind ViewModel.Title, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    TextWrapping="Wrap" />
                <fields:FieldError Text="{x:Bind ViewModel.TitleError, Mode=OneWay}" />
            </StackPanel>

            <CheckBox
                x:Uid="PullRequest_AutoCompleteCheckBox"
                AutomationProperties.AutomationId="PullRequest_AutoCompleteCheckBox"
                IsChecked="{x:Bind ViewModel.IsAutoComplete, Mode=TwoWay}"
                IsEnabled="{x:Bind ViewModel.CanEditFields, Mode=OneWay}" />

            <!-- Design §5.11 Progress: a ring on the active line, a check on finished lines (glyphs as well as color). -->
            <ItemsControl
                AutomationProperties.AutomationId="PullRequest_ProgressList"
                IsTabStop="False"
                ItemsSource="{x:Bind ViewModel.Steps, Mode=OneTime}"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsRunning), Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="local:PullRequestStepViewModel">
                        <Grid Margin="0,2" ColumnSpacing="8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ProgressRing
                                Width="16"
                                Height="16"
                                IsActive="{x:Bind IsActive, Mode=OneWay}"
                                Visibility="{x:Bind IsActive, Mode=OneWay}" />
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="14"
                                Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                                Glyph="&#xE73E;"
                                Visibility="{x:Bind IsDone, Mode=OneWay}" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{x:Bind Text, Mode=OneTime}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
