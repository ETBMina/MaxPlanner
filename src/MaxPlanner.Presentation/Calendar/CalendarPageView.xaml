<?xml version="1.0" encoding="utf-8"?>
<!--
    Calendar page (design §4.4, B-08): SelectorBar Month · Week · Records [gallery-selectorbar-1], period
    navigation with a CalendarView flyout [gallery-calendarview-1], the Backlog SplitView [gallery-splitview-1],
    the custom CalendarMonthView surface, the S agenda list, and the Records table (ListView + header Grid).
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Calendar.CalendarPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:filters="using:MaxPlanner.Presentation.Common.Filters"
    xmlns:board="using:MaxPlanner.Presentation.Board"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Calendar"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- Backlog CR card (design §4.4): number link, priority chip, title, owner, "Squad · n tasks", ⋯ menu. -->
        <DataTemplate x:Key="BacklogCardTemplate" x:DataType="local:CalendarRecordViewModel">
            <Border
                Margin="0,4"
                Padding="12,8"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_BacklogCard_', Id), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}"
                Tag="{x:Bind Mode=OneTime}">
                <Grid ColumnSpacing="8" RowSpacing="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_BacklogNumberLink_', Id), Mode=OneTime}"
                            Click="OnBacklogOpenClick"
                            Content="{x:Bind Number, Mode=OneWay}"
                            Tag="{x:Bind Mode=OneTime}" />
                        <Border AutomationProperties.Name="{x:Bind PriorityAccessibleName, Mode=OneWay}" Style="{x:Bind board:BoardPageView.PriorityChipStyle(PriorityLevel), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="{x:Bind board:BoardPageView.PriorityGlyph(PriorityLevel), Mode=OneWay}" Style="{StaticResource ChipGlyphStyle}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind PriorityName, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                    <Button
                        Grid.Column="1"
                        Padding="6,4"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_BacklogMenuButton_', Id), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind MenuName, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnBacklogMenuClick"
                        Tag="{x:Bind Mode=OneTime}"
                        ToolTipService.ToolTip="{x:Bind MenuName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                    </Button>
                    <TextBlock
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind OwnerName, Mode=OneWay}" />
                    <StackPanel
                        Grid.Row="3"
                        Grid.ColumnSpan="2"
                        Orientation="Horizontal"
                        Spacing="4">
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind SquadName, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="·" />
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_BacklogLinkedTasksLink_', Id), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind OpenLinkedTasksName, Mode=OneWay}"
                            Click="OnBacklogLinkedTasksClick"
                            FontSize="12"
                            Tag="{x:Bind Mode=OneTime}">
                            <TextBlock Text="{x:Bind LinkedTasksLinkText, Mode=OneWay}" />
                        </HyperlinkButton>
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!-- Records row at L/M (design §4.4): every column; the table scrolls horizontally when narrower. -->
        <DataTemplate x:Key="RecordRowTemplate" x:DataType="local:CalendarRecordViewModel">
            <Grid
                MinHeight="40"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_RecordRow_', Id), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="8"
                Tag="{x:Bind Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="240" />
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="130" />
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="110" />
                    <ColumnDefinition Width="80" />
                    <ColumnDefinition Width="150" />
                    <ColumnDefinition Width="44" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Number, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{x:Bind Title, Mode=OneWay}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                <TextBlock Grid.Column="2" VerticalAlignment="Center" Text="{x:Bind OwnerName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Text="{x:Bind SquadName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="4" VerticalAlignment="Center" Text="{x:Bind StatusName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="5" VerticalAlignment="Center" Text="{x:Bind PriorityName, Mode=OneWay}" TextTrimming="CharacterEllipsis" />
                <TextBlock Grid.Column="6" VerticalAlignment="Center" Text="{x:Bind PlannedStartText, Mode=OneWay}" />
                <TextBlock Grid.Column="7" VerticalAlignment="Center" Text="{x:Bind PlannedEndText, Mode=OneWay}" />
                <TextBlock Grid.Column="8" VerticalAlignment="Center" Text="{x:Bind LinkedTasksText, Mode=OneWay}" />
                <StackPanel
                    Grid.Column="9"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="4"
                    Visibility="{x:Bind common:BindFunctions.Visible(IsOverdue), Mode=OneWay}">
                    <FontIcon
                        AutomationProperties.AccessibilityView="Raw"
                        FontSize="12"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="&#xE7BA;" />
                    <TextBlock Text="{x:Bind OverdueText, Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="10"
                    Padding="6,4"
                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_RecordMenuButton_', Id), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind MenuName, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRecordMenuClick"
                    Tag="{x:Bind Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind MenuName, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- Records row at S (design §4.4): number + title / owner · status · end · overdue. -->
        <DataTemplate x:Key="CompactRecordTemplate" x:DataType="local:CalendarRecordViewModel">
            <Grid
                Padding="0,6"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_RecordRow_', Id), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" TextWrapping="Wrap">
                        <Run Text="{x:Bind Number, Mode=OneWay}" />
                        <Run Text="{x:Bind Title, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind CompactLine, Mode=OneWay}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="6,4"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Calendar_RecordMenuButton_', Id), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind MenuName, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRecordMenuClick"
                    Tag="{x:Bind Mode=OneTime}"
                    ToolTipService.ToolTip="{x:Bind MenuName, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                </Button>
            </Grid>
        </DataTemplate>

        <!-- S agenda (design §4.4): a date header per visible workday, then its CRs with their range. -->
        <DataTemplate x:Key="AgendaRowTemplate" x:DataType="local:CalendarAgendaRow">
            <Grid AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}">
                <TextBlock
                    Margin="0,12,0,4"
                    AutomationProperties.HeadingLevel="Level2"
                    Style="{StaticResource BodyStrongTextBlockStyle}"
                    Text="{x:Bind HeaderText, Mode=OneTime}"
                    Visibility="{x:Bind common:BindFunctions.Visible(IsHeader), Mode=OneTime}" />
                <StackPanel
                    Padding="0,4"
                    AutomationProperties.Name="{x:Bind Record.AccessibleName, Mode=OneTime}"
                    Spacing="2"
                    Visibility="{x:Bind common:BindFunctions.Visible(IsRecord), Mode=OneTime}">
                    <TextBlock TextWrapping="Wrap">
                        <Run FontWeight="SemiBold" Text="{x:Bind Record.Number, Mode=OneTime}" />
                        <Run Text="{x:Bind Record.Title, Mode=OneTime}" />
                    </TextBlock>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Record.RangeText, Mode=OneTime}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Record.CompactLine, Mode=OneTime}"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3): title, modes and period, search and the CR Filters flyout (B-10), filter context. -->
        <StackPanel
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            Spacing="8">
            <TextBlock
                x:Name="PageTitle"
                x:Uid="Calendar_PageTitle"
                AutomationProperties.AutomationId="Calendar_PageTitle"
                AutomationProperties.HeadingLevel="Level1"
                Style="{StaticResource PageTitleTextStyle}" />
            <!--
                Design §2.3 / §4.4: mode selector then the search icon on the left; period navigation, Filters and the accent
                New CR on the right. The search column is the star column, so the icon expands into the free space after it.
                Below the L breakpoint the right group moves to its own row (ApplyBreakpoint) and wraps.
            -->
            <Grid x:Name="CommandRow" ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <SelectorBar
                    x:Name="ModeBar"
                    AutomationProperties.AutomationId="Calendar_ModeBar"
                    SelectionChanged="OnModeChanged">
                    <SelectorBarItem
                        x:Name="MonthItem"
                        x:Uid="Calendar_ModeMonthItem"
                        AutomationProperties.AutomationId="Calendar_ModeMonthItem"
                        Tag="Month" />
                    <SelectorBarItem
                        x:Name="WeekItem"
                        x:Uid="Calendar_ModeWeekItem"
                        AutomationProperties.AutomationId="Calendar_ModeWeekItem"
                        Tag="Week" />
                    <SelectorBarItem
                        x:Name="RecordsItem"
                        x:Uid="Calendar_ModeRecordsItem"
                        AutomationProperties.AutomationId="Calendar_ModeRecordsItem"
                        Tag="Records" />
                </SelectorBar>
                <controls:ExpandingSearchBox
                    x:Name="SearchBox"
                    x:Uid="Calendar_Search"
                    Grid.Column="1"
                    AutomationIdPrefix="Calendar"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                <!--
                    A Grid with content-sized columns, not a wrapping panel: a wrapping panel in this Auto column wrapped New CR
                    onto a second line in Records and the row did not grow. ApplyBreakpoint re-places the children at S.
                -->
                <Grid
                    x:Name="CommandGroup"
                    Grid.Column="2"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    ColumnSpacing="8"
                    RowSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <!-- Period navigation (Month/Week only): Today, the joined ‹ › pair, then the period button with the date selector. -->
                    <StackPanel
                        x:Name="PeriodPanel"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Right"
                        Orientation="Horizontal"
                        Spacing="8"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsSurfaceMode), Mode=OneWay}">
                        <Button
                            x:Uid="Calendar_TodayButton"
                            AutomationProperties.AutomationId="Calendar_TodayButton"
                            Command="{x:Bind ViewModel.GoToTodayCommand}">
                            <Button.KeyboardAccelerators>
                                <KeyboardAccelerator Key="T" Modifiers="Control" />
                            </Button.KeyboardAccelerators>
                        </Button>
                        <!--
                            The arrows are one pill the height of the neighbouring buttons: a 32-epx border around two 30-epx
                            subtle buttons and a hairline divider. Each button rounds only its outer corners.
                        -->
                        <Border
                            Background="{ThemeResource ControlFillColorDefaultBrush}"
                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                            BorderThickness="1"
                            CornerRadius="{ThemeResource ControlCornerRadius}">
                            <StackPanel Orientation="Horizontal">
                                <Button
                                    Width="30"
                                    Height="30"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    AutomationProperties.AutomationId="Calendar_PrevButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.PreviousName, Mode=OneWay}"
                                    CornerRadius="3,0,0,3"
                                    Command="{x:Bind ViewModel.PreviousCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.PreviousName, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                                </Button>
                                <Rectangle
                                    Width="1"
                                    Fill="{ThemeResource ControlStrokeColorDefaultBrush}" />
                                <Button
                                    Width="30"
                                    Height="30"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    AutomationProperties.AutomationId="Calendar_NextButton"
                                    AutomationProperties.Name="{x:Bind ViewModel.NextName, Mode=OneWay}"
                                    CornerRadius="0,3,3,0"
                                    Command="{x:Bind ViewModel.NextCommand}"
                                    Style="{StaticResource SubtleButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind ViewModel.NextName, Mode=OneWay}">
                                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                                </Button>
                            </StackPanel>
                        </Border>
                        <Button
                            x:Name="PeriodButton"
                            AutomationProperties.AutomationId="Calendar_PeriodButton"
                            AutomationProperties.HelpText="{x:Bind ViewModel.Text('Calendar_PeriodHelp'), Mode=OneTime}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <!-- MinWidth is set from the widest period text of the mode (ApplyPeriodWidth), so navigating never resizes the button. -->
                                <TextBlock
                                    x:Name="PeriodLabel"
                                    Text="{x:Bind ViewModel.PeriodText, Mode=OneWay}"
                                    TextAlignment="Center" />
                                <FontIcon
                                    AutomationProperties.AccessibilityView="Raw"
                                    FontSize="10"
                                    Glyph="&#xE70D;" />
                            </StackPanel>
                            <Button.Flyout>
                                <Flyout x:Name="PeriodFlyout" Opening="OnPeriodFlyoutOpening">
                                    <CalendarView
                                        x:Name="PeriodCalendar"
                                        AutomationProperties.AutomationId="Calendar_PeriodCalendar"
                                        FirstDayOfWeek="Sunday"
                                        SelectedDatesChanged="OnPeriodDateSelected"
                                        SelectionMode="Single" />
                                </Flyout>
                            </Button.Flyout>
                        </Button>
                    </StackPanel>
                    <filters:FilterButton
                        x:Name="CommandFilterButton"
                        Grid.Column="1"
                        PageKey="Calendar"
                        Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
                    <Button
                        x:Name="NewCrButton"
                        x:Uid="Calendar_NewCrButton"
                        Grid.Column="2"
                        AutomationProperties.AutomationId="Calendar_NewCrButton"
                        Command="{x:Bind ViewModel.NewChangeRequestCommand}"
                        Style="{StaticResource AccentButtonStyle}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock x:Uid="Calendar_NewCrText" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Grid>
            <!--
                The context rows take no height or stack spacing while they have nothing to show: a closed InfoBar or an
                empty chips bar would otherwise still add its 8-epx spacing to the header.
            -->
            <filters:FilterChipsBar
                x:Name="ChipsBar"
                PageKey="Calendar"
                Scope="{x:Bind ViewModel.Filters, Mode=OneTime}"
                Visibility="{x:Bind common:BindFunctions.VisibleAny(ViewModel.Filters.HasChips, ViewModel.Filters.IsFromDashboard, ViewModel.Filters.IsInvalidNoticeOpen), Mode=OneWay}" />
            <!-- B-08.12: a saved CR hidden by the current filters stays discoverable. -->
            <InfoBar
                AutomationProperties.AutomationId="Calendar_SavedHiddenInfoBar"
                IsOpen="{x:Bind ViewModel.IsSavedHiddenOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.SavedHiddenMessage, Mode=OneWay}"
                Severity="Informational"
                Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsSavedHiddenOpen), Mode=OneWay}">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="Calendar_SavedHiddenClearButton"
                        AutomationProperties.AutomationId="Calendar_SavedHiddenClearButton"
                        Command="{x:Bind ViewModel.ClearFiltersForSavedCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <!-- B-10: no matches is distinct from an empty dataset; the surface still renders (design §4.4 states). -->
        <InfoBar
            Grid.Row="1"
            Margin="32,0,32,8"
            AutomationProperties.AutomationId="Calendar_NoMatchesInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoMatchesText, Mode=OneTime}"
            Severity="Informational"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasNoMatches), Mode=OneWay}">
            <InfoBar.ActionButton>
                <Button
                    x:Uid="Calendar_ClearSearchButton"
                    AutomationProperties.AutomationId="Calendar_ClearSearchButton"
                    Click="OnClearSearchClick" />
            </InfoBar.ActionButton>
        </InfoBar>

        <controls:StateView
            x:Name="PageContent"
            x:Uid="Calendar_StateView"
            Grid.Row="2"
            EmptyActionCommand="{x:Bind ViewModel.NewChangeRequestCommand}"
            EmptyGlyph="&#xE787;"
            PageKey="Calendar"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <SplitView
                x:Name="Split"
                CompactPaneLength="68"
                DisplayMode="CompactInline"
                IsPaneOpen="{x:Bind ViewModel.IsBacklogOpen, Mode=TwoWay}"
                OpenPaneLength="312"
                PaneBackground="Transparent"
                PanePlacement="Left">
                <!--
                    Closed, the pane is the compact strip: a rail button (the Backlog toggle) on the grid edge. Open, it is a
                    nested card inset by the page gutter (design §3); the pane length is the 280-epx card plus that gutter,
                    and ApplyBreakpoint keeps the rail, the card and the content padding in step.
                -->
                <SplitView.Pane>
                    <Grid>
                    <Button
                        x:Name="BacklogRail"
                        Width="36"
                        Margin="32,0,0,16"
                        Padding="0"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Stretch"
                        VerticalContentAlignment="Top"
                        AutomationProperties.AutomationId="Calendar_BacklogToggle"
                        AutomationProperties.Name="{x:Bind ViewModel.BacklogToggleText, Mode=OneWay}"
                        Command="{x:Bind ViewModel.ToggleBacklogCommand}"
                        ToolTipService.ToolTip="{x:Bind ViewModel.BacklogToggleText, Mode=OneWay}"
                        Visibility="{x:Bind common:BindFunctions.Collapsed(ViewModel.IsBacklogOpen), Mode=OneWay}">
                        <StackPanel
                            Margin="0,19,0,0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Top"
                            Spacing="12">
                            <FontIcon
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="12"
                                Glyph="&#xE76C;" />
                            <!--
                                Layout ignores a rotation: the TextBlock keeps its horizontal 104 x 20 box and turns a quarter
                                around its centre inside a 20 x 104 slot, so the text reads top to bottom. A Canvas does not
                                clip the wider box to the slot, which a Grid cell would.
                            -->
                            <Canvas Width="20" Height="104">
                                <TextBlock
                                    Canvas.Left="-42"
                                    Canvas.Top="42"
                                    Width="104"
                                    Height="20"
                                    AutomationProperties.AccessibilityView="Raw"
                                    TextAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5"
                                    Text="{x:Bind ViewModel.BacklogToggleText, Mode=OneWay}"
                                    TextWrapping="NoWrap">
                                    <TextBlock.RenderTransform>
                                        <RotateTransform Angle="90" />
                                    </TextBlock.RenderTransform>
                                </TextBlock>
                            </Canvas>
                        </StackPanel>
                    </Button>
                    <!--
                        Below L the open pane floats over the calendar. BacklogOpaqueBase then repaints the layers that
                        sit behind the pane at L: the window's Mica (a native MicaBackdrop hosted by BacklogMica, so it
                        samples the same wallpaper and follows the same fallback rules as the window), over the solid
                        base that stands in when Mica is unsupported, and the NavigationView content layer on top. The
                        unchanged card then looks the same at every width without the calendar showing through. It is
                        collapsed at L; see ApplyBreakpoint.
                    -->
                    <Grid
                        x:Name="BacklogCardHost"
                        Margin="32,0,0,16"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsBacklogOpen), Mode=OneWay}">
                    <Grid x:Name="BacklogOpaqueBase" Visibility="Collapsed">
                        <Border Background="{ThemeResource SolidBackgroundFillColorBaseBrush}" CornerRadius="8" />
                        <SystemBackdropElement x:Name="BacklogMica" CornerRadius="8" />
                        <Border Background="{ThemeResource LayerFillColorDefaultBrush}" CornerRadius="8" />
                    </Grid>
                    <Border Style="{StaticResource SecondaryCardBorderStyle}">
                        <Grid Padding="12" RowSpacing="8">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <!--
                                The collapse arrow is the first item of the heading, level with the rail's expand arrow, so
                                one pointer position toggles the pane both ways. The negative margin centres it over the
                                rail glyph (the card padding is 12 epx; the rail glyph sits 18 epx from the pane edge).
                            -->
                            <Grid Margin="-8,0,0,0" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Uid="Calendar_BacklogCollapseButton"
                                    Width="28"
                                    Height="28"
                                    MinWidth="0"
                                    MinHeight="0"
                                    Padding="0"
                                    AutomationProperties.AutomationId="Calendar_BacklogCollapseButton"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Command="{x:Bind ViewModel.ToggleBacklogCommand}">
                                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                                </Button>
                                <TextBlock
                                    x:Uid="Calendar_BacklogHeading"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    AutomationProperties.HeadingLevel="Level2"
                                    Style="{StaticResource SubtitleTextBlockStyle}" />
                                <Border
                                    Grid.Column="2"
                                    Padding="8,2"
                                    VerticalAlignment="Center"
                                    AutomationProperties.AutomationId="Calendar_BacklogCount"
                                    AutomationProperties.Name="{x:Bind ViewModel.BacklogCountName, Mode=OneWay}"
                                    Background="{ThemeResource AccentFillColorDefaultBrush}"
                                    CornerRadius="{ThemeResource ControlCornerRadius}">
                                    <TextBlock
                                        AutomationProperties.AccessibilityView="Raw"
                                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                        Style="{StaticResource BodyStrongTextBlockStyle}"
                                        Text="{x:Bind ViewModel.BacklogCountText, Mode=OneWay}" />
                                </Border>
                            </Grid>
                            <TextBlock
                                x:Uid="Calendar_BacklogHint"
                                Grid.Row="1"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                            <ListView
                                x:Name="BacklogList"
                                x:Uid="Calendar_BacklogList"
                                Grid.Row="2"
                                AutomationProperties.AutomationId="Calendar_BacklogList"
                                CanDragItems="True"
                                DragItemsCompleted="OnBacklogDragCompleted"
                                DragItemsStarting="OnBacklogDragStarting"
                                IsItemClickEnabled="True"
                                ItemClick="OnBacklogItemClick"
                                ItemTemplate="{StaticResource BacklogCardTemplate}"
                                ItemsSource="{x:Bind ViewModel.Backlog, Mode=OneTime}"
                                KeyDown="OnBacklogKeyDown"
                                SelectionMode="Single">
                                <ListView.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource DefaultListViewItemStyle}" TargetType="ListViewItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    </Style>
                                </ListView.ItemContainerStyle>
                            </ListView>
                        </Grid>
                    </Border>
                    </Grid>
                    </Grid>
                </SplitView.Pane>

                <Grid x:Name="ContentRoot" Padding="32,0,32,16">
                    <!-- Month/Week surface (L/M). The surface is not virtualized: at most six week rows. -->
                    <ScrollViewer
                        x:Name="SurfaceScroller"
                        AutomationProperties.AutomationId="Calendar_SurfaceScroller"
                        VerticalScrollBarVisibility="Auto">
                        <local:CalendarMonthView x:Name="MonthView" />
                    </ScrollViewer>

                    <!-- S agenda presentation of Month/Week (design §4.4). -->
                    <ListView
                        x:Name="AgendaList"
                        x:Uid="Calendar_AgendaList"
                        AutomationProperties.AutomationId="Calendar_AgendaList"
                        IsItemClickEnabled="True"
                        ItemClick="OnAgendaItemClick"
                        ItemTemplate="{StaticResource AgendaRowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Agenda, Mode=OneTime}"
                        SelectionMode="None"
                        Visibility="Collapsed" />

                    <!-- Records (B-08.4): every status and every unscheduled CR; header buttons sort. -->
                    <ScrollViewer
                        x:Name="RecordsScroller"
                        common:WheelScrolling.RoutesMouseWheel="True"
                        common:WheelScrolling.VerticalWheelTarget="{x:Bind RecordsList, Mode=OneTime}"
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Enabled"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled"
                        Visibility="Collapsed">
                        <Grid Width="1420" RowSpacing="4">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid
                                x:Name="RecordsHeader"
                                Padding="12,0,12,0"
                                AutomationProperties.AutomationId="Calendar_RecordsHeader"
                                ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="240" />
                                    <ColumnDefinition Width="140" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="130" />
                                    <ColumnDefinition Width="100" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="150" />
                                    <ColumnDefinition Width="44" />
                                </Grid.ColumnDefinitions>
                            </Grid>
                            <ListView
                                x:Name="RecordsList"
                                x:Uid="Calendar_RecordsList"
                                Grid.Row="1"
                                common:WheelScrolling.RoutesMouseWheel="True"
                                AutomationProperties.AutomationId="Calendar_RecordsList"
                                IsItemClickEnabled="True"
                                ItemClick="OnRecordItemClick"
                                ItemTemplate="{StaticResource RecordRowTemplate}"
                                ItemsSource="{x:Bind ViewModel.Records, Mode=OneTime}"
                                SelectionMode="None" />
                        </Grid>
                    </ScrollViewer>
                    <ListView
                        x:Name="CompactRecordsList"
                        x:Uid="Calendar_RecordsList"
                        AutomationProperties.AutomationId="Calendar_RecordsList"
                        IsItemClickEnabled="True"
                        ItemClick="OnRecordItemClick"
                        ItemTemplate="{StaticResource CompactRecordTemplate}"
                        ItemsSource="{x:Bind ViewModel.Records, Mode=OneTime}"
                        SelectionMode="None"
                        Visibility="Collapsed" />
                </Grid>
            </SplitView>
        </controls:StateView>
    </Grid>
</UserControl>
