            <StaticResource x:Key="ChipSecondaryForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ServiceChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="SquadChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <!-- Accent chips (Board count and service) use the system selection pair, like other accent fills in HC. -->
            <StaticResource x:Key="AccentChipBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="AccentChipForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="AccentChipStrokeBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="PriorityLevel1ChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLevel2ChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityMidChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLowestChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLevel1GlyphBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="PriorityLevel2GlyphBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="SubtaskCardAccentBrush" ResourceKey="SystemColorWindowTextColorBrush" />
