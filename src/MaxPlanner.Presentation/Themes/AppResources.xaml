            <SolidColorBrush x:Key="CalendarBarStripe9" Color="#FFB83A3A" />
            <!-- Tag pills (design §6.1): the hue at about 14 % alpha under a darker shade of it. Text stays at 6:1 or more on page and card surfaces, and above 4.5:1 under the hover and pressed overlays. Same hue order as the bar palette. -->
            <SolidColorBrush x:Key="TagPillFill0" Color="#242F6FB5" />
            <SolidColorBrush x:Key="TagPillForeground0" Color="#FF214D7E" />
            <SolidColorBrush x:Key="TagPillFill1" Color="#241A8577" />
