            <SolidColorBrush x:Key="TagPillForeground4" Color="#FF7F2A58" />
            <SolidColorBrush x:Key="TagPillFill5" Color="#244C8A2E" />
            <SolidColorBrush x:Key="TagPillForeground5" Color="#FF2E541C" />
            <SolidColorBrush x:Key="TagPillFill6" Color="#244B53B0" />
            <SolidColorBrush x:Key="TagPillForeground6" Color="#FF3D438F" />
            <SolidColorBrush x:Key="TagPillFill7" Color="#248A6236" />
            <SolidColorBrush x:Key="TagPillForeground7" Color="#FF634627" />
            <SolidColorBrush x:Key="TagPillFill8" Color="#241C7FA3" />
            <SolidColorBrush x:Key="TagPillForeground8" Color="#FF125168" />
            <SolidColorBrush x:Key="TagPillFill9" Color="#24B83A3A" />
            <SolidColorBrush x:Key="TagPillForeground9" Color="#FF842A2A" />
            <SolidColorBrush x:Key="TagPillStrokeBrush" Color="Transparent" />
            <SolidColorBrush x:Key="TagPillHoverStrokeBrush" Color="Transparent" />
            <x:Double x:Key="TagPillHoverOverlayOpacity">0.07</x:Double>
            <x:Double x:Key="TagPillPressedOverlayOpacity">0.12</x:Double>
            <StaticResource x:Key="CalendarAdjacentDayForegroundBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="CalendarTodayBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="CalendarTodayForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="CalendarDropTargetStrokeBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="BoardInsertionLineBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="FlagChipBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ArchivedChipBackgroundBrush" ResourceKey="SystemFillColorNeutralBackgroundBrush" />
