<?xml version="1.0" encoding="utf-8"?>
<!--
    App-wide theme resources (design §3 rule 2, §6.1). Light and Dark redirect to platform brushes;
    HighContrast uses only SystemColor*Brush without opacity. Merged by the Desktop App.xaml.
-->
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ResourceDictionary.ThemeDictionaries>
        <ResourceDictionary x:Key="Light">
            <StaticResource x:Key="ChipStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ChipForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ChipSecondaryForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ServiceChipBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="SquadChipBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="CountChipBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="PriorityLevel1ChipBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
            <StaticResource x:Key="PriorityLevel2ChipBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="PriorityMidChipBackgroundBrush" ResourceKey="SystemFillColorNeutralBackgroundBrush" />
            <StaticResource x:Key="PriorityLowestChipBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="PriorityLevel1GlyphBrush" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="PriorityLevel2GlyphBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="SubtaskCardAccentBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="ErrorTextBrush" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="CompletedGlyphBrush" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="CalendarBarBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="CalendarBarAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="CalendarOverdueBarBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="CalendarOverdueBarStrokeBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="CalendarCompletedBarBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="CalendarCompletedBarStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="CalendarBarForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="CalendarCompletedBarForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <!-- Design §6.3 per-CR bar palette (blue, teal, purple, orange, magenta, green, indigo, brown, cyan, rose): tinted fills keep primary text above 4.5:1; stripes are the stronger accent. No entry reuses the Caution yellow of overdue. -->
            <SolidColorBrush x:Key="CalendarBarFill0" Color="#FFDCE9F8" />
            <SolidColorBrush x:Key="CalendarBarStripe0" Color="#FF2F6FB5" />
            <SolidColorBrush x:Key="CalendarBarFill1" Color="#FFD6F0EC" />
            <SolidColorBrush x:Key="CalendarBarStripe1" Color="#FF1A8577" />
            <SolidColorBrush x:Key="CalendarBarFill2" Color="#FFE9E0F5" />
            <SolidColorBrush x:Key="CalendarBarStripe2" Color="#FF7B4FB8" />
            <SolidColorBrush x:Key="CalendarBarFill3" Color="#FFFBE3D2" />
            <SolidColorBrush x:Key="CalendarBarStripe3" Color="#FFC25A12" />
            <SolidColorBrush x:Key="CalendarBarFill4" Color="#FFF6DDEB" />
            <SolidColorBrush x:Key="CalendarBarStripe4" Color="#FFB03A7A" />
            <SolidColorBrush x:Key="CalendarBarFill5" Color="#FFDFEFD8" />
            <SolidColorBrush x:Key="CalendarBarStripe5" Color="#FF4C8A2E" />
            <SolidColorBrush x:Key="CalendarBarFill6" Color="#FFDFE1F6" />
            <SolidColorBrush x:Key="CalendarBarStripe6" Color="#FF4B53B0" />
            <SolidColorBrush x:Key="CalendarBarFill7" Color="#FFEEE4D8" />
            <SolidColorBrush x:Key="CalendarBarStripe7" Color="#FF8A6236" />
            <SolidColorBrush x:Key="CalendarBarFill8" Color="#FFD5EEF6" />
            <SolidColorBrush x:Key="CalendarBarStripe8" Color="#FF1C7FA3" />
            <SolidColorBrush x:Key="CalendarBarFill9" Color="#FFF8DCDC" />
            <SolidColorBrush x:Key="CalendarBarStripe9" Color="#FFB83A3A" />
            <StaticResource x:Key="CalendarAdjacentDayForegroundBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="CalendarTodayBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="CalendarTodayForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="CalendarDropTargetStrokeBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="BoardInsertionLineBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="FlagChipBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ArchivedChipBackgroundBrush" ResourceKey="SystemFillColorNeutralBackgroundBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="Dark">
            <StaticResource x:Key="ChipStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="ChipForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="ChipSecondaryForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <StaticResource x:Key="ServiceChipBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="SquadChipBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="CountChipBackgroundBrush" ResourceKey="ControlFillColorSecondaryBrush" />
            <StaticResource x:Key="PriorityLevel1ChipBackgroundBrush" ResourceKey="SystemFillColorCriticalBackgroundBrush" />
            <StaticResource x:Key="PriorityLevel2ChipBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="PriorityMidChipBackgroundBrush" ResourceKey="SystemFillColorNeutralBackgroundBrush" />
            <StaticResource x:Key="PriorityLowestChipBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="PriorityLevel1GlyphBrush" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="PriorityLevel2GlyphBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="SubtaskCardAccentBrush" ResourceKey="ControlStrongStrokeColorDefaultBrush" />
            <StaticResource x:Key="ErrorTextBrush" ResourceKey="SystemFillColorCriticalBrush" />
            <StaticResource x:Key="CompletedGlyphBrush" ResourceKey="SystemFillColorSuccessBrush" />
            <StaticResource x:Key="CalendarBarBackgroundBrush" ResourceKey="SystemFillColorAttentionBackgroundBrush" />
            <StaticResource x:Key="CalendarBarAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="CalendarOverdueBarBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="CalendarOverdueBarStrokeBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="CalendarCompletedBarBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="CalendarCompletedBarStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="CalendarBarForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="CalendarCompletedBarForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <!-- Design §6.3 per-CR bar palette, same hue order as Light: dark tinted fills under light primary text, lighter stripes. -->
            <SolidColorBrush x:Key="CalendarBarFill0" Color="#FF1F3550" />
            <SolidColorBrush x:Key="CalendarBarStripe0" Color="#FF6AA6EA" />
            <SolidColorBrush x:Key="CalendarBarFill1" Color="#FF173F3A" />
            <SolidColorBrush x:Key="CalendarBarStripe1" Color="#FF4FC7B5" />
            <SolidColorBrush x:Key="CalendarBarFill2" Color="#FF352A4B" />
            <SolidColorBrush x:Key="CalendarBarStripe2" Color="#FFB392E6" />
            <SolidColorBrush x:Key="CalendarBarFill3" Color="#FF4A2E1A" />
            <SolidColorBrush x:Key="CalendarBarStripe3" Color="#FFF0995A" />
            <SolidColorBrush x:Key="CalendarBarFill4" Color="#FF47243A" />
            <SolidColorBrush x:Key="CalendarBarStripe4" Color="#FFE87BB6" />
            <SolidColorBrush x:Key="CalendarBarFill5" Color="#FF26391E" />
            <SolidColorBrush x:Key="CalendarBarStripe5" Color="#FF8CC66A" />
            <SolidColorBrush x:Key="CalendarBarFill6" Color="#FF282C4E" />
            <SolidColorBrush x:Key="CalendarBarStripe6" Color="#FF8E96EC" />
            <SolidColorBrush x:Key="CalendarBarFill7" Color="#FF3E3123" />
            <SolidColorBrush x:Key="CalendarBarStripe7" Color="#FFC9A076" />
            <SolidColorBrush x:Key="CalendarBarFill8" Color="#FF163B47" />
            <SolidColorBrush x:Key="CalendarBarStripe8" Color="#FF5EC4E6" />
            <SolidColorBrush x:Key="CalendarBarFill9" Color="#FF4A2323" />
            <SolidColorBrush x:Key="CalendarBarStripe9" Color="#FFEE8585" />
            <StaticResource x:Key="CalendarAdjacentDayForegroundBrush" ResourceKey="TextFillColorTertiaryBrush" />
            <StaticResource x:Key="CalendarTodayBackgroundBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="CalendarTodayForegroundBrush" ResourceKey="TextOnAccentFillColorPrimaryBrush" />
            <StaticResource x:Key="CalendarDropTargetStrokeBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="BoardInsertionLineBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="FlagChipBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="ArchivedChipBackgroundBrush" ResourceKey="SystemFillColorNeutralBackgroundBrush" />
        </ResourceDictionary>
        <ResourceDictionary x:Key="HighContrast">
            <!-- Design §3 rule 3: chips render as ButtonFace with ButtonText border and text; glyphs carry meaning. -->
            <StaticResource x:Key="ChipStrokeBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ChipForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ChipSecondaryForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="ServiceChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="SquadChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CountChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLevel1ChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLevel2ChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityMidChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLowestChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="PriorityLevel1GlyphBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="PriorityLevel2GlyphBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="SubtaskCardAccentBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="ErrorTextBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <StaticResource x:Key="CompletedGlyphBrush" ResourceKey="SystemColorWindowTextColorBrush" />
            <!-- Design §6.3 HC: bars are ButtonFace with a ButtonText border; the glyph and text carry the state. -->
            <StaticResource x:Key="CalendarBarBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarAccentBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarOverdueBarBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarOverdueBarStrokeBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarCompletedBarBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarCompletedBarStrokeBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="CalendarBarForegroundBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarCompletedBarForegroundBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <!-- Design §3 rule 3: no custom palette in High Contrast; every entry is ButtonFace with a ButtonText stripe. -->
            <StaticResource x:Key="CalendarBarFill0" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe0" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill1" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe1" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill2" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe2" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill3" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe3" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill4" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe4" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill5" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe5" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill6" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe6" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill7" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe7" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill8" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe8" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill9" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe9" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarAdjacentDayForegroundBrush" ResourceKey="SystemColorGrayTextColorBrush" />
            <StaticResource x:Key="CalendarTodayBackgroundBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="CalendarTodayForegroundBrush" ResourceKey="SystemColorHighlightTextColorBrush" />
            <StaticResource x:Key="CalendarDropTargetStrokeBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="BoardInsertionLineBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <StaticResource x:Key="FlagChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="ArchivedChipBackgroundBrush" ResourceKey="SystemColorButtonFaceColorBrush" />
        </ResourceDictionary>
    </ResourceDictionary.ThemeDictionaries>

    <!-- Chip anatomy (design §6.1): corner radius 4, padding 6x2, caption text, optional 12-epx glyph. -->
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ChipStrokeBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ServiceChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ServiceChipBackgroundBrush}" />
    </Style>
    <Style x:Key="SquadChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SquadChipBackgroundBrush}" />
    </Style>
    <Style x:Key="CountChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CountChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityLevel1ChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityLevel1ChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityLevel2ChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityLevel2ChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityMidChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityMidChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityLowestChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityLowestChipBackgroundBrush}" />
    </Style>
    <Style x:Key="FlagChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FlagChipBackgroundBrush}" />
    </Style>
    <Style x:Key="ArchivedChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ArchivedChipBackgroundBrush}" />
    </Style>
    <Style x:Key="ChipTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ChipForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="ChipGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource ChipForegroundBrush}" />
    </Style>

    <!-- Card surfaces (design §3): card fill with a 1-px stroke; nested surfaces use the secondary fill. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SecondaryCardBorderStyle" BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <!--
        Native settings cards (ADR 0021, design §4.6): card fill with a 1-px stroke and the control corner radius.
        SettingsCard builds its layout in code over this border style; settings expanders are native Expanders.
    -->
    <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SettingsSectionHeaderTextStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="1,28,0,6" />
    </Style>

    <!--
        Grid cells (design §4.3). Archived rows use secondary text with an "Archived" chip (B-05). The frozen first
        column at S has an opaque surface so cells scrolling underneath stay hidden.
    -->
    <Style x:Key="GridCellTextStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GridCellSecondaryTextStyle" BasedOn="{StaticResource GridCellTextStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- The chevron or calendar glyph that makes a choice cell look like its ComboBox or date picker at rest. -->
    <Style x:Key="GridCellAffordanceGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A transparent background makes the whole cell hit-testable, so one click anywhere in it reaches the cell. -->
    <Style x:Key="GridCellStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="GridFrozenCellStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!--
        Theme-following text and glyph styles for elements built or switched in code. A brush looked up from
        Application.Resources in code resolves for the application theme once, so it would neither follow the
        window's Light/Dark choice nor High Contrast; a style's ThemeResource setter resolves per element.
    -->
    <Style x:Key="ErrorCaptionTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ErrorTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ChecklistItemTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ChecklistDoneItemTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WarningGlyphStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="ErrorGlyphStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Page header (design §2.3): title row with an optional secondary subtitle. -->
    <Style x:Key="PageTitleTextStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PageSubtitleTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Calendar surface (design §4.4, §6.3). Built in code by CalendarMonthView, which looks these styles up. In Light
        and Dark the bar styles' brushes are replaced by the CR's palette entry (CalendarBarPalette); they apply as-is
        in High Contrast and if the palette cannot be resolved.
    -->
    <Style x:Key="CalendarDayCellButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,1,0" />
    </Style>
    <!-- Design §6.3/§9: a drop target shows a 2-epx stroke (plus the drag caption), never a fill change alone. -->
    <Style x:Key="CalendarDayCellDropTargetButtonStyle" BasedOn="{StaticResource CalendarDayCellButtonStyle}" TargetType="Button">
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarDropTargetStrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="CalendarBarButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource CalendarBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CalendarBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarBarAccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style x:Key="CalendarOverdueBarButtonStyle" BasedOn="{StaticResource CalendarBarButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CalendarOverdueBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarOverdueBarStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="CalendarCompletedBarButtonStyle" BasedOn="{StaticResource CalendarBarButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CalendarCompletedBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CalendarCompletedBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarCompletedBarStrokeBrush}" />
    </Style>
    <Style x:Key="CalendarTodayBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CalendarTodayBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="CalendarTodayTextStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CalendarTodayForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CalendarDayTextStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,2,0,0" />
    </Style>
    <Style x:Key="CalendarAdjacentDayTextStyle" BasedOn="{StaticResource CalendarDayTextStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CalendarAdjacentDayForegroundBrush}" />
    </Style>
    <Style x:Key="CalendarStubBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</ResourceDictionary>
