            <StaticResource x:Key="CalendarBarStripe0" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill1" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe1" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="CalendarBarFill2" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="CalendarBarStripe2" ResourceKey="SystemColorButtonTextColorBrush" />
