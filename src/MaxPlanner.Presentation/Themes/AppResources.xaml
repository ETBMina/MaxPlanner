            <StaticResource x:Key="TagPillForeground8" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TagPillFill9" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="TagPillForeground9" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TagPillStrokeBrush" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TagPillHoverStrokeBrush" ResourceKey="SystemColorHighlightColorBrush" />
            <x:Double x:Key="TagPillHoverOverlayOpacity">0</x:Double>
