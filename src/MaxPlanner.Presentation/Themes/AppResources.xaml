    <!-- Person avatars (PersonAvatar, PersonAvatarGroup): size, corner radius, and fill are set in code. -->
    <Style x:Key="PersonAvatarStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource PersonAvatarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PersonAvatarStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <!-- In a stack, a ring in the surface color separates each circle from the one it overlaps. -->
    <Style x:Key="PersonAvatarStackedStyle" BasedOn="{StaticResource PersonAvatarStyle}" TargetType="Grid">
        <Setter Property="BorderBrush" Value="{ThemeResource PersonAvatarRingBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style x:Key="PersonAvatarOverflowStyle" TargetType="Grid">
        <Setter Property="Background" Value="{ThemeResource PersonAvatarOverflowBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource PersonAvatarRingBrush}" />
        <Setter Property="BorderThickness" Value="1.5" />
    </Style>
    <Style x:Key="PersonAvatarTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PersonAvatarForegroundBrush}" />
    </Style>
    <Style x:Key="PersonAvatarOverflowTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource PersonAvatarOverflowForegroundBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <!-- Chip anatomy (design §6.1): corner radius 4, padding 6x2, caption text, optional 12-epx glyph. -->
    <Style x:Key="ChipBorderStyle" TargetType="Border">
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Padding" Value="6,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource ChipStrokeBrush}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="ServiceChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ServiceChipBackgroundBrush}" />
    </Style>
    <Style x:Key="SquadChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource SquadChipBackgroundBrush}" />
    </Style>
    <!-- Board column counts and card service chips (design §4.2): accent fill with on-accent text and glyph. -->
    <Style x:Key="AccentChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource AccentChipBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource AccentChipStrokeBrush}" />
    </Style>
    <Style x:Key="PriorityLevel1ChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityLevel1ChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityLevel2ChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityLevel2ChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityMidChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityMidChipBackgroundBrush}" />
    </Style>
    <Style x:Key="PriorityLowestChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource PriorityLowestChipBackgroundBrush}" />
    </Style>
    <Style x:Key="FlagChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource FlagChipBackgroundBrush}" />
    </Style>
    <Style x:Key="ArchivedChipStyle" BasedOn="{StaticResource ChipBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource ArchivedChipBackgroundBrush}" />
    </Style>
    <Style x:Key="ChipTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ChipForegroundBrush}" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="MaxLines" Value="1" />
    </Style>
    <Style x:Key="ChipGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{ThemeResource ChipForegroundBrush}" />
    </Style>
    <Style x:Key="AccentChipTextStyle" BasedOn="{StaticResource ChipTextStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource AccentChipForegroundBrush}" />
    </Style>
    <Style x:Key="AccentChipGlyphStyle" BasedOn="{StaticResource ChipGlyphStyle}" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource AccentChipForegroundBrush}" />
    </Style>

    <!--
        Tag pills (design §6.1): fully rounded, with no border, glyph, or dot; a translucent hue fill with text in a
        darker shade of the same hue. TagPill picks TagPillStyle{i} / TagPillButtonStyle{i} from the tag's Id. Corner
        radius 11 is half the 22-epx height (caption line 16 + padding 2x2 + the 1-epx stroke High Contrast shows).
    -->
    <Style x:Key="TagPillStyle" TargetType="ContentPresenter">
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TagPillStrokeBrush}" />
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <Style x:Key="TagPillTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <!-- Display only: the Grid cell's accessible name already lists every tag. -->
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="MaxLines" Value="1" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="TagPillOverflowTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="AutomationProperties.AccessibilityView" Value="Raw" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="IsHitTestVisible" Value="False" />
    </Style>
    <!-- A removable tag chip in the TokenPicker: the pill, plus an overlay in the pill's own text color on hover and press. -->
    <Style x:Key="TagPillButtonStyle" TargetType="Button">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="CornerRadius" Value="11" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="BorderBrush" Value="{ThemeResource TagPillStrokeBrush}" />
        <Setter Property="BackgroundSizing" Value="OuterBorderEdge" />
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="UseSystemFocusVisuals" Value="{StaticResource UseSystemFocusVisuals}" />
        <Setter Property="FocusVisualMargin" Value="-3" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid
                        x:Name="Root"
                        Background="{TemplateBinding Background}"
                        BackgroundSizing="{TemplateBinding BackgroundSizing}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="{TemplateBinding CornerRadius}">
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal" />
                                <VisualState x:Name="PointerOver">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="{ThemeResource TagPillHoverOverlayOpacity}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource TagPillHoverStrokeBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <VisualState.Setters>
                                        <Setter Target="Overlay.Opacity" Value="{ThemeResource TagPillPressedOverlayOpacity}" />
                                        <Setter Target="Root.BorderBrush" Value="{ThemeResource TagPillHoverStrokeBrush}" />
                                    </VisualState.Setters>
                                </VisualState>
                                <VisualState x:Name="Disabled" />
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border
                            x:Name="Overlay"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="{TemplateBinding CornerRadius}"
                            Opacity="0" />
                        <ContentPresenter
                            x:Name="ContentPresenter"
                            Padding="{TemplateBinding Padding}"
                            HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                            VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                            AutomationProperties.AccessibilityView="Raw"
                            Content="{TemplateBinding Content}"
                            ContentTemplate="{TemplateBinding ContentTemplate}"
                            ContentTransitions="{TemplateBinding ContentTransitions}"
                            Foreground="{TemplateBinding Foreground}" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="TagPillStyle0" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill0}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground0}" />
    </Style>
    <Style x:Key="TagPillButtonStyle0" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill0}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground0}" />
    </Style>
    <Style x:Key="TagPillStyle1" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill1}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground1}" />
    </Style>
    <Style x:Key="TagPillButtonStyle1" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill1}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground1}" />
    </Style>
    <Style x:Key="TagPillStyle2" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill2}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground2}" />
    </Style>
    <Style x:Key="TagPillButtonStyle2" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill2}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground2}" />
    </Style>
    <Style x:Key="TagPillStyle3" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill3}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground3}" />
    </Style>
    <Style x:Key="TagPillButtonStyle3" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill3}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground3}" />
    </Style>
    <Style x:Key="TagPillStyle4" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill4}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground4}" />
    </Style>
    <Style x:Key="TagPillButtonStyle4" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill4}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground4}" />
    </Style>
    <Style x:Key="TagPillStyle5" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill5}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground5}" />
    </Style>
    <Style x:Key="TagPillButtonStyle5" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill5}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground5}" />
    </Style>
    <Style x:Key="TagPillStyle6" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill6}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground6}" />
    </Style>
    <Style x:Key="TagPillButtonStyle6" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill6}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground6}" />
    </Style>
    <Style x:Key="TagPillStyle7" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill7}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground7}" />
    </Style>
    <Style x:Key="TagPillButtonStyle7" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill7}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground7}" />
    </Style>
    <Style x:Key="TagPillStyle8" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill8}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground8}" />
    </Style>
    <Style x:Key="TagPillButtonStyle8" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill8}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground8}" />
    </Style>
    <Style x:Key="TagPillStyle9" BasedOn="{StaticResource TagPillStyle}" TargetType="ContentPresenter">
        <Setter Property="Background" Value="{ThemeResource TagPillFill9}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground9}" />
    </Style>
    <Style x:Key="TagPillButtonStyle9" BasedOn="{StaticResource TagPillButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource TagPillFill9}" />
        <Setter Property="Foreground" Value="{ThemeResource TagPillForeground9}" />
    </Style>

    <!-- Card surfaces (design §3): card fill with a 1-px stroke; nested surfaces use the secondary fill. -->
    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
    </Style>
    <Style x:Key="SecondaryCardBorderStyle" BasedOn="{StaticResource CardBorderStyle}" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorSecondaryBrush}" />
    </Style>

    <!--
        Native settings cards (ADR 0021, design §4.6): card fill with a 1-px stroke and the control corner radius.
        SettingsCard builds its layout in code over this border style; settings expanders are native Expanders.
    -->
    <Style x:Key="SettingsCardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{ThemeResource ControlCornerRadius}" />
        <Setter Property="Padding" Value="16,12" />
        <Setter Property="MinHeight" Value="68" />
    </Style>
    <Style x:Key="SettingsExpanderStyle" TargetType="Expander">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Padding" Value="0" />
    </Style>
    <Style x:Key="SettingsSectionHeaderTextStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="1,28,0,6" />
    </Style>

    <!--
        Grid cells (design §4.3). Archived rows use secondary text with an "Archived" chip (B-05). The frozen first
        column at S has an opaque surface so cells scrolling underneath stay hidden.
    -->
    <Style x:Key="GridCellTextStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="GridCellSecondaryTextStyle" BasedOn="{StaticResource GridCellTextStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- The chevron or calendar glyph that makes a choice cell look like its ComboBox or date picker at rest. -->
    <Style x:Key="GridCellAffordanceGlyphStyle" TargetType="FontIcon">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
    </Style>
    <!-- A transparent background makes the whole cell hit-testable, so one click anywhere in it reaches the cell. -->
    <Style x:Key="GridCellStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="Transparent" />
    </Style>

    <Style x:Key="GridFrozenCellStyle" TargetType="ContentControl">
        <Setter Property="Background" Value="{ThemeResource SolidBackgroundFillColorBaseBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,0,1,0" />
    </Style>

    <!--
        Theme-following text and glyph styles for elements built or switched in code. A brush looked up from
        Application.Resources in code resolves for the application theme once, so it would neither follow the
        window's Light/Dark choice nor High Contrast; a style's ThemeResource setter resolves per element.
    -->
    <Style x:Key="ErrorCaptionTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource ErrorTextBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ChecklistItemTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorPrimaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="ChecklistDoneItemTextStyle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
    <Style x:Key="WarningGlyphStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCautionBrush}" />
    </Style>
    <Style x:Key="ErrorGlyphStyle" TargetType="FontIcon">
        <Setter Property="Foreground" Value="{ThemeResource SystemFillColorCriticalBrush}" />
    </Style>

    <!-- Page header (design §2.3): title row with an optional secondary subtitle. -->
    <Style x:Key="PageTitleTextStyle" BasedOn="{StaticResource TitleTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
    </Style>
    <Style x:Key="PageSubtitleTextStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--
        Calendar surface (design §4.4, §6.3). Built in code by CalendarMonthView, which looks these styles up. In Light
        and Dark the bar styles' brushes are replaced by the CR's palette entry (CalendarBarPalette); they apply as-is
        in High Contrast and if the palette cannot be resolved.
    -->
    <Style x:Key="CalendarDayCellButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
        <Setter Property="Padding" Value="6,4" />
        <Setter Property="CornerRadius" Value="0" />
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,1,0" />
    </Style>
    <!-- Design §6.3/§9: a drop target shows a 2-epx stroke (plus the drag caption), never a fill change alone. -->
    <Style x:Key="CalendarDayCellDropTargetButtonStyle" BasedOn="{StaticResource CalendarDayCellButtonStyle}" TargetType="Button">
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarDropTargetStrokeBrush}" />
        <Setter Property="BorderThickness" Value="2" />
    </Style>
    <Style x:Key="CalendarBarButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="Padding" Value="6,1" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="Background" Value="{ThemeResource CalendarBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CalendarBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarBarAccentBrush}" />
        <Setter Property="BorderThickness" Value="3,0,0,0" />
    </Style>
    <Style x:Key="CalendarOverdueBarButtonStyle" BasedOn="{StaticResource CalendarBarButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CalendarOverdueBarBackgroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarOverdueBarStrokeBrush}" />
        <Setter Property="BorderThickness" Value="1" />
    </Style>
    <Style x:Key="CalendarCompletedBarButtonStyle" BasedOn="{StaticResource CalendarBarButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="{ThemeResource CalendarCompletedBarBackgroundBrush}" />
        <Setter Property="Foreground" Value="{ThemeResource CalendarCompletedBarForegroundBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CalendarCompletedBarStrokeBrush}" />
    </Style>
    <Style x:Key="CalendarTodayBadgeStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CalendarTodayBackgroundBrush}" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="MinWidth" Value="24" />
        <Setter Property="MinHeight" Value="24" />
        <Setter Property="Padding" Value="4,0" />
    </Style>
    <Style x:Key="CalendarTodayTextStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CalendarTodayForegroundBrush}" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="CalendarDayTextStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Margin" Value="2,2,0,0" />
    </Style>
    <Style x:Key="CalendarAdjacentDayTextStyle" BasedOn="{StaticResource CalendarDayTextStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource CalendarAdjacentDayForegroundBrush}" />
    </Style>
    <Style x:Key="CalendarStubBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource LayerFillColorAltBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource DividerStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="0,1,0,0" />
    </Style>
</ResourceDictionary>
