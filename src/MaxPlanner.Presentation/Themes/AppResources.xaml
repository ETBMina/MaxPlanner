            <StaticResource x:Key="TagPillForeground0" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TagPillFill1" ResourceKey="SystemColorButtonFaceColorBrush" />
            <StaticResource x:Key="TagPillForeground1" ResourceKey="SystemColorButtonTextColorBrush" />
            <StaticResource x:Key="TagPillFill2" ResourceKey="SystemColorButtonFaceColorBrush" />
