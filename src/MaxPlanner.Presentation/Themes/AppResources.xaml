            <StaticResource x:Key="CalendarBarAccentBrush" ResourceKey="AccentFillColorDefaultBrush" />
            <StaticResource x:Key="CalendarOverdueBarBackgroundBrush" ResourceKey="SystemFillColorCautionBackgroundBrush" />
            <StaticResource x:Key="CalendarOverdueBarStrokeBrush" ResourceKey="SystemFillColorCautionBrush" />
            <StaticResource x:Key="CalendarCompletedBarBackgroundBrush" ResourceKey="SubtleFillColorSecondaryBrush" />
            <StaticResource x:Key="CalendarCompletedBarStrokeBrush" ResourceKey="ControlStrokeColorDefaultBrush" />
            <StaticResource x:Key="CalendarBarForegroundBrush" ResourceKey="TextFillColorPrimaryBrush" />
            <StaticResource x:Key="CalendarCompletedBarForegroundBrush" ResourceKey="TextFillColorSecondaryBrush" />
            <!-- Design §6.3 per-CR bar palette (blue, teal, purple, orange, magenta, green, indigo, brown, cyan, rose): tinted fills keep primary text above 4.5:1; stripes are the stronger accent. No entry reuses the Caution yellow of overdue. -->
            <SolidColorBrush x:Key="CalendarBarFill0" Color="#FFDCE9F8" />
            <SolidColorBrush x:Key="CalendarBarStripe0" Color="#FF2F6FB5" />
            <SolidColorBrush x:Key="CalendarBarFill1" Color="#FFD6F0EC" />
            <SolidColorBrush x:Key="CalendarBarStripe1" Color="#FF1A8577" />
            <SolidColorBrush x:Key="CalendarBarFill2" Color="#FFE9E0F5" />
            <SolidColorBrush x:Key="CalendarBarStripe2" Color="#FF7B4FB8" />
            <SolidColorBrush x:Key="CalendarBarFill3" Color="#FFFBE3D2" />
            <SolidColorBrush x:Key="CalendarBarStripe3" Color="#FFC25A12" />
            <SolidColorBrush x:Key="CalendarBarFill4" Color="#FFF6DDEB" />
            <SolidColorBrush x:Key="CalendarBarStripe4" Color="#FFB03A7A" />
            <SolidColorBrush x:Key="CalendarBarFill5" Color="#FFDFEFD8" />
