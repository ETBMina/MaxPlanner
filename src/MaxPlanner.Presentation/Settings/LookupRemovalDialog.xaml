<?xml version="1.0" encoding="utf-8"?>
<!--
    Lookup removal with replacement (design §5.9, B-04, B-11) on the native ContentDialog [gallery-contentdialog-1].
    Close (Cancel) is the default button because the action changes many records.
-->
<ContentDialog
    x:Class="MaxPlanner.Presentation.Settings.LookupRemovalDialog"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    Title="{x:Bind ViewModel.DialogTitle, Mode=OneTime}"
    AutomationProperties.AutomationId="LookupRemove_Dialog"
    CloseButtonText="{x:Bind ViewModel.CloseButtonText, Mode=OneTime}"
    DefaultButton="Close"
    IsPrimaryButtonEnabled="{x:Bind ViewModel.CanRemove, Mode=OneWay}"
    PrimaryButtonClick="OnPrimaryClick"
    PrimaryButtonText="{x:Bind ViewModel.PrimaryButtonText, Mode=OneWay}"
    Style="{StaticResource DefaultContentDialogStyle}">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel MaxWidth="480" Spacing="12">
            <InfoBar
                AutomationProperties.AutomationId="LookupRemove_UsageChangedInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind common:BindFunctions.HasText(ViewModel.UsageChangedMessage), Mode=OneWay}"
                Message="{x:Bind ViewModel.UsageChangedMessage, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                AutomationProperties.AutomationId="LookupRemove_ErrorInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind common:BindFunctions.HasText(ViewModel.Error), Mode=OneWay}"
                Message="{x:Bind ViewModel.Error, Mode=OneWay}"
                Severity="Error" />

            <ProgressRing
                Width="24"
                Height="24"
                HorizontalAlignment="Left"
                IsActive="{x:Bind ViewModel.IsLoading, Mode=OneWay}" />

            <TextBlock x:Uid="LookupRemove_InUseBy" Style="{StaticResource BodyStrongTextBlockStyle}" />
            <ItemsControl AutomationProperties.AutomationId="LookupRemove_Counts" IsTabStop="False" ItemsSource="{x:Bind ViewModel.UsageLines, Mode=OneWay}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="x:String">
                        <TextBlock Style="{StaticResource BodyTextBlockStyle}" Text="{x:Bind}" TextWrapping="Wrap" />
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <StackPanel Spacing="8" Visibility="{x:Bind ViewModel.ShowReplacement, Mode=OneWay}">
                <!-- Design §5.9: "Replace with…" / "Clear from records" only where clearing is allowed (§11 Q4). -->
                <!-- Items come from the resources in code-behind (P6: no hard-coded UI text). -->
                <RadioButtons
                    x:Name="ModeRadios"
                    x:Uid="LookupRemove_ModeRadios"
                    AutomationProperties.AutomationId="LookupRemove_ModeRadios"
                    SelectionChanged="OnModeChanged"
                    Visibility="{x:Bind ViewModel.ShowClearOption, Mode=OneWay}" />
                <ComboBox
                    x:Uid="LookupRemove_ReplacementCombo"
                    MinWidth="240"
                    AutomationProperties.AutomationId="LookupRemove_ReplacementCombo"
                    AutomationProperties.IsRequiredForForm="True"
                    IsEnabled="{x:Bind common:BindFunctions.Not(ViewModel.ClearInstead), Mode=OneWay}"
                    ItemsSource="{x:Bind ViewModel.ReplacementChoices, Mode=OneTime}"
                    SelectedIndex="{x:Bind ViewModel.SelectedReplacementIndex, Mode=TwoWay}" />
            </StackPanel>

            <TextBlock
                x:Uid="LookupRemove_StatusNote"
                Style="{StaticResource PageSubtitleTextStyle}"
                Visibility="{x:Bind ViewModel.ShowStatusNote, Mode=OneTime}" />

            <StackPanel Orientation="Horizontal" Spacing="8" Visibility="{x:Bind ViewModel.IsSaving, Mode=OneWay}">
                <ProgressRing Width="16" Height="16" IsActive="{x:Bind ViewModel.IsSaving, Mode=OneWay}" />
                <TextBlock x:Uid="TaskEditor_Saving" Style="{StaticResource CaptionTextBlockStyle}" />
            </StackPanel>
        </StackPanel>
    </ScrollViewer>
</ContentDialog>
