<?xml version="1.0" encoding="utf-8"?>
<!-- Settings › Data › Backups (design §4.6). Hosted by DataPageView; bindings are flat on this view's ViewModel. -->
<UserControl
    x:Class="MaxPlanner.Presentation.Settings.DataPage.BackupsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MaxPlanner.Presentation.Settings.DataPage"
    IsTabStop="False">

    <Grid x:Name="BackupsPanel" Padding="32,0,32,16" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button x:Uid="Backups_BackUpNowButton" AutomationProperties.AutomationId="Data_BackupsBackUpNowButton" Command="{x:Bind ViewModel.BackUpNowCommand, Mode=OneTime}" Style="{StaticResource AccentButtonStyle}" />
                <Button x:Uid="Backups_OpenFolderButton" AutomationProperties.AutomationId="Data_BackupsOpenFolderButton" Command="{x:Bind ViewModel.OpenFolderCommand, Mode=OneTime}" />
                <TextBlock VerticalAlignment="Center" Text="{x:Bind ViewModel.StatusText, Mode=OneWay}" />
            </StackPanel>
            <InfoBar
                Grid.Row="1"
                AutomationProperties.AutomationId="Data_BackupsErrorInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.HasError, Mode=OneWay}"
                Message="{x:Bind ViewModel.ErrorMessage, Mode=OneWay}"
                Severity="Error" />
            <ListView
                Grid.Row="2"
                AutomationProperties.AutomationId="Data_BackupsList"
                ItemsSource="{x:Bind ViewModel.Rows, Mode=OneTime}"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="local:BackupRowViewModel">
                        <Grid Padding="0,6" AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneTime}" ColumnSpacing="12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock><Run FontWeight="SemiBold" Text="{x:Bind DateText, Mode=OneTime}" /><Run Text=" · " /><Run Text="{x:Bind KindText, Mode=OneTime}" /></TextBlock>
                                <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}"><Run Text="{x:Bind SizeText, Mode=OneTime}" /><Run Text=" · " /><Run Text="{x:Bind ManifestText, Mode=OneTime}" /></TextBlock>
                            </StackPanel>
                            <Button
                                x:Uid="Backups_DeleteButton"
                                Grid.Column="1"
                                AutomationProperties.AutomationId="{x:Bind local:DataPageView.DeleteId(Name), Mode=OneTime}"
                                Click="OnDeleteBackupClick"
                                Visibility="{x:Bind local:DataPageView.Show(IsManual), Mode=OneTime}" />
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>
</UserControl>
