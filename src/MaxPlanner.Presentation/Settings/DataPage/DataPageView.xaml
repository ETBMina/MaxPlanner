<?xml version="1.0" encoding="utf-8"?>
<!--
    Settings › Data (design §4.6, D13; B-12, B-13, T-09): BreadcrumbBar "Settings › Data" [gallery-breadcrumbbar-1], a
    SelectorBar Import · Export · Restore · Backups, and each workflow as an in-page wizard: a step list at L, the
    "Step 2 of 5 · …" caption at M/S, Back / Next (accent) / Cancel in the footer. Work runs off the UI thread with a
    progress bar; Cancel is honored only before a commit.
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Settings.DataPage.DataPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:local="using:MaxPlanner.Presentation.Settings.DataPage"
    IsTabStop="False">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel x:Name="HeaderRoot" Padding="32,24,32,8" Spacing="8">
            <BreadcrumbBar
                x:Name="Breadcrumb"
                AutomationProperties.AutomationId="Data_Breadcrumb"
                ItemClicked="OnBreadcrumbClicked" />
            <SelectorBar
                x:Name="ModeBar"
                AutomationProperties.AutomationId="Data_ModeBar"
                SelectionChanged="OnModeChanged">
                <SelectorBarItem x:Name="ImportItem" x:Uid="Data_ModeImportItem" AutomationProperties.AutomationId="Data_ModeImportItem" IsSelected="True" />
                <SelectorBarItem x:Name="ExportItem" x:Uid="Data_ModeExportItem" AutomationProperties.AutomationId="Data_ModeExportItem" />
                <SelectorBarItem x:Name="RestoreItem" x:Uid="Data_ModeRestoreItem" AutomationProperties.AutomationId="Data_ModeRestoreItem" />
                <SelectorBarItem x:Name="BackupsItem" x:Uid="Data_ModeBackupsItem" AutomationProperties.AutomationId="Data_ModeBackupsItem" />
            </SelectorBar>
        </StackPanel>

        <ContentControl x:Name="ImportHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Visibility="{x:Bind local:DataPageView.Show(ViewModel.IsImport), Mode=OneWay}" />
        <ContentControl x:Name="ExportHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Visibility="{x:Bind local:DataPageView.Show(ViewModel.IsExport), Mode=OneWay}" />
        <ContentControl x:Name="RestoreHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Visibility="{x:Bind local:DataPageView.Show(ViewModel.IsRestore), Mode=OneWay}" />
        <ContentControl x:Name="BackupsHost" Grid.Row="2" HorizontalContentAlignment="Stretch" VerticalContentAlignment="Stretch" IsTabStop="False" Visibility="{x:Bind local:DataPageView.Show(ViewModel.IsBackups), Mode=OneWay}" />
    </Grid>
</UserControl>
