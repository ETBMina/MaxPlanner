<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Board.BoardPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:filters="using:MaxPlanner.Presentation.Common.Filters"
    xmlns:local="using:MaxPlanner.Presentation.Board"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- Design §4.2 item 6: card avatars sit side by side with a small gap, never overlapping. -->
        <StackLayout x:Key="CardPeopleLayout" Orientation="Horizontal" Spacing="4" />
        <DataTemplate x:Key="CardPersonTemplate" x:DataType="local:BoardCardPerson">
            <!-- Each avatar is its own tooltip target: the name, then the roles in secondary text (design §2.10). -->
            <controls:PersonAvatar
                AccessibleName="{x:Bind AccessibleName, Mode=OneTime}"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                Diameter="20"
                DisplayName="{x:Bind Name, Mode=OneTime}"
                IsDecorative="False">
                <controls:PersonAvatar.ToolTipContent>
                    <StackPanel>
                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind RolesText, Mode=OneTime}" />
                    </StackPanel>
                </controls:PersonAvatar.ToolTipContent>
            </controls:PersonAvatar>
        </DataTemplate>
        <!--
            One template for both card kinds, each loading only its own anatomy (design §4.2, owner redesign "H1 · Pill
            strip"). Two templates through a selector made the virtualizing panel misestimate a long bucket while scrolling
            up, until it reached the first card and snapped the offset back by thousands of epx (the bucket jumped to the top).
        -->
        <DataTemplate x:Key="CardTemplate" x:DataType="local:BoardCardViewModel">
            <!--
                Item 1: a normal card (1-px stroke on all sides, 8-epx corners, no colored edge). Design §4.2: a card being
                moved is dimmed and captioned "Moving" until the move is saved.
            -->
            <Border
                Opacity="{x:Bind local:BoardPageView.MovingOpacity(IsMoving), Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel>
                    <!-- Item 2: the tag strip (task Tags, or the parent's on a Subtask card) with the ⋯ button at its end. -->
                    <Grid
                        ColumnSpacing="4"
                        Style="{StaticResource BoardTagStripStyle}"
                        ToolTipService.ToolTip="{x:Bind TagsText, Mode=OneWay}"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasTagStrip), Mode=OneWay}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <controls:TagPillStrip
                            HorizontalAlignment="Left"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardTagStrip_', Key), Mode=OneTime}"
                            IsCompact="True"
                            Items="{x:Bind Tags, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardMenuButtonStrip_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                            Click="OnCardMenuButtonClick"
                            Style="{StaticResource BoardCardMenuButtonStyle}"
                            ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    <StackPanel Padding="12,8,12,12" Spacing="8">
                        <!-- Item 3: the ID row; without a strip the ⋯ button sits at its right end. -->
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <local:BoardChipRow MinHeight="20" Spacing="6">
                                <!-- Each priority level has its own glyph, so color is never the only cue. -->
                                <FontIcon
                                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardPriority_', Key), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind PriorityName, Mode=OneWay}"
                                    FontSize="16"
                                    Glyph="{x:Bind local:BoardPageView.PriorityGlyph(PriorityLevel), Mode=OneWay}"
                                    Style="{x:Bind local:BoardPageView.PriorityGlyphStyle(PriorityLevel), Mode=OneWay}"
                                    ToolTipService.ToolTip="{x:Bind PriorityName, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(IsTask), Mode=OneWay}" />
                                <!-- A Subtask card has no priority: the Subtask glyph and the "Subtask of" link mark the kind without color. -->
                                <FontIcon
                                    x:Uid="Board_SubtaskGlyph"
                                    FontSize="16"
                                    Foreground="{ThemeResource SubtaskCardAccentBrush}"
                                    Glyph="&#xE8FD;"
                                    Visibility="{x:Bind common:BindFunctions.Visible(IsSubtaskCard), Mode=OneWay}" />
                                <!-- The CR chip opens the CR; the card menu's Open CR is its keyboard route. -->
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardCrChip_', Key), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind OpenCrName, Mode=OneWay}"
                                    Click="OnCardCrLinkClick"
                                    Style="{StaticResource IdChipButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind OpenCrName, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(HasCrReference), Mode=OneWay}">
                                    <Grid ColumnSpacing="4">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <FontIcon FontSize="12" Glyph="&#xE8A5;" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Style="{StaticResource IdChipTextStyle}"
                                            Text="{x:Bind CrNumber, Mode=OneWay}" />
                                    </Grid>
                                </Button>
                                <!-- The Task chip copies the card's ID (Settings › Defaults Copy ID format), like the menu's Copy ID. -->
                                <Button
                                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardTaskChip_', Key), Mode=OneTime}"
                                    AutomationProperties.Name="{x:Bind CopyIdName, Mode=OneWay}"
                                    Click="OnCardTaskChipClick"
                                    Style="{StaticResource IdChipButtonStyle}"
                                    ToolTipService.ToolTip="{x:Bind CopyIdName, Mode=OneWay}"
                                    Visibility="{x:Bind common:BindFunctions.Visible(HasTaskNumber), Mode=OneWay}">
                                    <TextBlock Style="{StaticResource IdChipTextStyle}" Text="{x:Bind TaskNumber, Mode=OneWay}" />
                                </Button>
                            </local:BoardChipRow>
                            <Button
                                Grid.Column="1"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardMenuButton_', Key), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                                Click="OnCardMenuButtonClick"
                                Style="{StaticResource BoardCardMenuButtonStyle}"
                                ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}"
                                Visibility="{x:Bind common:BindFunctions.Collapsed(HasTagStrip), Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Uid="Board_MovingCaption"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind common:BindFunctions.Visible(IsMoving), Mode=OneWay}" />
                        <!-- B-16.5: the "Subtask of" indicator opens the parent; the card menu's Open parent task is its keyboard route. -->
                        <HyperlinkButton
                            x:Name="SubtaskParentLink"
                            x:Load="{x:Bind IsSubtaskCard, Mode=OneWay}"
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardParentLink_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind SubtaskOfText, Mode=OneWay}"
                            Click="OnCardParentLinkClick"
                            IsTabStop="False">
                            <TextBlock
                                MaxLines="2"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind SubtaskOfText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap" />
                        </HyperlinkButton>
                        <!-- Item 4: the effective title, or a Subtask card's Subtitle. -->
                        <TextBlock
                            MaxLines="3"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                        <!-- Item 5: neutral Service chip (only its icon is accent) and, on tasks, the Squad chip. -->
                        <local:BoardChipRow Visibility="{x:Bind common:BindFunctions.VisibleAny(IsTask, HasService, x:False), Mode=OneWay}">
                            <Border Style="{StaticResource NeutralChipStyle}" Visibility="{x:Bind common:BindFunctions.Visible(HasService), Mode=OneWay}">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <controls:ServiceIcon Foreground="{ThemeResource NeutralChipIconBrush}" />
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource NeutralChipTextStyle}"
                                        Text="{x:Bind Service, Mode=OneWay}" />
                                </Grid>
                            </Border>
                            <Border Style="{StaticResource NeutralChipStyle}" Visibility="{x:Bind common:BindFunctions.Visible(IsTask), Mode=OneWay}">
                                <Grid ColumnSpacing="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <!-- A hierarchy glyph (one box over two): no Segoe Fluent glyph matches, so it is a 16-unit vector. -->
                                    <Viewbox Width="12" Height="12" AutomationProperties.AccessibilityView="Raw">
                                        <PathIcon
                                            Width="16"
                                            Height="16"
                                            Data="F1 M5,0.5 H11 V5.5 H5 Z M6.25,1.75 V4.25 H9.75 V1.75 Z M7.375,5.5 H8.625 V7.375 H7.375 Z M2.375,7.375 H13.625 V8.625 H2.375 Z M2.375,8.625 H3.625 V10.5 H2.375 Z M12.375,8.625 H13.625 V10.5 H12.375 Z M0.5,10.5 H5.5 V15.5 H0.5 Z M1.75,11.75 V14.25 H4.25 V11.75 Z M10.5,10.5 H15.5 V15.5 H10.5 Z M11.75,11.75 V14.25 H14.25 V11.75 Z"
                                            Foreground="{ThemeResource NeutralChipForegroundBrush}" />
                                    </Viewbox>
                                    <TextBlock
                                        Grid.Column="1"
                                        Style="{StaticResource NeutralChipTextStyle}"
                                        Text="{x:Bind SquadText, Mode=OneWay}" />
                                </Grid>
                            </Border>
                        </local:BoardChipRow>
                        <!-- Item 6 (tasks): below a divider, the checklist on the left and the avatars on the right. -->
                        <Grid
                            x:Name="TaskChecklistRow"
                            x:Load="{x:Bind IsTask, Mode=OneWay}"
                            Padding="0,8,0,0"
                            BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                            BorderThickness="0,1,0,0"
                            ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <!-- The CheckList glyph, or a double check once every item is done (never color alone). -->
                            <FontIcon
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                FontSize="14"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE9D5;"
                                Visibility="{x:Bind common:BindFunctions.Visible(IsChecklistIncomplete), Mode=OneWay}" />
                            <Grid
                                Width="16"
                                Height="14"
                                VerticalAlignment="Center"
                                AutomationProperties.AccessibilityView="Raw"
                                Visibility="{x:Bind common:BindFunctions.Visible(IsChecklistComplete), Mode=OneWay}">
                                <FontIcon
                                    HorizontalAlignment="Left"
                                    FontSize="11"
                                    Glyph="&#xE73E;"
                                    Style="{StaticResource BoardChecklistCompleteGlyphStyle}" />
                                <FontIcon
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Glyph="&#xE73E;"
                                    Style="{StaticResource BoardChecklistCompleteGlyphStyle}" />
                            </Grid>
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{x:Bind local:BoardPageView.ChecklistTextStyle(IsChecklistComplete), Mode=OneWay}"
                                Text="{x:Bind ChecklistCountText, Mode=OneWay}"
                                Visibility="{x:Bind common:BindFunctions.Visible(HasChecklist), Mode=OneWay}" />
                            <!-- B-07: a task without checklist items shows muted text only, never an empty or full bar. -->
                            <ProgressBar
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardChecklistBar_', Key), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind ChecklistText, Mode=OneWay}"
                                Maximum="100"
                                Style="{x:Bind local:BoardPageView.ChecklistBarStyle(IsChecklistComplete), Mode=OneWay}"
                                Visibility="{x:Bind common:BindFunctions.Visible(HasChecklist), Mode=OneWay}"
                                Value="{x:Bind ChecklistPercent, Mode=OneWay}" />
                            <TextBlock
                                Grid.ColumnSpan="3"
                                VerticalAlignment="Center"
                                Style="{StaticResource BoardChecklistTextStyle}"
                                Text="{x:Bind ChecklistText, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                Visibility="{x:Bind common:BindFunctions.Collapsed(HasChecklist), Mode=OneWay}" />
                            <ItemsRepeater
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                ItemTemplate="{StaticResource CardPersonTemplate}"
                                ItemsSource="{x:Bind People, Mode=OneWay}"
                                Layout="{StaticResource CardPeopleLayout}" />
                        </Grid>
                        <!-- Subtask cards: the dates on the left and the avatar (the inherited CR Owner) on the right. -->
                        <Grid
                            x:Name="SubtaskFooterRow"
                            x:Load="{x:Bind IsSubtaskCard, Mode=OneWay}"
                            ColumnSpacing="8"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasSubtaskFooter), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind DatesText, Mode=OneWay}"
                                TextWrapping="Wrap" />
                            <ItemsRepeater
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                ItemTemplate="{StaticResource CardPersonTemplate}"
                                ItemsSource="{x:Bind People, Mode=OneWay}"
                                Layout="{StaticResource CardPeopleLayout}" />
                        </Grid>
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="BucketTemplate" x:DataType="local:BoardBucketViewModel">
            <Border
                Width="300"
                Margin="0,0,12,0"
                Padding="8,12,8,0"
                common:WheelScrolling.VerticalWheelScrollsHorizontally="True"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_Bucket_', StatusId.Value), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                Loaded="OnBucketLoaded"
                Style="{StaticResource SecondaryCardBorderStyle}"
                Unloaded="OnBucketUnloaded">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Margin="0,0,32,0"
                        Padding="4,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneWay}" />
                        <Border Style="{StaticResource AccentChipStyle}">
                            <TextBlock
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_BucketCount_', StatusId.Value), Mode=OneTime}"
                                Style="{StaticResource AccentChipTextStyle}"
                                Text="{x:Bind CountText, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <!-- Design §4.2: + creates a task in this bucket's status (B-02.1). -->
                    <Button
                        Padding="6,4"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_BucketAddButton_', StatusId.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind AddButtonName, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnBucketAddClick"
                        ToolTipService.ToolTip="{x:Bind AddButtonName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <!-- The bucket fills the viewport height, so this list is bounded and virtualizes (T-08). -->
                    <!--
                        Native ListView drag and drop (design §9) [gallery-listview-3]. The list never reorders its own
                        items: a drop runs a move command, and the card moves only after it committed (B-07).
                    -->
                    <local:BoardCardList
                        Grid.Row="1"
                        common:WheelScrolling.RoutesMouseWheel="True"
                        AllowDrop="True"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_BucketList_', StatusId.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="0"
                        CanDragItems="True"
                        CardInvoked="OnCardInvoked"
                        ContextRequested="OnCardContextRequested"
                        DragItemsCompleted="OnDragItemsCompleted"
                        DragItemsStarting="OnDragItemsStarting"
                        DragLeave="OnListDragLeave"
                        DragOver="OnListDragOver"
                        Drop="OnListDrop"
                        IsItemClickEnabled="True"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind Cards, Mode=OneTime}"
                        Loaded="OnListLoaded"
                        PreviewKeyDown="OnListPreviewKeyDown"
                        SelectionMode="None"
                        Unloaded="OnListUnloaded">
                        <!--
                            The hover, pressed and focus visuals match the card exactly. The rounded item chrome insets its
                            backplate by 4,2 from the container, so the container's Padding is that same 4,2 (the card fills
                            the backplate); BoardCardContainer gives the chrome the card's 8-epx corners. The 8-epx gap between
                            cards is the bottom padding, the margin and the next card's top padding (2 + 4 + 2), outside every visual.
                        -->
                        <local:BoardCardList.ItemContainerStyle>
                            <Style TargetType="local:BoardCardContainer">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,2" />
                                <Setter Property="Margin" Value="0,0,0,4" />
                                <Setter Property="MinHeight" Value="0" />
                                <Setter Property="FocusVisualMargin" Value="2,0" />
                            </Style>
                        </local:BoardCardList.ItemContainerStyle>
                    </local:BoardCardList>
                    <!--
                        Design §4.2 drop slot: an overlay over the list, never an item in it (cards move only after the
                        move commits, B-07). The view moves it to the slot under the pointer while a card is dragged.
                    -->
                    <Rectangle
                        Grid.Row="1"
                        Height="2"
                        Margin="4,0"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource BoardInsertionLineBrush}"
                        IsHitTestVisible="False"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="Collapsed">
                        <Rectangle.RenderTransform>
                            <TranslateTransform />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3): title, search and Filters (shared with the Grid, B-10), and the filter context row. -->
        <StackPanel
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="PageTitle"
                    x:Uid="Board_PageTitle"
                    AutomationProperties.AutomationId="Board_PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    AutomationProperties.AutomationId="Board_PageSubtitle"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Design §2.3: the search icon is last in the row and expands into the free space after it. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <filters:FilterButton PageKey="Board" Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
                    <controls:ExpandingSearchBox
                        x:Name="SearchBox"
                        x:Uid="Board_Search"
                        Grid.Column="1"
                        AutomationIdPrefix="Board"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                </Grid>
                <Button
                    x:Uid="Board_NewTaskButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Board_NewTaskButton"
                    Command="{x:Bind ViewModel.NewTaskCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="Board_NewTaskText" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Design §4.2 S: one bucket per viewport, chosen here or with the previous/next buttons. -->
            <Grid
                x:Name="BucketPickerRow"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="Board_PrevBucketButton"
                    AutomationProperties.AutomationId="Board_PrevBucketButton"
                    Command="{x:Bind ViewModel.PreviousBucketCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <ComboBox
                    x:Name="BucketPicker"
                    x:Uid="Board_BucketPickerCombo"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="Board_BucketPickerCombo"
                    ItemsSource="{x:Bind ViewModel.Buckets, Mode=OneTime}"
                    SelectionChanged="OnBucketPickerSelectionChanged" />
                <Button
                    x:Uid="Board_NextBucketButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="Board_NextBucketButton"
                    Command="{x:Bind ViewModel.NextBucketCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
            </Grid>
            <filters:FilterChipsBar
                x:Name="ChipsBar"
                PageKey="Board"
                Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
        </StackPanel>

        <controls:StateView
            x:Name="PageContent"
            x:Uid="Board_StateView"
            Grid.Row="1"
            PageKey="Board"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <!--
                Design §4.2: the page scrolls horizontally and each bucket scrolls vertically. AllowDrop and the
                transparent background only let drag events reach the scroller for edge auto-scroll; it accepts no drop.
            -->
            <ScrollViewer
                x:Name="BucketsScroller"
                common:WheelScrolling.RoutesMouseWheel="True"
                AllowDrop="True"
                Background="Transparent"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <ItemsControl
                    x:Name="BucketsHost"
                    Margin="32,0,20,12"
                    AutomationProperties.AutomationId="Board_Buckets"
                    IsTabStop="False"
                    ItemTemplate="{StaticResource BucketTemplate}"
                    ItemsSource="{x:Bind ViewModel.Buckets, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </controls:StateView>
    </Grid>
</UserControl>
