<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Board.BoardPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:filters="using:MaxPlanner.Presentation.Common.Filters"
    xmlns:local="using:MaxPlanner.Presentation.Board"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- Design §4.2 item 9: card people footer avatars sit side by side with a small gap, never overlapping. -->
        <StackLayout x:Key="CardPeopleLayout" Orientation="Horizontal" Spacing="4" />
        <DataTemplate x:Key="CardPersonTemplate" x:DataType="local:BoardCardPerson">
            <!-- Each avatar is its own tooltip target: the name, then the roles in secondary text (design §2.10). -->
            <controls:PersonAvatar
                AccessibleName="{x:Bind AccessibleName, Mode=OneTime}"
                AutomationProperties.AutomationId="{x:Bind AutomationId, Mode=OneTime}"
                Diameter="20"
                DisplayName="{x:Bind Name, Mode=OneTime}"
                IsDecorative="False">
                <controls:PersonAvatar.ToolTipContent>
                    <StackPanel>
                        <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind RolesText, Mode=OneTime}" />
                    </StackPanel>
                </controls:PersonAvatar.ToolTipContent>
            </controls:PersonAvatar>
        </DataTemplate>
        <!--
            One template for both card kinds, each loading only its own anatomy (design §4.2). Two templates through a
            selector made the virtualizing panel misestimate a long bucket while scrolling up, until it reached the first
            card and snapped the offset back by thousands of epx (the bucket jumped to the top).
        -->
        <DataTemplate x:Key="CardTemplate" x:DataType="local:BoardCardViewModel">
            <Grid>
                <!-- Design §4.2: a card being moved is dimmed and captioned "Moving" until the move is saved. -->
                <Border
                    x:Name="TaskCard"
                    x:Load="{x:Bind IsTask, Mode=OneWay}"
                    Margin="0,0,0,8"
                    Padding="12"
                    Opacity="{x:Bind local:BoardPageView.MovingOpacity(IsMoving), Mode=OneWay}"
                    Style="{StaticResource CardBorderStyle}">
                    <StackPanel Spacing="8">
                        <Grid ColumnSpacing="4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                MaxLines="3"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                            <Button
                                Grid.Column="1"
                                Padding="6,4"
                                VerticalAlignment="Top"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardMenuButton_', Key), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                                Background="Transparent"
                                BorderThickness="0"
                                Click="OnCardMenuButtonClick"
                                IsTabStop="False"
                                ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                                <FontIcon FontSize="14" Glyph="&#xE712;" />
                            </Button>
                        </Grid>
                        <TextBlock
                            x:Uid="Board_MovingCaption"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind common:BindFunctions.Visible(IsMoving), Mode=OneWay}" />
                        <Border
                            HorizontalAlignment="Left"
                            Style="{StaticResource AccentChipStyle}"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasService), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <controls:ServiceIcon Foreground="{ThemeResource AccentChipForegroundBrush}" />
                                <TextBlock Style="{StaticResource AccentChipTextStyle}" Text="{x:Bind Service, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <!-- Design §4.2 anatomy 3: the CR reference link opens the CR. -->
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardCrLink_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind OpenCrName, Mode=OneWay}"
                            Click="OnCardCrLinkClick"
                            IsTabStop="False"
                            ToolTipService.ToolTip="{x:Bind OpenCrName, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasCrReference), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE71B;" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CrReference, Mode=OneWay}" />
                            </StackPanel>
                        </HyperlinkButton>
                        <Grid ColumnSpacing="6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <!--
                                Design §4.2 item 4: an icon-only priority chip in the priority colour. Each level has its own
                                glyph, so colour is never the only cue, and the tooltip names it. It stretches to the Squad
                                chip height and is at least as wide, so it stays square-ish.
                            -->
                            <Border
                                MinWidth="22"
                                Padding="4,0"
                                VerticalAlignment="Stretch"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardPriority_', Key), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind PriorityName, Mode=OneWay}"
                                Style="{x:Bind local:BoardPageView.PriorityChipStyle(PriorityLevel), Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind PriorityName, Mode=OneWay}">
                                <FontIcon
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Glyph="{x:Bind local:BoardPageView.PriorityGlyph(PriorityLevel), Mode=OneWay}"
                                    Style="{StaticResource ChipGlyphStyle}" />
                            </Border>
                            <Border
                                Grid.Column="1"
                                HorizontalAlignment="Left"
                                Style="{StaticResource SquadChipStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <FontIcon Glyph="&#xE716;" Style="{StaticResource ChipGlyphStyle}" />
                                    <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind SquadText, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <StackPanel Spacing="4">
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind ChecklistText, Mode=OneWay}" />
                            <!-- B-07: a task without checklist items shows text only, never an empty or full bar. -->
                            <ProgressBar
                                AutomationProperties.Name="{x:Bind ChecklistText, Mode=OneWay}"
                                Maximum="100"
                                Visibility="{x:Bind common:BindFunctions.Visible(HasChecklist), Mode=OneWay}"
                                Value="{x:Bind ChecklistPercent, Mode=OneWay}" />
                        </StackPanel>
                        <!-- Design §4.2 items 7 and 9: the Subtask cards count on the left, the people footer on the right. -->
                        <Grid ColumnSpacing="8" Visibility="{x:Bind common:BindFunctions.Visible(HasTaskFooter), Mode=OneWay}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel
                                VerticalAlignment="Center"
                                Orientation="Horizontal"
                                Spacing="6"
                                Visibility="{x:Bind common:BindFunctions.Visible(HasSubtaskCards), Mode=OneWay}">
                                <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SubtaskCardsText, Mode=OneWay}" />
                            </StackPanel>
                            <ItemsRepeater
                                Grid.Column="1"
                                ItemTemplate="{StaticResource CardPersonTemplate}"
                                ItemsSource="{x:Bind People, Mode=OneWay}"
                                Layout="{StaticResource CardPeopleLayout}" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- Design §4.2: a 3-epx left border and the Subtask glyph distinguish the kind without color. -->
                <Border
                    x:Name="SubtaskCard"
                    x:Load="{x:Bind IsSubtaskCard, Mode=OneWay}"
                    Margin="0,0,0,8"
                    Opacity="{x:Bind local:BoardPageView.MovingOpacity(IsMoving), Mode=OneWay}"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            Grid.Column="2"
                            Margin="0,8,8,0"
                            Padding="6,4"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardMenuButton_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardMenuButtonClick"
                            IsTabStop="False"
                            ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                        <Border Background="{ThemeResource SubtaskCardAccentBrush}" CornerRadius="8,0,0,8" />
                        <StackPanel
                            Grid.Column="1"
                            Padding="12"
                            Spacing="6">
                            <!-- B-16.5: the "Subtask of" indicator opens the parent. -->
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardParentLink_', Key), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind SubtaskOfText, Mode=OneWay}"
                                Click="OnCardParentLinkClick"
                                IsTabStop="False">
                                <StackPanel Orientation="Horizontal" Spacing="6">
                                    <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                                    <TextBlock
                                        MaxLines="2"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind SubtaskOfText, Mode=OneWay}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </HyperlinkButton>
                            <Border
                                HorizontalAlignment="Left"
                                Style="{StaticResource AccentChipStyle}"
                                Visibility="{x:Bind common:BindFunctions.Visible(HasService), Mode=OneWay}">
                                <StackPanel Orientation="Horizontal" Spacing="4">
                                    <controls:ServiceIcon Foreground="{ThemeResource AccentChipForegroundBrush}" />
                                    <TextBlock Style="{StaticResource AccentChipTextStyle}" Text="{x:Bind Service, Mode=OneWay}" />
                                </StackPanel>
                            </Border>
                            <HyperlinkButton
                                Padding="0"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardCrLink_', Key), Mode=OneTime}"
                                AutomationProperties.Name="{x:Bind OpenCrName, Mode=OneWay}"
                                Click="OnCardCrLinkClick"
                                IsTabStop="False"
                                ToolTipService.ToolTip="{x:Bind OpenCrName, Mode=OneWay}"
                                Visibility="{x:Bind common:BindFunctions.Visible(HasCrReference), Mode=OneWay}">
                                <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CrReference, Mode=OneWay}" />
                            </HyperlinkButton>
                            <TextBlock
                                MaxLines="3"
                                Style="{StaticResource BodyStrongTextBlockStyle}"
                                Text="{x:Bind Title, Mode=OneWay}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="Wrap"
                                ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                            <TextBlock
                                x:Uid="Board_MovingCaption"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Visibility="{x:Bind common:BindFunctions.Visible(IsMoving), Mode=OneWay}" />
                            <!-- Design §4.2: dates on the left, the people footer (inherited CR Owner) on the right. -->
                            <Grid ColumnSpacing="8" Visibility="{x:Bind common:BindFunctions.Visible(HasSubtaskFooter), Mode=OneWay}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind DatesText, Mode=OneWay}"
                                    TextWrapping="Wrap" />
                                <ItemsRepeater
                                    Grid.Column="1"
                                    ItemTemplate="{StaticResource CardPersonTemplate}"
                                    ItemsSource="{x:Bind People, Mode=OneWay}"
                                    Layout="{StaticResource CardPeopleLayout}" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="BucketTemplate" x:DataType="local:BoardBucketViewModel">
            <Border
                Width="300"
                Margin="0,0,12,0"
                Padding="8,12,8,0"
                common:WheelScrolling.VerticalWheelScrollsHorizontally="True"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_Bucket_', StatusId.Value), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                Loaded="OnBucketLoaded"
                Style="{StaticResource SecondaryCardBorderStyle}"
                Unloaded="OnBucketUnloaded">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Margin="0,0,32,0"
                        Padding="4,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneWay}" />
                        <Border Style="{StaticResource AccentChipStyle}">
                            <TextBlock
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_BucketCount_', StatusId.Value), Mode=OneTime}"
                                Style="{StaticResource AccentChipTextStyle}"
                                Text="{x:Bind CountText, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <!-- Design §4.2: + creates a task in this bucket's status (B-02.1). -->
                    <Button
                        Padding="6,4"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_BucketAddButton_', StatusId.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind AddButtonName, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnBucketAddClick"
                        ToolTipService.ToolTip="{x:Bind AddButtonName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <!-- The bucket fills the viewport height, so this list is bounded and virtualizes (T-08). -->
                    <!--
                        Native ListView drag and drop (design §9) [gallery-listview-3]. The list never reorders its own
                        items: a drop runs a move command, and the card moves only after it committed (B-07).
                    -->
                    <local:BoardCardList
                        Grid.Row="1"
                        common:WheelScrolling.RoutesMouseWheel="True"
                        AllowDrop="True"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_BucketList_', StatusId.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="0"
                        CanDragItems="True"
                        CardInvoked="OnCardInvoked"
                        ContextRequested="OnCardContextRequested"
                        DragItemsCompleted="OnDragItemsCompleted"
                        DragItemsStarting="OnDragItemsStarting"
                        DragLeave="OnListDragLeave"
                        DragOver="OnListDragOver"
                        Drop="OnListDrop"
                        IsItemClickEnabled="True"
                        ItemTemplate="{StaticResource CardTemplate}"
                        ItemsSource="{x:Bind Cards, Mode=OneTime}"
                        Loaded="OnListLoaded"
                        PreviewKeyDown="OnListPreviewKeyDown"
                        SelectionMode="None"
                        Unloaded="OnListUnloaded">
                        <local:BoardCardList.ItemContainerStyle>
                            <Style TargetType="local:BoardCardContainer">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </local:BoardCardList.ItemContainerStyle>
                    </local:BoardCardList>
                    <!--
                        Design §4.2 drop slot: an overlay over the list, never an item in it (cards move only after the
                        move commits, B-07). The view moves it to the slot under the pointer while a card is dragged.
                    -->
                    <Rectangle
                        Grid.Row="1"
                        Height="2"
                        Margin="4,0"
                        VerticalAlignment="Top"
                        Fill="{ThemeResource BoardInsertionLineBrush}"
                        IsHitTestVisible="False"
                        RadiusX="1"
                        RadiusY="1"
                        Visibility="Collapsed">
                        <Rectangle.RenderTransform>
                            <TranslateTransform />
                        </Rectangle.RenderTransform>
                    </Rectangle>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3): title, search and Filters (shared with the Grid, B-10), and the filter context row. -->
        <StackPanel
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="PageTitle"
                    x:Uid="Board_PageTitle"
                    AutomationProperties.AutomationId="Board_PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    AutomationProperties.AutomationId="Board_PageSubtitle"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!-- Design §2.3: the search icon is last in the row and expands into the free space after it. -->
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <filters:FilterButton PageKey="Board" Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
                    <controls:ExpandingSearchBox
                        x:Name="SearchBox"
                        x:Uid="Board_Search"
                        Grid.Column="1"
                        AutomationIdPrefix="Board"
                        Text="{x:Bind ViewModel.SearchText, Mode=TwoWay}" />
                </Grid>
                <Button
                    x:Uid="Board_NewTaskButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Board_NewTaskButton"
                    Command="{x:Bind ViewModel.NewTaskCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="Board_NewTaskText" />
                    </StackPanel>
                </Button>
            </Grid>
            <!-- Design §4.2 S: one bucket per viewport, chosen here or with the previous/next buttons. -->
            <Grid
                x:Name="BucketPickerRow"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="Board_PrevBucketButton"
                    AutomationProperties.AutomationId="Board_PrevBucketButton"
                    Command="{x:Bind ViewModel.PreviousBucketCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <ComboBox
                    x:Name="BucketPicker"
                    x:Uid="Board_BucketPickerCombo"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="Board_BucketPickerCombo"
                    ItemsSource="{x:Bind ViewModel.Buckets, Mode=OneTime}"
                    SelectionChanged="OnBucketPickerSelectionChanged" />
                <Button
                    x:Uid="Board_NextBucketButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="Board_NextBucketButton"
                    Command="{x:Bind ViewModel.NextBucketCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
            </Grid>
            <filters:FilterChipsBar
                x:Name="ChipsBar"
                PageKey="Board"
                Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
        </StackPanel>

        <controls:StateView
            x:Name="PageContent"
            x:Uid="Board_StateView"
            Grid.Row="1"
            PageKey="Board"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <!--
                Design §4.2: the page scrolls horizontally and each bucket scrolls vertically. AllowDrop and the
                transparent background only let drag events reach the scroller for edge auto-scroll; it accepts no drop.
            -->
            <ScrollViewer
                x:Name="BucketsScroller"
                common:WheelScrolling.RoutesMouseWheel="True"
                AllowDrop="True"
                Background="Transparent"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <ItemsControl
                    x:Name="BucketsHost"
                    Margin="32,0,20,12"
                    AutomationProperties.AutomationId="Board_Buckets"
                    IsTabStop="False"
                    ItemTemplate="{StaticResource BucketTemplate}"
                    ItemsSource="{x:Bind ViewModel.Buckets, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </controls:StateView>
    </Grid>
</UserControl>
