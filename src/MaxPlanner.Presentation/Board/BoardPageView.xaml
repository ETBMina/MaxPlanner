<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Board.BoardPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Board"
    IsTabStop="False">
    <UserControl.Resources>
        <DataTemplate x:Key="TaskCardTemplate" x:DataType="local:BoardCardViewModel">
            <!-- Design §4.2: a card being moved is dimmed and captioned "Moving" until the move is saved. -->
            <Border
                Margin="0,0,0,8"
                Padding="12"
                Opacity="{x:Bind local:BoardPageView.MovingOpacity(IsMoving), Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            MaxLines="3"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                        <Button
                            Grid.Column="1"
                            Padding="6,4"
                            VerticalAlignment="Top"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardMenuButton_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                            Background="Transparent"
                            BorderThickness="0"
                            Click="OnCardMenuButtonClick"
                            IsTabStop="False"
                            ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        x:Uid="Board_MovingCaption"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(IsMoving), Mode=OneWay}" />
                    <Border
                        HorizontalAlignment="Left"
                        Style="{StaticResource ServiceChipStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasService), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE90F;" Style="{StaticResource ChipGlyphStyle}" />
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind Service, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <!-- Design §4.2 anatomy 3: the CR reference link opens the CR. -->
                    <HyperlinkButton
                        Padding="0"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardCrLink_', Key), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind OpenCrName, Mode=OneWay}"
                        Click="OnCardCrLinkClick"
                        IsTabStop="False"
                        ToolTipService.ToolTip="{x:Bind OpenCrName, Mode=OneWay}"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasCrReference), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="6">
                            <FontIcon FontSize="12" Glyph="&#xE71B;" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CrReference, Mode=OneWay}" />
                        </StackPanel>
                    </HyperlinkButton>
                    <Grid ColumnSpacing="6" RowSpacing="6">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <!-- Priority chip by configured rank (design §6.1); its text names the priority, so color is never the only cue. -->
                        <Border
                            AutomationProperties.Name="{x:Bind PriorityName, Mode=OneWay}"
                            Style="{x:Bind local:BoardPageView.PriorityChipStyle(PriorityLevel), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="{x:Bind local:BoardPageView.PriorityGlyph(PriorityLevel), Mode=OneWay}" Style="{StaticResource ChipGlyphStyle}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind PriorityText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <Border
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            Style="{StaticResource SquadChipStyle}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE716;" Style="{StaticResource ChipGlyphStyle}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind SquadText, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <StackPanel
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasOwner), Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE77B;" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind OwnerText, Mode=OneWay}" />
                        </StackPanel>
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ChecklistText, Mode=OneWay}" />
                        <!-- B-07: a task without checklist items shows text only, never an empty or full bar. -->
                        <ProgressBar
                            AutomationProperties.Name="{x:Bind ChecklistText, Mode=OneWay}"
                            Maximum="100"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasChecklist), Mode=OneWay}"
                            Value="{x:Bind ChecklistPercent, Mode=OneWay}" />
                    </StackPanel>
                    <StackPanel
                        Orientation="Horizontal"
                        Spacing="6"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasSubtaskCards), Mode=OneWay}">
                        <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                        <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind SubtaskCardsText, Mode=OneWay}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="SubtaskCardTemplate" x:DataType="local:BoardCardViewModel">
            <!-- Design §4.2: a 3-epx left border and the Subtask glyph distinguish the kind without color. -->
            <Border
                Margin="0,0,0,8"
                Opacity="{x:Bind local:BoardPageView.MovingOpacity(IsMoving), Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="3" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Grid.Column="2"
                        Margin="0,8,8,0"
                        Padding="6,4"
                        VerticalAlignment="Top"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardMenuButton_', Key), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnCardMenuButtonClick"
                        IsTabStop="False"
                        ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE712;" />
                    </Button>
                    <Border Background="{ThemeResource SubtaskCardAccentBrush}" CornerRadius="8,0,0,8" />
                    <StackPanel
                        Grid.Column="1"
                        Padding="12"
                        Spacing="6">
                        <!-- B-16.5: the "Subtask of" indicator opens the parent. -->
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardParentLink_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind SubtaskOfText, Mode=OneWay}"
                            Click="OnCardParentLinkClick"
                            IsTabStop="False">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <FontIcon FontSize="12" Glyph="&#xE8FD;" />
                                <TextBlock
                                    MaxLines="2"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind SubtaskOfText, Mode=OneWay}"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </HyperlinkButton>
                        <Border
                            HorizontalAlignment="Left"
                            Style="{StaticResource ServiceChipStyle}"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasService), Mode=OneWay}">
                            <StackPanel Orientation="Horizontal" Spacing="4">
                                <FontIcon Glyph="&#xE90F;" Style="{StaticResource ChipGlyphStyle}" />
                                <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind Service, Mode=OneWay}" />
                            </StackPanel>
                        </Border>
                        <HyperlinkButton
                            Padding="0"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_CardCrLink_', Key), Mode=OneTime}"
                            AutomationProperties.Name="{x:Bind OpenCrName, Mode=OneWay}"
                            Click="OnCardCrLinkClick"
                            IsTabStop="False"
                            ToolTipService.ToolTip="{x:Bind OpenCrName, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasCrReference), Mode=OneWay}">
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind CrReference, Mode=OneWay}" />
                        </HyperlinkButton>
                        <TextBlock
                            MaxLines="3"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="Wrap"
                            ToolTipService.ToolTip="{x:Bind Title, Mode=OneWay}" />
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasOwner), Mode=OneWay}">
                            <FontIcon FontSize="12" Glyph="&#xE77B;" />
                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind OwnerText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind DatesText, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Visible(HasDates), Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Board_MovingCaption"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Visibility="{x:Bind common:BindFunctions.Visible(IsMoving), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <local:BoardCardTemplateSelector
            x:Key="CardTemplateSelector"
            SubtaskTemplate="{StaticResource SubtaskCardTemplate}"
            TaskTemplate="{StaticResource TaskCardTemplate}" />

        <DataTemplate x:Key="ColumnTemplate" x:DataType="local:BoardColumnViewModel">
            <Border
                Width="300"
                Margin="0,0,12,0"
                Padding="8,12,8,0"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_Column_', StatusId.Value), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind Name, Mode=OneWay}"
                Loaded="OnColumnLoaded"
                Style="{StaticResource SecondaryCardBorderStyle}"
                Unloaded="OnColumnUnloaded">
                <Grid RowSpacing="8">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <StackPanel
                        Margin="0,0,32,0"
                        Padding="4,0"
                        Orientation="Horizontal"
                        Spacing="8">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Glyph="{x:Bind Glyph, Mode=OneWay}" />
                        <TextBlock
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind Name, Mode=OneWay}" />
                        <Border Style="{StaticResource CountChipStyle}">
                            <TextBlock
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_ColumnCount_', StatusId.Value), Mode=OneTime}"
                                Style="{StaticResource ChipTextStyle}"
                                Text="{x:Bind CountText, Mode=OneWay}" />
                        </Border>
                    </StackPanel>
                    <!-- Design §4.2: + creates a task in this column's status (B-02.1). -->
                    <Button
                        Padding="6,4"
                        HorizontalAlignment="Right"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_ColumnAddButton_', StatusId.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind AddButtonName, Mode=OneWay}"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnColumnAddClick"
                        ToolTipService.ToolTip="{x:Bind AddButtonName, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                    </Button>
                    <!-- The column fills the viewport height, so this list is bounded and virtualizes (T-08). -->
                    <!--
                        Native ListView drag and drop (design §9) [gallery-listview-3]. The list never reorders its own
                        items: a drop runs a move command, and the card moves only after it committed (B-07).
                    -->
                    <local:BoardCardList
                        Grid.Row="1"
                        AllowDrop="True"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Board_ColumnList_', StatusId.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                        BorderBrush="{ThemeResource AccentFillColorDefaultBrush}"
                        BorderThickness="0"
                        CanDragItems="True"
                        ContextRequested="OnCardContextRequested"
                        DragItemsCompleted="OnDragItemsCompleted"
                        DragItemsStarting="OnDragItemsStarting"
                        DragLeave="OnListDragLeave"
                        DragOver="OnListDragOver"
                        Drop="OnListDrop"
                        ItemTemplateSelector="{StaticResource CardTemplateSelector}"
                        ItemsSource="{x:Bind Cards, Mode=OneTime}"
                        Loaded="OnListLoaded"
                        PreviewKeyDown="OnListPreviewKeyDown"
                        SelectionMode="None"
                        Unloaded="OnListUnloaded">
                        <local:BoardCardList.ItemContainerStyle>
                            <Style TargetType="local:BoardCardContainer">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="4,0" />
                                <Setter Property="Margin" Value="0" />
                            </Style>
                        </local:BoardCardList.ItemContainerStyle>
                    </local:BoardCardList>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3). The shared Filters flyout and CommandBar arrive with Phase 11. -->
        <StackPanel
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="PageTitle"
                    x:Uid="Board_PageTitle"
                    AutomationProperties.AutomationId="Board_PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    AutomationProperties.AutomationId="Board_PageSubtitle"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <Grid ColumnSpacing="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="Board_SearchBox"
                    MinWidth="200"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="Board_SearchBox"
                    AutomationProperties.LandmarkType="Search"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <Button
                    x:Uid="Board_NewTaskButton"
                    Grid.Column="1"
                    AutomationProperties.AutomationId="Board_NewTaskButton"
                    Command="{x:Bind ViewModel.NewTaskCommand}"
                    Style="{StaticResource AccentButtonStyle}">
                    <Button.KeyboardAccelerators>
                        <KeyboardAccelerator Key="N" Modifiers="Control" />
                    </Button.KeyboardAccelerators>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE710;" />
                        <TextBlock x:Uid="Board_NewTaskText" />
                    </StackPanel>
                </Button>
                <!--
                    Overflow-only CommandBar (design §2.4). "New CR" is interim here until the Calendar page
                    (Phase 7), the CR editor's home (B-03.1); remove it then.
                -->
                <CommandBar
                    Grid.Column="2"
                    VerticalAlignment="Center"
                    AutomationProperties.AutomationId="Board_CommandBar"
                    Background="Transparent"
                    DefaultLabelPosition="Right"
                    IsDynamicOverflowEnabled="False">
                    <CommandBar.SecondaryCommands>
                        <AppBarButton
                            x:Uid="Board_NewCrButton"
                            AutomationProperties.AutomationId="Board_NewCrButton"
                            Command="{x:Bind ViewModel.NewChangeRequestCommand}">
                            <AppBarButton.Icon>
                                <FontIcon Glyph="&#xE710;" />
                            </AppBarButton.Icon>
                        </AppBarButton>
                    </CommandBar.SecondaryCommands>
                </CommandBar>
            </Grid>
            <!-- Design §4.2 S: one column per viewport, chosen here or with the previous/next buttons. -->
            <Grid
                x:Name="ColumnPickerRow"
                ColumnSpacing="8"
                Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button
                    x:Uid="Board_PrevColumnButton"
                    AutomationProperties.AutomationId="Board_PrevColumnButton"
                    Command="{x:Bind ViewModel.PreviousColumnCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE76B;" />
                </Button>
                <ComboBox
                    x:Name="ColumnPicker"
                    x:Uid="Board_ColumnPickerCombo"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    AutomationProperties.AutomationId="Board_ColumnPickerCombo"
                    ItemsSource="{x:Bind ViewModel.Columns, Mode=OneTime}"
                    SelectionChanged="OnColumnPickerSelectionChanged" />
                <Button
                    x:Uid="Board_NextColumnButton"
                    Grid.Column="2"
                    AutomationProperties.AutomationId="Board_NextColumnButton"
                    Command="{x:Bind ViewModel.NextColumnCommand}">
                    <FontIcon FontSize="12" Glyph="&#xE76C;" />
                </Button>
            </Grid>
            <!-- Design §4.2 filtered mode: reordering is off; a status move appends to the end (B-07). -->
            <InfoBar
                x:Uid="Board_FilteredInfoBar"
                AutomationProperties.AutomationId="Board_FilteredInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsFiltered, Mode=OneWay}"
                Severity="Informational">
                <InfoBar.ActionButton>
                    <Button
                        x:Uid="Board_ClearSearchButton"
                        AutomationProperties.AutomationId="Board_ClearAllFiltersLink"
                        Command="{x:Bind ViewModel.ClearSearchCommand}" />
                </InfoBar.ActionButton>
            </InfoBar>
        </StackPanel>

        <controls:StateView
            x:Uid="Board_StateView"
            Grid.Row="1"
            PageKey="Board"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <!-- Design §4.2: the page scrolls horizontally and each column scrolls vertically. -->
            <ScrollViewer
                x:Name="ColumnsScroller"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Enabled"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <ItemsControl
                    x:Name="ColumnsHost"
                    Margin="32,0,20,12"
                    AutomationProperties.AutomationId="Board_Columns"
                    IsTabStop="False"
                    ItemTemplate="{StaticResource ColumnTemplate}"
                    ItemsSource="{x:Bind ViewModel.Columns, Mode=OneTime}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </ScrollViewer>
        </controls:StateView>
    </Grid>
</UserControl>
