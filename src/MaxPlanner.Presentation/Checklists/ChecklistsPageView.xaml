<?xml version="1.0" encoding="utf-8"?>
<!--
    Checklists page (design §4.5, B-09, B-17): SelectorBar Checklists · Reviews [gallery-selectorbar-1], the
    General to-dos card and task groups in a virtualizing ItemsRepeater [gallery-itemsrepeater-2] with the
    variable-height ColumnPackingLayout, and the Reviews ListView with a Completed Expander [gallery-expander-1].
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Checklists.ChecklistsPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Checklists"
    IsTabStop="False">
    <UserControl.Resources>
        <!--
            Item row (design §4.5): CheckBox with the text, inline rename (F2 / double-click), and the ⋯ menu.
            Completed items show strikethrough and sit in the Completed section, so color is never the only cue.
        -->
        <DataTemplate x:Key="ItemTemplate" x:DataType="local:ChecklistItemViewModel">
            <Grid ColumnSpacing="4" Tag="{x:Bind Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemCheck_', Id), Mode=OneTime}"
                    AutomationProperties.HelpText="{x:Bind HelpText, Mode=OneTime}"
                    Checked="OnItemToggled"
                    DoubleTapped="OnItemDoubleTapped"
                    IsChecked="{x:Bind IsChecked, Mode=OneWay}"
                    IsEnabled="{x:Bind common:BindFunctions.Not(IsPending), Mode=OneWay}"
                    KeyDown="OnItemKeyDown"
                    Tag="{x:Bind Mode=OneTime}"
                    Unchecked="OnItemToggled"
                    Visibility="{x:Bind common:BindFunctions.Collapsed(IsRenaming), Mode=OneWay}">
                    <TextBlock
                        Foreground="{x:Bind local:ChecklistsPageView.ItemForeground(IsChecked), Mode=OneWay}"
                        Text="{x:Bind Text, Mode=OneWay}"
                        TextDecorations="{x:Bind local:ChecklistsPageView.Strike(IsChecked), Mode=OneWay}"
                        TextWrapping="Wrap" />
                </CheckBox>
                <StackPanel Spacing="2" Visibility="{x:Bind common:BindFunctions.Visible(IsRenaming), Mode=OneWay}">
                    <TextBox
                        x:Uid="Checklists_RenameBox"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_RenameBox_', Id), Mode=OneTime}"
                        KeyDown="OnRenameKeyDown"
                        LostFocus="OnRenameLostFocus"
                        MaxLength="2000"
                        Tag="{x:Bind Mode=OneTime}"
                        Text="{x:Bind RenameText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <TextBlock
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource ErrorTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind RenameError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasRenameError), Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    Padding="6,4"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemMenuButton_', Id), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Opening="OnItemMenuOpening">
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemRename"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemRenameItem_', Id), Mode=OneTime}"
                                Click="OnRenameClick"
                                Tag="{x:Bind Mode=OneTime}" />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemPopOut"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemPopOutItem_', Id), Mode=OneTime}"
                                Command="{x:Bind PopOutCommand}"
                                Visibility="{x:Bind common:BindFunctions.Visible(CanPopOut), Mode=OneTime}" />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemMoveUp"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemMoveUpItem_', Id), Mode=OneTime}"
                                Command="{x:Bind MoveUpCommand}" />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemMoveDown"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemMoveDownItem_', Id), Mode=OneTime}"
                                Command="{x:Bind MoveDownCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemDelete"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ItemDeleteItem_', Id), Mode=OneTime}"
                                Click="OnDeleteItemClick"
                                Tag="{x:Bind Mode=OneTime}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>

        <!-- General to-dos card (design §4.5): always present and first. -->
        <DataTemplate x:Key="GeneralTemplate" x:DataType="local:GeneralTodosViewModel">
            <Border
                Padding="16"
                AutomationProperties.AutomationId="Checklists_GeneralGroup"
                Style="{StaticResource CardBorderStyle}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Glyph="&#xE9D5;" />
                        <TextBlock
                            x:Uid="Checklists_GeneralTitle"
                            AutomationProperties.HeadingLevel="Level2"
                            Style="{StaticResource BodyStrongTextBlockStyle}" />
                    </StackPanel>
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.AutomationId="Checklists_Progress_General"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ProgressText, Mode=OneWay}" />
                        <ProgressBar
                            AutomationProperties.Name="{x:Bind ProgressText, Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ProgressPercent, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource ErrorTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ActionError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasActionError), Mode=OneWay}" />
                    <ItemsRepeater ItemTemplate="{StaticResource ItemTemplate}" ItemsSource="{x:Bind OpenItems, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Grid ColumnSpacing="8" Tag="{x:Bind Mode=OneTime}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Uid="Checklists_AddItemBox"
                            AutomationProperties.AutomationId="Checklists_AddItemBox_General"
                            IsEnabled="{x:Bind common:BindFunctions.Not(IsAdding), Mode=OneWay}"
                            KeyDown="OnGeneralAddBoxKeyDown"
                            MaxLength="2000"
                            Tag="{x:Bind Mode=OneTime}"
                            Text="{x:Bind NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Uid="Checklists_AddItemButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="Checklists_AddItemButton_General"
                            Command="{x:Bind AddItemCommand}">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        AutomationProperties.AutomationId="Checklists_AddItemError_General"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource ErrorTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind NewItemError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasNewItemError), Mode=OneWay}" />
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="Checklists_CompletedExpander_General"
                        Header="{x:Bind CompletedHeader, Mode=OneWay}"
                        IsExpanded="False"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasCompleted), Mode=OneWay}">
                        <ItemsRepeater ItemTemplate="{StaticResource ItemTemplate}" ItemsSource="{x:Bind CompletedItems, Mode=OneTime}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="GroupTemplate" x:DataType="local:ChecklistGroupViewModel">
            <Border
                Padding="16"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_TaskGroup_', Key.Value), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind Title, Mode=OneWay}"
                Style="{StaticResource CardBorderStyle}"
                Tag="{x:Bind Mode=OneTime}">
                <StackPanel Spacing="8">
                    <TextBlock
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_GroupTitle_', Key.Value), Mode=OneTime}"
                        AutomationProperties.HeadingLevel="Level2"
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <Border
                        HorizontalAlignment="Left"
                        Style="{StaticResource ServiceChipStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasService), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="4">
                            <FontIcon Glyph="&#xE90F;" Style="{StaticResource ChipGlyphStyle}" />
                            <TextBlock Style="{StaticResource ChipTextStyle}" Text="{x:Bind Service, Mode=OneWay}" />
                        </StackPanel>
                    </Border>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Reference, Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <!-- B-09: each task group offers Open task (design §4.5). -->
                    <HyperlinkButton
                        x:Uid="Checklists_OpenTaskLink"
                        Padding="0"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_OpenTaskLink_', Key.Value), Mode=OneTime}"
                        AutomationProperties.Name="{x:Bind OpenTaskName, Mode=OneWay}"
                        Command="{x:Bind OpenTaskCommand}" />
                    <StackPanel Spacing="4">
                        <TextBlock
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_Progress_', Key.Value), Mode=OneTime}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ProgressText, Mode=OneWay}" />
                        <ProgressBar
                            AutomationProperties.Name="{x:Bind ProgressText, Mode=OneWay}"
                            Maximum="100"
                            Value="{x:Bind ProgressPercent, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource ErrorTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ToggleError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasToggleError), Mode=OneWay}" />
                    <ItemsRepeater ItemTemplate="{StaticResource ItemTemplate}" ItemsSource="{x:Bind OpenItems, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="2" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Grid ColumnSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            x:Uid="Checklists_AddItemBox"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_AddItemBox_', Key.Value), Mode=OneTime}"
                            IsEnabled="{x:Bind common:BindFunctions.Not(IsAdding), Mode=OneWay}"
                            KeyDown="OnGroupAddBoxKeyDown"
                            MaxLength="2000"
                            Tag="{x:Bind Mode=OneTime}"
                            Text="{x:Bind NewItemText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <Button
                            x:Uid="Checklists_AddItemButton"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_AddItemButton_', Key.Value), Mode=OneTime}"
                            Command="{x:Bind AddItemCommand}">
                            <FontIcon FontSize="16" Glyph="&#xE710;" />
                        </Button>
                    </Grid>
                    <TextBlock
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_AddItemError_', Key.Value), Mode=OneTime}"
                        AutomationProperties.LiveSetting="Assertive"
                        Foreground="{ThemeResource ErrorTextBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind NewItemError, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasNewItemError), Mode=OneWay}" />
                    <Expander
                        HorizontalAlignment="Stretch"
                        HorizontalContentAlignment="Stretch"
                        AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_CompletedExpander_', Key.Value), Mode=OneTime}"
                        Header="{x:Bind CompletedHeader, Mode=OneWay}"
                        IsExpanded="False"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasCompleted), Mode=OneWay}">
                        <ItemsRepeater ItemTemplate="{StaticResource ItemTemplate}" ItemsSource="{x:Bind CompletedItems, Mode=OneTime}">
                            <ItemsRepeater.Layout>
                                <StackLayout Spacing="2" />
                            </ItemsRepeater.Layout>
                        </ItemsRepeater>
                    </Expander>
                </StackPanel>
            </Border>
        </DataTemplate>

        <local:ChecklistCardTemplateSelector
            x:Key="CardTemplateSelector"
            GeneralTemplate="{StaticResource GeneralTemplate}"
            GroupTemplate="{StaticResource GroupTemplate}" />

        <!-- One line per review (B-17.2): Done, Title, and the reference as plain text, plus ⋯. -->
        <DataTemplate x:Key="ReviewTemplate" x:DataType="local:ReviewRowViewModel">
            <Grid
                Padding="0,4"
                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewRow_', Id), Mode=OneTime}"
                AutomationProperties.Name="{x:Bind AccessibleName, Mode=OneWay}"
                ColumnSpacing="8"
                Tag="{x:Bind Mode=OneTime}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    MinWidth="0"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewCheck_', Id), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind CheckName, Mode=OneWay}"
                    Checked="OnReviewToggled"
                    IsChecked="{x:Bind IsDone, Mode=OneWay}"
                    IsEnabled="{x:Bind common:BindFunctions.Not(IsPending), Mode=OneWay}"
                    Tag="{x:Bind Mode=OneTime}"
                    Unchecked="OnReviewToggled" />
                <StackPanel Grid.Column="1" VerticalAlignment="Center" Spacing="2">
                    <TextBlock
                        Text="{x:Bind Title, Mode=OneWay}"
                        TextDecorations="{x:Bind local:ChecklistsPageView.Strike(IsDone), Mode=OneWay}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Reference, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind common:BindFunctions.Visible(HasReference), Mode=OneWay}" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind DoneText, Mode=OneWay}"
                        Visibility="{x:Bind common:BindFunctions.Visible(IsDone), Mode=OneWay}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Padding="6,4"
                    VerticalAlignment="Top"
                    AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewMenuButton_', Id), Mode=OneTime}"
                    AutomationProperties.Name="{x:Bind MenuButtonName, Mode=OneWay}"
                    Background="Transparent"
                    BorderThickness="0"
                    ToolTipService.ToolTip="{x:Bind MenuButtonName, Mode=OneWay}">
                    <FontIcon FontSize="14" Glyph="&#xE712;" />
                    <Button.Flyout>
                        <MenuFlyout Opening="OnItemMenuOpening">
                            <MenuFlyoutItem
                                x:Uid="Checklists_ReviewEdit"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewEditItem_', Id), Mode=OneTime}"
                                Click="OnReviewEditClick"
                                Tag="{x:Bind Mode=OneTime}" />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemMoveUp"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewMoveUpItem_', Id), Mode=OneTime}"
                                Command="{x:Bind MoveUpCommand}" />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemMoveDown"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewMoveDownItem_', Id), Mode=OneTime}"
                                Command="{x:Bind MoveDownCommand}" />
                            <MenuFlyoutSeparator />
                            <MenuFlyoutItem
                                x:Uid="Checklists_ItemDelete"
                                AutomationProperties.AutomationId="{x:Bind common:BindFunctions.RecordId('Checklists_ReviewDeleteItem_', Id), Mode=OneTime}"
                                Click="OnReviewDeleteClick"
                                Tag="{x:Bind Mode=OneTime}" />
                        </MenuFlyout>
                    </Button.Flyout>
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3, §4.5). -->
        <StackPanel
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            Spacing="8">
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="PageTitle"
                    x:Uid="Checklists_PageTitle"
                    AutomationProperties.AutomationId="Checklists_PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock
                    AutomationProperties.AutomationId="Checklists_PageSubtitle"
                    Style="{StaticResource PageSubtitleTextStyle}"
                    Text="{x:Bind ViewModel.Summary, Mode=OneWay}" />
            </StackPanel>
            <Grid ColumnSpacing="12" RowSpacing="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <SelectorBar
                    x:Name="SectionBar"
                    AutomationProperties.AutomationId="Checklists_SectionBar"
                    SelectionChanged="OnSectionChanged">
                    <SelectorBarItem
                        x:Name="ChecklistsItem"
                        AutomationProperties.AutomationId="Checklists_SectionChecklistsItem"
                        Tag="Checklists"
                        Text="{x:Bind ViewModel.ChecklistsTabText, Mode=OneWay}" />
                    <SelectorBarItem
                        x:Name="ReviewsItem"
                        AutomationProperties.AutomationId="Checklists_SectionReviewsItem"
                        Tag="Reviews"
                        Text="{x:Bind ViewModel.ReviewsTabText, Mode=OneWay}" />
                </SelectorBar>
                <StackPanel
                    Grid.Column="1"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Name="AddToTaskButton"
                        x:Uid="Checklists_AddToTaskButton"
                        AutomationProperties.AutomationId="Checklists_AddToTaskButton"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsChecklistsSection), Mode=OneWay}">
                        <Button.Flyout>
                            <Flyout x:Name="AddToTaskFlyout" Opening="OnAddToTaskOpening">
                                <AutoSuggestBox
                                    x:Name="TaskPickerBox"
                                    x:Uid="Checklists_TaskPickerBox"
                                    Width="320"
                                    AutomationProperties.AutomationId="Checklists_TaskPickerBox"
                                    QueryIcon="Find"
                                    QuerySubmitted="OnTaskPicked"
                                    TextChanged="OnTaskPickerTextChanged"
                                    UpdateTextOnSelect="False" />
                            </Flyout>
                        </Button.Flyout>
                    </Button>
                    <Button
                        x:Uid="Checklists_NewTodoButton"
                        AutomationProperties.AutomationId="Checklists_NewTodoButton"
                        Command="{x:Bind ViewModel.NewTodoCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsChecklistsSection), Mode=OneWay}">
                        <Button.KeyboardAccelerators>
                            <KeyboardAccelerator Key="N" Modifiers="Control" />
                        </Button.KeyboardAccelerators>
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock x:Uid="Checklists_NewTodoText" />
                        </StackPanel>
                    </Button>
                    <Button
                        x:Uid="Checklists_NewReviewButton"
                        AutomationProperties.AutomationId="Checklists_NewReviewButton"
                        Command="{x:Bind ViewModel.NewReviewCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReviewsSection), Mode=OneWay}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <FontIcon FontSize="14" Glyph="&#xE710;" />
                            <TextBlock x:Uid="Checklists_NewReviewText" />
                        </StackPanel>
                    </Button>
                </StackPanel>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="Checklists_SearchBox"
                    Grid.Row="1"
                    MinWidth="200"
                    MaxWidth="320"
                    HorizontalAlignment="Left"
                    AutomationProperties.AutomationId="Checklists_SearchBox"
                    AutomationProperties.LandmarkType="Search"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            </Grid>
        </StackPanel>

        <!-- Filtered-empty (design §4.5): "No items match 'abc'" + Clear search. -->
        <InfoBar
            x:Name="NoMatchesBar"
            Grid.Row="1"
            Margin="32,0,32,8"
            AutomationProperties.AutomationId="Checklists_NoMatchesInfoBar"
            IsClosable="False"
            IsOpen="{x:Bind ViewModel.HasNoMatches, Mode=OneWay}"
            Message="{x:Bind ViewModel.NoMatchesText, Mode=OneWay}"
            Severity="Informational">
            <InfoBar.ActionButton>
                <Button
                    x:Uid="Checklists_ClearSearchButton"
                    AutomationProperties.AutomationId="Checklists_ClearSearchButton"
                    Command="{x:Bind ViewModel.ClearSearchCommand}" />
            </InfoBar.ActionButton>
        </InfoBar>

        <controls:StateView
            x:Uid="Checklists_StateView"
            Grid.Row="2"
            EmptyGlyph="&#xE9D5;"
            PageKey="Checklists"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <Grid>
                <!-- The outer ScrollViewer gives the repeaters their viewport, so both levels virtualize (design §4.5). -->
                <ScrollViewer
                    x:Name="GroupsScroller"
                    AutomationProperties.AutomationId="Checklists_Groups"
                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsChecklistsSection), Mode=OneWay}">
                    <ItemsRepeater
                        x:Name="GroupsRepeater"
                        Margin="32,0,32,24"
                        ItemTemplate="{StaticResource CardTemplateSelector}"
                        ItemsSource="{x:Bind ViewModel.Cards, Mode=OneTime}">
                        <ItemsRepeater.Layout>
                            <controls:ColumnPackingLayout
                                x:Name="GroupsLayout"
                                ColumnSpacing="12"
                                MaxColumns="3"
                                MinColumnWidth="380"
                                RowSpacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </ScrollViewer>

                <!-- Reviews section (B-17.2, design §4.5): one list card, then Completed (n) collapsed. -->
                <ScrollViewer
                    x:Name="ReviewsScroller"
                    AutomationProperties.AutomationId="Checklists_Reviews"
                    Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReviewsSection), Mode=OneWay}">
                    <StackPanel
                        x:Name="ReviewsPanel"
                        MaxWidth="880"
                        Margin="32,0,32,24"
                        HorizontalAlignment="Left"
                        Spacing="12">
                        <!-- Reviews empty state (design §4.5): "No reviews yet" + New review. -->
                        <StackPanel
                            Padding="0,24"
                            AutomationProperties.AutomationId="Checklists_ReviewsEmpty"
                            Spacing="8"
                            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasNoReviews), Mode=OneWay}">
                            <TextBlock x:Uid="Checklists_ReviewsEmptyTitle" Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock x:Uid="Checklists_ReviewsEmptyMessage" Style="{StaticResource BodyTextBlockStyle}" TextWrapping="Wrap" />
                            <Button
                                x:Uid="Checklists_ReviewsEmptyButton"
                                AutomationProperties.AutomationId="Checklists_ReviewsEmptyButton"
                                Command="{x:Bind ViewModel.NewReviewCommand}" />
                        </StackPanel>
                        <Border
                            Padding="12,4"
                            Style="{StaticResource CardBorderStyle}"
                            Visibility="{x:Bind common:BindFunctions.Visible(Reviews.HasOpen), Mode=OneWay}">
                            <ListView
                                x:Uid="Checklists_ReviewsList"
                                AutomationProperties.AutomationId="Checklists_ReviewsList"
                                IsItemClickEnabled="True"
                                ItemClick="OnReviewItemClick"
                                ItemTemplate="{StaticResource ReviewTemplate}"
                                ItemsSource="{x:Bind Reviews.Open, Mode=OneTime}"
                                KeyDown="OnReviewListKeyDown"
                                SelectionMode="None" />
                        </Border>
                        <TextBlock
                            AutomationProperties.LiveSetting="Assertive"
                            Foreground="{ThemeResource ErrorTextBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Reviews.ActionError, Mode=OneWay}"
                            TextWrapping="Wrap"
                            Visibility="{x:Bind common:BindFunctions.Visible(Reviews.HasActionError), Mode=OneWay}" />
                        <Expander
                            HorizontalAlignment="Stretch"
                            HorizontalContentAlignment="Stretch"
                            AutomationProperties.AutomationId="Checklists_ReviewsCompletedExpander"
                            Header="{x:Bind Reviews.CompletedHeader, Mode=OneWay}"
                            IsExpanded="False"
                            Visibility="{x:Bind common:BindFunctions.Visible(Reviews.HasCompleted), Mode=OneWay}">
                            <ListView
                                x:Uid="Checklists_ReviewsCompletedList"
                                AutomationProperties.AutomationId="Checklists_ReviewsCompletedList"
                                IsItemClickEnabled="True"
                                ItemClick="OnReviewItemClick"
                                ItemTemplate="{StaticResource ReviewTemplate}"
                                ItemsSource="{x:Bind Reviews.Completed, Mode=OneTime}"
                                KeyDown="OnReviewListKeyDown"
                                SelectionMode="None" />
                        </Expander>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </controls:StateView>
    </Grid>
</UserControl>
