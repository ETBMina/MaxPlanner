<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Grid.GridPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:local="using:MaxPlanner.Presentation.Grid"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- One source of truth for the column widths of the header row and every data row. -->
        <GridLength x:Key="KindWidth">132</GridLength>
        <GridLength x:Key="CrNumberWidth">112</GridLength>
        <GridLength x:Key="TitleWidth">280</GridLength>
        <GridLength x:Key="SubtitleWidth">220</GridLength>
        <GridLength x:Key="ServiceWidth">180</GridLength>
        <GridLength x:Key="StatusWidth">170</GridLength>
        <GridLength x:Key="PriorityWidth">110</GridLength>
        <GridLength x:Key="StartDateWidth">112</GridLength>
        <GridLength x:Key="EndDateWidth">112</GridLength>

        <Style x:Key="CellTextStyle" BasedOn="{StaticResource BodyTextBlockStyle}" TargetType="TextBlock">
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HeaderCellStyle" TargetType="local:GridHeaderCell">
            <Setter Property="Padding" Value="8,0" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Height" Value="40" />
        </Style>

        <DataTemplate x:Key="StatusOptionTemplate" x:DataType="local:StatusOption">
            <TextBlock Text="{x:Bind Name, Mode=OneTime}" />
        </DataTemplate>

        <!--
            One row of the custom grid (ADR 0004). Editors are created only while their cell edits (x:Load), so
            realized rows stay light and virtualization keeps its memory profile from the Phase 0 gate.
        -->
        <DataTemplate x:Key="RowTemplate" x:DataType="local:GridRowViewModel">
            <Grid Height="44">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="{StaticResource KindWidth}" />
                    <ColumnDefinition Width="{StaticResource CrNumberWidth}" />
                    <ColumnDefinition Width="{StaticResource TitleWidth}" />
                    <ColumnDefinition Width="{StaticResource SubtitleWidth}" />
                    <ColumnDefinition Width="{StaticResource ServiceWidth}" />
                    <ColumnDefinition Width="{StaticResource StatusWidth}" />
                    <ColumnDefinition Width="{StaticResource PriorityWidth}" />
                    <ColumnDefinition Width="{StaticResource StartDateWidth}" />
                    <ColumnDefinition Width="{StaticResource EndDateWidth}" />
                </Grid.ColumnDefinitions>

                <local:GridCell Column="Kind">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Glyph="{x:Bind KindGlyph, Mode=OneWay}" />
                        <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind KindText, Mode=OneWay}" />
                    </StackPanel>
                </local:GridCell>

                <local:GridCell Grid.Column="1" Column="CrNumber">
                    <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind CrNumberText, Mode=OneWay}" />
                </local:GridCell>

                <local:GridCell Grid.Column="2" Column="Title">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel
                            Orientation="Horizontal"
                            Spacing="6"
                            Visibility="{x:Bind common:BindFunctions.Collapsed(IsEditingTitle), Mode=OneWay}">
                            <!-- B-02.3: the lock glyph and its tooltip say the title comes from the CR (or the parent task). -->
                            <FontIcon
                                AutomationProperties.Name="{x:Bind TitleLockText, Mode=OneWay}"
                                FontSize="12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Glyph="&#xE72E;"
                                ToolTipService.ToolTip="{x:Bind TitleLockText, Mode=OneWay}"
                                Visibility="{x:Bind common:BindFunctions.Visible(IsTitleLocked), Mode=OneWay}" />
                            <TextBlock
                                Style="{StaticResource CellTextStyle}"
                                Text="{x:Bind TitleText, Mode=OneWay}"
                                ToolTipService.ToolTip="{x:Bind TitleText, Mode=OneWay}" />
                        </StackPanel>
                        <TextBox
                            x:Name="TitleEditor"
                            x:Load="{x:Bind IsEditingTitle, Mode=OneWay}"
                            x:Uid="Grid_TitleEditor"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Grid_CellEditor"
                            IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                            LostFocus="OnEditorLostFocus"
                            MaxLength="250"
                            Text="{x:Bind DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="12"
                            Height="12"
                            IsActive="{x:Bind common:BindFunctions.All(IsSaving, IsEditingTitle), Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.VisibleAll(IsSaving, IsEditingTitle), Mode=OneWay}" />
                    </Grid>
                </local:GridCell>

                <local:GridCell Grid.Column="3" Column="Subtitle">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource CellTextStyle}"
                            Text="{x:Bind SubtitleText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind SubtitleText, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Collapsed(IsEditingSubtitle), Mode=OneWay}" />
                        <TextBox
                            x:Name="SubtitleEditor"
                            x:Load="{x:Bind IsEditingSubtitle, Mode=OneWay}"
                            x:Uid="Grid_SubtitleEditor"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Grid_CellEditor"
                            IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                            LostFocus="OnEditorLostFocus"
                            MaxLength="250"
                            Text="{x:Bind DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="12"
                            Height="12"
                            IsActive="{x:Bind common:BindFunctions.All(IsSaving, IsEditingSubtitle), Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.VisibleAll(IsSaving, IsEditingSubtitle), Mode=OneWay}" />
                    </Grid>
                </local:GridCell>

                <local:GridCell Grid.Column="4" Column="Service">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource CellTextStyle}"
                            Text="{x:Bind ServiceText, Mode=OneWay}"
                            ToolTipService.ToolTip="{x:Bind ServiceText, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Collapsed(IsEditingService), Mode=OneWay}" />
                        <TextBox
                            x:Name="ServiceEditor"
                            x:Load="{x:Bind IsEditingService, Mode=OneWay}"
                            x:Uid="Grid_ServiceEditor"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Grid_CellEditor"
                            IsReadOnly="{x:Bind IsSaving, Mode=OneWay}"
                            LostFocus="OnEditorLostFocus"
                            MaxLength="250"
                            Text="{x:Bind DraftText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="12"
                            Height="12"
                            IsActive="{x:Bind common:BindFunctions.All(IsSaving, IsEditingService), Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.VisibleAll(IsSaving, IsEditingService), Mode=OneWay}" />
                    </Grid>
                </local:GridCell>

                <local:GridCell Grid.Column="5" Column="Status">
                    <Grid ColumnSpacing="4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            Style="{StaticResource CellTextStyle}"
                            Text="{x:Bind StatusText, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Collapsed(IsEditingStatus), Mode=OneWay}" />
                        <!-- Items and selection are set in code-behind so a two-way SelectedItem never runs before ItemsSource. -->
                        <ComboBox
                            x:Name="StatusEditor"
                            x:Load="{x:Bind IsEditingStatus, Mode=OneWay}"
                            x:Uid="Grid_StatusEditor"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Grid_CellEditor"
                            IsEnabled="{x:Bind common:BindFunctions.Not(IsSaving), Mode=OneWay}"
                            ItemTemplate="{StaticResource StatusOptionTemplate}"
                            Loaded="OnStatusEditorLoaded"
                            LostFocus="OnEditorLostFocus"
                            SelectionChanged="OnStatusEditorSelectionChanged" />
                        <ProgressRing
                            Grid.Column="1"
                            Width="12"
                            Height="12"
                            IsActive="{x:Bind common:BindFunctions.All(IsSaving, IsEditingStatus), Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.VisibleAll(IsSaving, IsEditingStatus), Mode=OneWay}" />
                    </Grid>
                </local:GridCell>

                <local:GridCell Grid.Column="6" Column="Priority">
                    <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind PriorityText, Mode=OneWay}" />
                </local:GridCell>

                <local:GridCell Grid.Column="7" Column="StartDate">
                    <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind StartDateText, Mode=OneWay}" />
                </local:GridCell>

                <local:GridCell Grid.Column="8" Column="EndDate">
                    <TextBlock Style="{StaticResource CellTextStyle}" Text="{x:Bind EndDateText, Mode=OneWay}" />
                </local:GridCell>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3). Search, Filters, and the CommandBar arrive with Phases 9 and 11. -->
        <Grid
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="2">
                <TextBlock
                    x:Name="PageTitle"
                    x:Uid="Grid_PageTitle"
                    AutomationProperties.AutomationId="Grid_PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Uid="Grid_PageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>
            <Button
                Grid.Column="1"
                VerticalAlignment="Center"
                x:Uid="Grid_NewTaskButton"
                AutomationProperties.AutomationId="Grid_NewTaskButton"
                Command="{x:Bind ViewModel.NewTaskCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock x:Uid="Grid_NewTaskButtonText" />
                </StackPanel>
            </Button>
        </Grid>

        <controls:StateView
            x:Uid="Grid_StateView"
            Grid.Row="1"
            EmptyActionCommand="{x:Bind ViewModel.NewTaskCommand}"
            EmptyGlyph="&#xF0E2;"
            PageKey="Grid"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <!--
                Horizontal scrolling moves the header and the rows together, so they never desynchronize (the
                TableView gate failure in ADR 0004). Vertical scrolling is disabled here, which gives the row
                list a bounded height so its virtualization stays active (T-08).
            -->
            <ScrollViewer
                x:Name="HorizontalScroller"
                HorizontalScrollBarVisibility="Auto"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled">
                <Grid x:Name="TableRoot">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid
                        x:Name="HeaderRow"
                        Padding="32,0,0,0"
                        BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                        BorderThickness="0,0,0,1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="{StaticResource KindWidth}" />
                            <ColumnDefinition Width="{StaticResource CrNumberWidth}" />
                            <ColumnDefinition Width="{StaticResource TitleWidth}" />
                            <ColumnDefinition Width="{StaticResource SubtitleWidth}" />
                            <ColumnDefinition Width="{StaticResource ServiceWidth}" />
                            <ColumnDefinition Width="{StaticResource StatusWidth}" />
                            <ColumnDefinition Width="{StaticResource PriorityWidth}" />
                            <ColumnDefinition Width="{StaticResource StartDateWidth}" />
                            <ColumnDefinition Width="{StaticResource EndDateWidth}" />
                        </Grid.ColumnDefinitions>
                        <local:GridHeaderCell x:Uid="Grid_Header_Kind" Column="Kind" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_CrNumber" Grid.Column="1" Column="CrNumber" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_Title" Grid.Column="2" Column="Title" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_Subtitle" Grid.Column="3" Column="Subtitle" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_Service" Grid.Column="4" Column="Service" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_Status" Grid.Column="5" Column="Status" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_Priority" Grid.Column="6" Column="Priority" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_StartDate" Grid.Column="7" Column="StartDate" Style="{StaticResource HeaderCellStyle}" />
                        <local:GridHeaderCell x:Uid="Grid_Header_EndDate" Grid.Column="8" Column="EndDate" Style="{StaticResource HeaderCellStyle}" />
                    </Grid>

                    <local:GridTable
                        x:Name="Table"
                        x:Uid="Grid_Table"
                        Grid.Row="1"
                        Padding="32,0,0,0"
                        AutomationProperties.AutomationId="Grid_Table"
                        IsItemClickEnabled="False"
                        ItemTemplate="{StaticResource RowTemplate}"
                        ItemsSource="{x:Bind ViewModel.Rows, Mode=OneTime}"
                        SelectionMode="None">
                        <local:GridTable.ItemContainerStyle>
                            <Style TargetType="local:GridRowContainer">
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="MinHeight" Value="44" />
                                <Setter Property="IsTabStop" Value="False" />
                            </Style>
                        </local:GridTable.ItemContainerStyle>
                    </local:GridTable>
                </Grid>
            </ScrollViewer>
        </controls:StateView>

        <!-- The cell error and single-cell conflict popup (design §4.3, §5.10), anchored under the editing cell. -->
        <Popup
            x:Name="CellPopup"
            DesiredPlacement="Bottom"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="True">
            <Border
                MaxWidth="360"
                Padding="12"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{ThemeResource ErrorTextBrush}"
                            Glyph="&#xE783;" />
                        <TextBlock
                            MaxWidth="300"
                            AutomationProperties.AutomationId="Grid_CellError"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind PopupRow.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind common:BindFunctions.Visible(PopupHasConflict), Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.AutomationId="Grid_ConflictSavedText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PopupSavedNowText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.AutomationId="Grid_ConflictDraftText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PopupDraftText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="Conflict_UseMineButton"
                                AutomationProperties.AutomationId="Conflict_UseMineButton"
                                Click="OnUseMineClick"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Uid="Conflict_ReloadButton"
                                AutomationProperties.AutomationId="Conflict_ReloadButton"
                                Click="OnReloadClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
