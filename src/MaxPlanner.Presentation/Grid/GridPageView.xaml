<?xml version="1.0" encoding="utf-8"?>
<!--
    Grid (design §4.3, B-07): the custom virtualized ListView grid of ADR 0004. Columns are configurable (order,
    width, visibility, active custom fields), so header and row cells are created in code from the page's column
    list; this file holds the page frame, the command bar, and the single-cell error popup.
-->
<UserControl
    x:Class="MaxPlanner.Presentation.Grid.GridPageView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:controls="using:MaxPlanner.Presentation.Common.Controls"
    xmlns:filters="using:MaxPlanner.Presentation.Common.Filters"
    xmlns:local="using:MaxPlanner.Presentation.Grid"
    IsTabStop="False">
    <UserControl.Resources>
        <!-- One row: the cells are created by the presenter for the displayed columns (no x:Bind in the template). -->
        <DataTemplate x:Key="RowTemplate">
            <local:GridRowPresenter />
        </DataTemplate>
    </UserControl.Resources>

    <Grid x:Name="PageRoot">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page header (design §2.3): title and commands, search and Filters (shared with the Board, B-10), filter context. -->
        <Grid
            x:Name="HeaderRoot"
            Padding="32,24,32,12"
            ColumnSpacing="12"
            RowSpacing="8">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <StackPanel VerticalAlignment="Center" Spacing="2">
                <TextBlock
                    x:Name="PageTitle"
                    x:Uid="Grid_PageTitle"
                    AutomationProperties.AutomationId="Grid_PageTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    Style="{StaticResource PageTitleTextStyle}" />
                <TextBlock x:Uid="Grid_PageSubtitle" Style="{StaticResource PageSubtitleTextStyle}" />
            </StackPanel>

            <!-- Design §2.4/§4.3: Show archived, Columns, Export…, and Reset column layout in overflow. -->
            <CommandBar
                x:Name="Commands"
                Grid.Column="1"
                VerticalAlignment="Center"
                Background="Transparent"
                DefaultLabelPosition="Right"
                IsDynamicOverflowEnabled="True"
                OverflowButtonVisibility="Auto">
                <AppBarToggleButton
                    x:Uid="Grid_ShowArchivedToggle"
                    AutomationProperties.AutomationId="Grid_ShowArchivedToggle"
                    DynamicOverflowOrder="2"
                    IsChecked="{x:Bind ViewModel.ShowArchived, Mode=TwoWay}">
                    <AppBarToggleButton.Icon>
                        <FontIcon Glyph="&#xE7B8;" />
                    </AppBarToggleButton.Icon>
                </AppBarToggleButton>
                <AppBarButton
                    x:Uid="Grid_ColumnsButton"
                    AutomationProperties.AutomationId="Grid_ColumnsButton"
                    DynamicOverflowOrder="3">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE80A;" />
                    </AppBarButton.Icon>
                    <AppBarButton.Flyout>
                        <Flyout x:Name="ColumnsFlyout" Opening="OnColumnsFlyoutOpening" ShouldConstrainToRootBounds="True" />
                    </AppBarButton.Flyout>
                </AppBarButton>
                <!-- B-12: exports the rows shown now through Settings › Data › Export ("Current view results"). -->
                <AppBarButton
                    x:Uid="Grid_ExportButton"
                    AutomationProperties.AutomationId="Grid_ExportButton"
                    Command="{x:Bind ViewModel.ExportViewCommand}"
                    DynamicOverflowOrder="1">
                    <AppBarButton.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </AppBarButton.Icon>
                </AppBarButton>
                <CommandBar.SecondaryCommands>
                    <AppBarButton
                        x:Uid="Grid_ResetLayoutButton"
                        AutomationProperties.AutomationId="Grid_ResetLayoutButton"
                        Command="{x:Bind ViewModel.ResetLayoutCommand}">
                        <AppBarButton.Icon>
                            <FontIcon Glyph="&#xE72C;" />
                        </AppBarButton.Icon>
                    </AppBarButton>
                </CommandBar.SecondaryCommands>
            </CommandBar>

            <Button
                Grid.Column="2"
                VerticalAlignment="Center"
                x:Uid="Grid_NewTaskButton"
                AutomationProperties.AutomationId="Grid_NewTaskButton"
                Command="{x:Bind ViewModel.NewTaskCommand}"
                Style="{StaticResource AccentButtonStyle}">
                <Button.KeyboardAccelerators>
                    <KeyboardAccelerator Key="N" Modifiers="Control" />
                </Button.KeyboardAccelerators>
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="16" Glyph="&#xE710;" />
                    <TextBlock x:Name="NewTaskText" x:Uid="Grid_NewTaskButtonText" />
                </StackPanel>
            </Button>

            <StackPanel
                x:Name="SearchBoxHost"
                Grid.Row="1"
                Grid.ColumnSpan="3"
                Orientation="Horizontal"
                Spacing="8">
                <AutoSuggestBox
                    x:Name="SearchBox"
                    x:Uid="Grid_SearchBox"
                    Width="280"
                    AutomationProperties.AutomationId="Grid_SearchBox"
                    AutomationProperties.LandmarkType="Search"
                    QueryIcon="Find"
                    Text="{x:Bind ViewModel.SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                <!-- Design §2.3 S: the search box moves to the full-width row below; this button opens it. -->
                <ToggleButton
                    x:Name="SearchToggle"
                    x:Uid="Grid_SearchToggle"
                    AutomationProperties.AutomationId="Grid_SearchToggle">
                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                </ToggleButton>
                <filters:FilterButton PageKey="Grid" Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
            </StackPanel>
            <Grid
                x:Name="CompactSearchRow"
                Grid.Row="2"
                Grid.ColumnSpan="3" />
            <filters:FilterChipsBar
                x:Name="ChipsBar"
                Grid.Row="3"
                Grid.ColumnSpan="3"
                PageKey="Grid"
                Scope="{x:Bind ViewModel.Filters, Mode=OneTime}" />
        </Grid>

        <controls:StateView
            x:Name="PageContent"
            x:Uid="Grid_StateView"
            Grid.Row="1"
            EmptyActionCommand="{x:Bind ViewModel.NewTaskCommand}"
            EmptyGlyph="&#xE80A;"
            FilteredActionCommand="{x:Bind ViewModel.ResolveFilteredEmptyCommand}"
            FilteredActionText="{x:Bind ViewModel.FilteredActionText, Mode=OneWay}"
            FilteredMessage="{x:Bind ViewModel.FilteredMessage, Mode=OneWay}"
            FilteredTitle="{x:Bind ViewModel.FilteredTitle, Mode=OneWay}"
            PageKey="Grid"
            State="{x:Bind ViewModel.State, Mode=OneWay}">
            <Grid>
                <!--
                    Horizontal scrolling moves the header and the rows together, so they never desynchronize (the
                    TableView gate failure in ADR 0004). Vertical scrolling is disabled here, which gives the row
                    list a bounded height so its virtualization stays active (T-08).
                -->
                <ScrollViewer
                    x:Name="HorizontalScroller"
                    common:WheelScrolling.RoutesMouseWheel="True"
                    common:WheelScrolling.VerticalWheelTarget="{x:Bind Table, Mode=OneTime}"
                    HorizontalScrollBarVisibility="Auto"
                    HorizontalScrollMode="Auto"
                    VerticalScrollBarVisibility="Disabled"
                    VerticalScrollMode="Disabled"
                    ViewChanged="OnHorizontalViewChanged">
                    <Grid x:Name="TableRoot">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Border
                            x:Name="HeaderBorder"
                            Padding="32,0,0,0"
                            BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                            BorderThickness="0,0,0,1">
                            <local:GridHeaderPanel x:Name="HeaderRow" />
                        </Border>

                        <local:GridTable
                            x:Name="Table"
                            x:Uid="Grid_Table"
                            Grid.Row="1"
                            Padding="32,0,0,0"
                            common:WheelScrolling.RoutesMouseWheel="True"
                            AutomationProperties.AutomationId="Grid_Table"
                            ContextRequested="OnRowContextRequested"
                            IsItemClickEnabled="False"
                            ItemTemplate="{StaticResource RowTemplate}"
                            ItemsSource="{x:Bind ViewModel.Rows, Mode=OneTime}"
                            Loaded="OnTableLoaded"
                            ScrollViewer.VerticalScrollBarVisibility="Hidden"
                            SelectionMode="None">
                            <local:GridTable.ItemContainerStyle>
                                <Style TargetType="local:GridRowContainer">
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="MinHeight" Value="44" />
                                    <Setter Property="IsTabStop" Value="False" />
                                </Style>
                            </local:GridTable.ItemContainerStyle>
                        </local:GridTable>
                    </Grid>
                </ScrollViewer>

                <!--
                    The row list's own vertical bar sits at the far right of the full table width, off screen until the
                    table is scrolled right, so it is hidden (rows still scroll by wheel, keyboard and touch) and this
                    bar, pinned to the viewport's right edge below the header, mirrors and drives the list's scroller.
                -->
                <ScrollBar
                    x:Name="RowScrollBar"
                    HorizontalAlignment="Right"
                    AutomationProperties.AutomationId="Grid_RowScrollBar"
                    IndicatorMode="MouseIndicator"
                    IsTabStop="False"
                    Orientation="Vertical"
                    Scroll="OnRowScrollBarScroll"
                    Visibility="Collapsed" />
            </Grid>
        </controls:StateView>

        <!-- The cell error and single-cell conflict popup (design §4.3, §5.10), anchored under the editing cell. -->
        <Popup
            x:Name="CellPopup"
            DesiredPlacement="Bottom"
            IsLightDismissEnabled="False"
            ShouldConstrainToRootBounds="True">
            <Border
                MaxWidth="360"
                Padding="12"
                Background="{ThemeResource SolidBackgroundFillColorTertiaryBrush}"
                BorderBrush="{ThemeResource SurfaceStrokeColorFlyoutBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            VerticalAlignment="Top"
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="16"
                            Foreground="{ThemeResource ErrorTextBrush}"
                            Glyph="&#xE783;" />
                        <TextBlock
                            MaxWidth="300"
                            AutomationProperties.AutomationId="Grid_CellError"
                            Style="{StaticResource BodyTextBlockStyle}"
                            Text="{x:Bind PopupRow.ErrorMessage, Mode=OneWay}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                    <StackPanel Spacing="8" Visibility="{x:Bind common:BindFunctions.Visible(PopupHasConflict), Mode=OneWay}">
                        <TextBlock
                            AutomationProperties.AutomationId="Grid_ConflictSavedText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PopupSavedNowText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            AutomationProperties.AutomationId="Grid_ConflictDraftText"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind PopupDraftText, Mode=OneWay}"
                            TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button
                                x:Uid="Conflict_UseMineButton"
                                AutomationProperties.AutomationId="Conflict_UseMineButton"
                                Click="OnUseMineClick"
                                Style="{StaticResource AccentButtonStyle}" />
                            <Button
                                x:Uid="Conflict_ReloadButton"
                                AutomationProperties.AutomationId="Conflict_ReloadButton"
                                Click="OnReloadClick" />
                        </StackPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Popup>
    </Grid>
</UserControl>
