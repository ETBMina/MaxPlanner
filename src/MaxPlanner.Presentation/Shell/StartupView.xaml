<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Shell.StartupView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common">
    <!-- Design §2.1 "Startup splash": icon, name and version; no progress indicator and no status text. The entrance
         transition fades the content in and, like every theme transition, is skipped when the system turns
         animations off. -->
    <StackPanel
        Margin="16"
        HorizontalAlignment="Center"
        VerticalAlignment="Center"
        Spacing="8">
        <StackPanel.Transitions>
            <TransitionCollection>
                <EntranceThemeTransition FromHorizontalOffset="0" FromVerticalOffset="0" />
            </TransitionCollection>
        </StackPanel.Transitions>
        <Image
            Width="72"
            Height="72"
            Margin="0,0,0,8"
            AutomationProperties.AccessibilityView="Raw">
            <!-- The app supplies the icon (IconUri): the image is a Desktop asset beside AppIcon.ico. -->
            <Image.Source>
                <BitmapImage
                    x:Name="IconImage"
                    DecodePixelType="Logical"
                    DecodePixelWidth="72" />
            </Image.Source>
        </Image>
        <TextBlock
            x:Uid="Shell_StartupTitle"
            AutomationProperties.AutomationId="Shell_StartupTitle"
            AutomationProperties.HeadingLevel="Level1"
            HorizontalAlignment="Center"
            Style="{StaticResource SubtitleTextBlockStyle}" />
        <TextBlock
            AutomationProperties.AutomationId="Shell_StartupVersion"
            HorizontalAlignment="Center"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Style="{StaticResource CaptionTextBlockStyle}"
            Text="{x:Bind ViewModel.VersionText, Mode=OneTime}"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasVersionText), Mode=OneTime}" />
    </StackPanel>
</UserControl>
