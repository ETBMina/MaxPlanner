<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Shell.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:local="using:MaxPlanner.Presentation.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App InfoBar region (design §2.7): under the title bar, full width, errors and warnings first. -->
        <StackPanel AutomationProperties.AutomationId="Shell_AppInfoBar">
            <InfoBar
                x:Uid="Shell_ResyncInfoBar"
                AutomationProperties.AutomationId="Shell_ResyncInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsResyncing, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                x:Uid="Shell_BackupFailedInfoBar"
                AutomationProperties.AutomationId="Shell_BackupFailedInfoBar"
                IsOpen="{x:Bind ViewModel.IsBackupWarningOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.BackupWarningMessage, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                x:Uid="Shell_PreferencesInfoBar"
                AutomationProperties.AutomationId="Shell_PreferencesInfoBar"
                IsOpen="{x:Bind ViewModel.IsPreferencesNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.PreferencesNoticeMessage, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>

        <local:StartupView
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel, Mode=OneTime}"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsStarting), Mode=OneWay}" />

        <local:RecoveryView
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel.Recovery, Mode=OneWay}"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsInRecovery), Mode=OneWay}" />

        <!-- StateView "Error" (design §2.5) for a projection load that failed after the dataset opened. -->
        <ScrollViewer
            Grid.Row="1"
            AutomationProperties.AutomationId="Shell_StateView"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasFailed), Mode=OneWay}">
            <StackPanel
                MaxWidth="560"
                Margin="16,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="48"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE783;" />
                <TextBlock
                    x:Uid="Shell_FailedTitle"
                    AutomationProperties.AutomationId="Shell_FailedTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AutomationId="Shell_FailureMessage"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="Shell_RetryButton"
                        AutomationProperties.AutomationId="Shell_RetryButton"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.CanRetry), Mode=OneWay}" />
                    <Button
                        x:Uid="Shell_OpenDataFolderButton"
                        AutomationProperties.AutomationId="Shell_OpenDataFolderButton"
                        Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!-- Pre-Phase-2 ready state: a summary of the loaded dataset until the NavigationView pages exist. -->
        <ScrollViewer
            Grid.Row="1"
            AutomationProperties.AutomationId="Shell_ReadySummary"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReady), Mode=OneWay}">
            <Border
                MaxWidth="560"
                Margin="16,24"
                Padding="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                CornerRadius="{ThemeResource OverlayCornerRadius}">
                <StackPanel Spacing="16">
                    <TextBlock
                        x:Uid="Shell_ReadyTitle"
                        AutomationProperties.AutomationId="Shell_ReadyTitle"
                        AutomationProperties.HeadingLevel="Level1"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Uid="Shell_ReadyDescription"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Style="{StaticResource BodyTextBlockStyle}"
                        TextWrapping="Wrap" />
                    <Grid ColumnSpacing="24" RowSpacing="8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock x:Uid="Shell_TaskCountLabel" Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock
                            Grid.Column="1"
                            AutomationProperties.AutomationId="Shell_TaskCountText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.TaskCountText, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Shell_ChangeRequestCountLabel"
                            Grid.Row="1"
                            Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock
                            Grid.Row="1"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="Shell_ChangeRequestCountText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.ChangeRequestCountText, Mode=OneWay}" />
                        <TextBlock
                            x:Uid="Shell_ReviewCountLabel"
                            Grid.Row="2"
                            Style="{StaticResource BodyTextBlockStyle}" />
                        <TextBlock
                            Grid.Row="2"
                            Grid.Column="1"
                            AutomationProperties.AutomationId="Shell_ReviewCountText"
                            Style="{StaticResource BodyStrongTextBlockStyle}"
                            Text="{x:Bind ViewModel.ReviewCountText, Mode=OneWay}" />
                    </Grid>
                    <StackPanel Spacing="4">
                        <TextBlock x:Uid="Shell_DataFolderLabel" Style="{StaticResource CaptionTextBlockStyle}" />
                        <TextBlock
                            AutomationProperties.AutomationId="Shell_DataFolderText"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            IsTextSelectionEnabled="True"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind ViewModel.DataFolderPath, Mode=OneTime}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </ScrollViewer>
    </Grid>
</UserControl>
