<?xml version="1.0" encoding="utf-8"?>
<UserControl
    x:Class="MaxPlanner.Presentation.Shell.ShellView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:common="using:MaxPlanner.Presentation.Common"
    xmlns:local="using:MaxPlanner.Presentation.Shell">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- App InfoBar region (design §2.7): under the title bar, full width, errors and warnings first. -->
        <StackPanel AutomationProperties.AutomationId="Shell_AppInfoBar">
            <InfoBar
                x:Uid="Shell_ResyncInfoBar"
                AutomationProperties.AutomationId="Shell_ResyncInfoBar"
                IsClosable="False"
                IsOpen="{x:Bind ViewModel.IsResyncing, Mode=OneWay}"
                Severity="Warning" />
            <InfoBar
                x:Uid="Shell_SaveFailedInfoBar"
                AutomationProperties.AutomationId="Shell_SaveFailedInfoBar"
                IsOpen="{x:Bind SaveStatus.IsFailureNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind local:ShellView.FailureText(SaveStatus.FailureMessage, SaveStatus.FailureDetails), Mode=OneWay}"
                Severity="Error" />
            <InfoBar
                x:Uid="Shell_BackupFailedInfoBar"
                AutomationProperties.AutomationId="Shell_BackupFailedInfoBar"
                IsOpen="{x:Bind ViewModel.IsBackupWarningOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.BackupWarningMessage, Mode=OneWay}"
                Severity="Warning" />
            <!-- T-09: the outcome of a restore; the page that started it belonged to the closed dataset. -->
            <InfoBar
                AutomationProperties.AutomationId="Shell_DataNoticeInfoBar"
                IsOpen="{x:Bind ViewModel.IsDataNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.DataNoticeMessage, Mode=OneWay}"
                Severity="{x:Bind ViewModel.DataNoticeSeverity, Mode=OneWay}" />
            <InfoBar
                x:Uid="Shell_PreferencesInfoBar"
                AutomationProperties.AutomationId="Shell_PreferencesInfoBar"
                IsOpen="{x:Bind ViewModel.IsPreferencesNoticeOpen, Mode=TwoWay}"
                Message="{x:Bind ViewModel.PreferencesNoticeMessage, Mode=OneWay}"
                Severity="Informational" />
        </StackPanel>

        <local:StartupView
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel, Mode=OneTime}"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsStarting), Mode=OneWay}" />

        <local:RecoveryView
            Grid.Row="1"
            ViewModel="{x:Bind ViewModel.Recovery, Mode=OneWay}"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsInRecovery), Mode=OneWay}" />

        <!-- StateView "Error" (design §2.5) for a projection load that failed after the dataset opened. -->
        <ScrollViewer
            Grid.Row="1"
            AutomationProperties.AutomationId="Shell_StateView"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.HasFailed), Mode=OneWay}">
            <StackPanel
                MaxWidth="560"
                Margin="16,24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Spacing="12">
                <FontIcon
                    AutomationProperties.AccessibilityView="Raw"
                    FontSize="48"
                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                    Glyph="&#xE783;" />
                <TextBlock
                    x:Uid="Shell_FailedTitle"
                    AutomationProperties.AutomationId="Shell_FailedTitle"
                    AutomationProperties.HeadingLevel="Level1"
                    HorizontalAlignment="Center"
                    Style="{StaticResource SubtitleTextBlockStyle}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <TextBlock
                    AutomationProperties.AutomationId="Shell_FailureMessage"
                    HorizontalAlignment="Center"
                    Style="{StaticResource BodyTextBlockStyle}"
                    Text="{x:Bind ViewModel.FailureMessage, Mode=OneWay}"
                    TextAlignment="Center"
                    TextWrapping="Wrap" />
                <StackPanel
                    HorizontalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="8">
                    <Button
                        x:Uid="Shell_RetryButton"
                        AutomationProperties.AutomationId="Shell_RetryButton"
                        Command="{x:Bind ViewModel.RetryCommand}"
                        Style="{StaticResource AccentButtonStyle}"
                        Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.CanRetry), Mode=OneWay}" />
                    <Button
                        x:Uid="Shell_OpenDataFolderButton"
                        AutomationProperties.AutomationId="Shell_OpenDataFolderButton"
                        Command="{x:Bind ViewModel.OpenDataFolderCommand}" />
                </StackPanel>
            </StackPanel>
        </ScrollViewer>

        <!--
            Ready: the adaptive NavigationView (design §2.2). Auto display mode gives Left (expanded) at L, LeftCompact
            at M and LeftMinimal at S; at S the title bar's pane toggle opens the overlay pane (MainWindow).
        -->
        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            AlwaysShowHeader="False"
            AutomationProperties.AutomationId="Shell_Nav"
            AutomationProperties.LandmarkType="Navigation"
            CompactModeThresholdWidth="640"
            DisplayModeChanged="OnNavDisplayModeChanged"
            ExpandedModeThresholdWidth="1008"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="True"
            PaneDisplayMode="Auto"
            SelectionChanged="OnNavSelectionChanged"
            Visibility="{x:Bind common:BindFunctions.Visible(ViewModel.IsReady), Mode=OneWay}">
            <NavigationView.MenuItems>
                <NavigationViewItem x:Uid="Shell_NavDashboardItem" AutomationProperties.AutomationId="Shell_NavDashboardItem" Tag="Dashboard">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xF246;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavBoardItem" AutomationProperties.AutomationId="Shell_NavBoardItem" Tag="Board">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xECA5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavGridItem" AutomationProperties.AutomationId="Shell_NavGridItem" Tag="Grid">
                    <NavigationViewItem.Icon>
                        <!-- Table glyph: the former GridView glyph (F0E2) was nearly identical to Board's Tiles (Phase 2 review). -->
                        <FontIcon Glyph="&#xE80A;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavCalendarItem" AutomationProperties.AutomationId="Shell_NavCalendarItem" Tag="Calendar">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE787;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem x:Uid="Shell_NavChecklistsItem" AutomationProperties.AutomationId="Shell_NavChecklistsItem" Tag="Checklists">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE9D5;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.MenuItems>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="32" />
                </Grid.RowDefinitions>

                <!-- Retained page views; the content swaps without recreating their ViewModels (AC-17). -->
                <ContentControl
                    x:Name="PageHost"
                    HorizontalContentAlignment="Stretch"
                    VerticalContentAlignment="Stretch"
                    AutomationProperties.LandmarkType="Main"
                    IsTabStop="False" />

                <!-- Status bar (design §2.8): page summary left, actual save status right. -->
                <Grid
                    x:Name="StatusBar"
                    Grid.Row="1"
                    Padding="16,0"
                    Background="{ThemeResource LayerFillColorDefaultBrush}"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,1,0,0"
                    ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="StatusSummaryText"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell_StatusSummary"
                        AutomationProperties.Name="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind ViewModel.StatusSummary, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap"
                        ToolTipService.ToolTip="{x:Bind ViewModel.StatusSummary, Mode=OneWay}" />
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        AutomationProperties.AutomationId="Shell_SaveStatus"
                        Orientation="Horizontal"
                        Spacing="6">
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Glyph="&#xE73E;"
                            Visibility="{x:Bind common:BindFunctions.Visible(SaveStatus.IsSettled), Mode=OneWay}" />
                        <ProgressRing
                            Width="16"
                            Height="16"
                            IsActive="{x:Bind SaveStatus.IsSaving, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Visible(SaveStatus.IsSaving), Mode=OneWay}" />
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Glyph="&#xE895;"
                            Visibility="{x:Bind common:BindFunctions.Visible(SaveStatus.IsResyncing), Mode=OneWay}" />
                        <FontIcon
                            AutomationProperties.AccessibilityView="Raw"
                            FontSize="14"
                            Foreground="{ThemeResource ErrorTextBrush}"
                            Glyph="&#xE783;"
                            Visibility="{x:Bind common:BindFunctions.Visible(SaveStatus.IsFailed), Mode=OneWay}" />
                        <TextBlock
                            x:Name="SaveStatusText"
                            VerticalAlignment="Center"
                            AutomationProperties.AutomationId="Shell_SaveStatusText"
                            AutomationProperties.LiveSetting="Polite"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind SaveStatus.Text, Mode=OneWay}"
                            Visibility="{x:Bind common:BindFunctions.Collapsed(SaveStatus.IsFailed), Mode=OneWay}" />
                        <!-- Design §4.5: a result can carry a follow-up, for example "Open card" after a pop out. -->
                        <HyperlinkButton
                            Padding="4,0"
                            AutomationProperties.AutomationId="Shell_SaveStatusActionLink"
                            Command="{x:Bind SaveStatus.RunResultActionCommand, Mode=OneWay}"
                            Content="{x:Bind SaveStatus.ResultActionText, Mode=OneWay}"
                            FontSize="12"
                            Visibility="{x:Bind common:BindFunctions.Visible(SaveStatus.HasResultAction), Mode=OneWay}" />
                        <!-- Failed: the link text opens the App InfoBar with the message and the operation id. -->
                        <HyperlinkButton
                            Padding="4,0"
                            AutomationProperties.AutomationId="Shell_SaveStatusDetailsButton"
                            Command="{x:Bind SaveStatus.ShowDetailsCommand, Mode=OneWay}"
                            Content="{x:Bind SaveStatus.Text, Mode=OneWay}"
                            FontSize="12"
                            Visibility="{x:Bind common:BindFunctions.Visible(SaveStatus.IsFailed), Mode=OneWay}" />
                    </StackPanel>
                </Grid>
            </Grid>
        </NavigationView>
    </Grid>
</UserControl>
