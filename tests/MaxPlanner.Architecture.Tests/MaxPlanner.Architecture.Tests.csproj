<Project Sdk="Microsoft.NET.Sdk">
  <!-- The WinUI props let this project reference the WinUI Presentation library, so its view models can be
       checked (PresentationDependencyTests). The rules read metadata only; nothing here starts XAML.
       Self-contained Windows App SDK keeps the test run independent of an installed Windows App Runtime. -->
  <Import Project="..\..\eng\WinUI.Common.props" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>
    <SelfContained>true</SelfContained>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\MaxPlanner.Domain\MaxPlanner.Domain.csproj" />
    <ProjectReference Include="..\..\src\MaxPlanner.Application\MaxPlanner.Application.csproj" />
    <ProjectReference Include="..\..\src\MaxPlanner.Infrastructure\MaxPlanner.Infrastructure.csproj" />
    <ProjectReference Include="..\..\src\MaxPlanner.Presentation\MaxPlanner.Presentation.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="xunit.v3" />
    <Using Include="Xunit" />
    <PackageReference Include="AwesomeAssertions" />
    <PackageReference Include="TngTech.ArchUnitNET" />
  </ItemGroup>
</Project>
